---
// DestinationTabs — вкладки направления: хаб и его страницы-спутники как один
// объект с общей полосой разделов. Решение Никиты 05.09.2026 по образцу
// страницы направления U.S. News Travel («Overview · Things to do · When to
// visit …»): у нас виза, сборы и месяцы давно живут отдельными страницами, но
// друг о друге не знали — читатель находил их только через поиск.
//
// Ставится под шапкой хаба и под шапкой каждой страницы-спутника; активная
// вкладка — по тому, где стоим. Ссылки обычные, краулятся, без скриптов.

import { DIRECTIONS, MONTHS } from '../data/directions.js';
import { COMPARE_PAIRS } from '../data/compare-pairs.js';

type Key = 'hub' | 'when' | 'visa' | 'packing' | 'compare';
interface Props {
  d: any;          // запись направления из DIRECTIONS
  active: Key;
}
const { d, active } = Astro.props;

// Лучший месяц — тот же расчёт, что в шапке хаба: первый месяц с оценкой
// «пик» или «хорошо» по календарю, иначе просто самый высокий.
const rank: Record<string, number> = { P: 4, G: 3, O: 2, B: 1, X: 0 };
const ranked = MONTHS.map((m, i) => ({ ...m, rank: rank[d.r?.[i]] ?? 0 }));
const best = ranked.find((m) => m.rank >= 3) ?? ranked.reduce((a, b) => (b.rank > a.rank ? b : a));

const pair = COMPARE_PAIRS.find((p) => p.a === d.slug || p.b === d.slug);
const otherSlug = pair ? (pair.a === d.slug ? pair.b : pair.a) : null;
const other = otherSlug ? DIRECTIONS.find((x) => x.slug === otherSlug) : null;

const tabs: { key: Key; label: string; href: string; title?: string }[] = [
  { key: 'hub', label: 'Обзор', href: `/${d.slug}/` },
  { key: 'when', label: 'Когда ехать', href: `/trips/${best.slug}/${d.slug}/`, title: `Лучший месяц — ${best.nom}` },
  { key: 'visa', label: 'Виза', href: `/visa/${d.slug}/` },
  { key: 'packing', label: 'Что взять', href: `/packing/${d.slug}/` },
];
if (pair && other) {
  tabs.push({ key: 'compare', label: 'Сравнить', href: `/compare/${pair.a}-vs-${pair.b}/`, title: `${d.cases.nom} или ${other.cases.nom}` });
}
---

<nav class="dt" aria-label={`Разделы направления: ${d.cases.nom}`}>
  <ul class="dt-l">
    {tabs.map((t) => (
      <li class="dt-i">
        <a
          href={t.href}
          class:list={['dt-a', { 'is-on': t.key === active }]}
          aria-current={t.key === active ? 'page' : undefined}
          title={t.title}
        >{t.label}</a>
      </li>
    ))}
  </ul>
</nav>

<style>
.dt {
  margin: clamp(1.2rem, 2.5vw, 1.8rem) 0 0;
  border-top: 1px solid var(--line);
  border-bottom: 1px solid var(--line);
}
.dt-l {
  list-style: none; margin: 0; padding: 0;
  display: flex; flex-wrap: wrap; column-gap: clamp(1rem, 2.4vw, 1.8rem);
}
.dt-i { margin: 0; }
.dt-a {
  display: inline-flex; align-items: center;
  min-height: 44px;                       /* цель для пальца */
  padding: 0 .1rem;
  font-size: .95rem; line-height: 1.2;
  color: var(--text-dim);
  text-decoration: none;
  border-bottom: 2px solid transparent;
  margin-bottom: -1px;                    /* подчёркивание ложится на нижнюю линию */
}
.dt-a:hover { color: var(--text); }
.dt-a.is-on {
  color: var(--text); font-weight: 700;
  border-bottom-color: var(--gold);
}
.dt-a:focus-visible { outline: 2px solid var(--gold); outline-offset: 2px; }
</style>
