---
/**
 * Цена перелёта прямо из ежедневной выгрузки, а не текстом в статье.
 *
 * Зачем появился (04.08.2026). В капсуле гида по Грузии стояло «от 28 500 ₽»,
 * вписанное руками 02.08. Через два дня выгрузка давала 30 769 ₽ — число
 * протухло за два дня, а читатель по нему принимает решение о поездке.
 * Захардкоженные цены в тексте протухают всегда, вопрос только в скорости.
 *
 * Дату выгрузки рядом с ценой не печатаем (правило Никиты 08–10.09.2026: читателю
 * не нужно, откуда и когда взято число), свежесть держит сама ежедневная выгрузка.
 * Дата введения сбора или правила — другое дело: это факт, он остаётся в тексте.
 *
 * ⛔ Нет данных по направлению — не рисуем ничего. Придумывать цену нельзя.
 */
import prices from '../../data/prices-cache.json';

interface Props {
  /** Код аэропорта назначения, как в выгрузке: TBS, BUS, KUT… */
  iata: string;
  /** Показывать ли самый дешёвый месяц. По умолчанию да. */
  cheapest?: boolean;
}

const { iata, cheapest = true } = Astro.props;

const MONTHS_PREP = ['январе', 'феврале', 'марте', 'апреле', 'мае', 'июне',
  'июле', 'августе', 'сентябре', 'октябре', 'ноябре', 'декабре'];

const byMonth: Record<string, number> | undefined = (prices as any).prices?.[iata];

const entries = byMonth ? Object.entries(byMonth).filter(([, v]) => typeof v === 'number' && v > 0) : [];
const nearest = entries[0];
const min = entries.length ? entries.reduce((a, b) => (b[1] < a[1] ? b : a)) : null;

const fmt = (n: number) => n.toLocaleString('ru-RU');
const monthName = (key: string, list: string[]) => list[Number(key.slice(5, 7)) - 1] ?? '';
---
{nearest && (
  <span class="live-price">
    <b>{fmt(nearest[1])}&nbsp;₽</b> в {monthName(nearest[0], MONTHS_PREP)}
    {cheapest && min && min[0] !== nearest[0] && (
      <>, дешевле всего в {monthName(min[0], MONTHS_PREP)} — <b>{fmt(min[1])}&nbsp;₽</b></>
    )}
  </span>
)}
