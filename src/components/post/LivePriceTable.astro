---
/**
 * Таблица цен перелёта по месяцам прямо из ежедневной выгрузки.
 *
 * Зачем (04.08.2026). Двенадцать чисел в таблице были вписаны руками с замером
 * от 2 августа. Через два дня выгрузка давала по августу 30 769 ₽ вместо
 * 28 556 ₽, и статья начала спорить сама с собой: капсула про одно, таблица про
 * другое. Ручные цены протухают всегда — вопрос только в скорости, а по этим
 * числам человек решает, когда лететь.
 *
 * Дата выгрузки печатается прямо под таблицей: цена без даты для поисковика не
 * факт, а слух.
 *
 * ⛔ Нет данных по направлению — не рисуем ничего, придумывать нельзя.
 */
import prices from '../../data/prices-cache.json';

interface Props {
  /** Код аэропорта назначения, как в выгрузке: TBS, BUS, KUT… */
  iata: string;
  /** Подпись столбца с ценой. */
  label?: string;
}

const { iata, label = 'Минимум в одну сторону' } = Astro.props;

const MONTHS = ['Январь', 'Февраль', 'Март', 'Апрель', 'Май', 'Июнь',
  'Июль', 'Август', 'Сентябрь', 'Октябрь', 'Ноябрь', 'Декабрь'];
const MONTHS_ROD = ['января', 'февраля', 'марта', 'апреля', 'мая', 'июня',
  'июля', 'августа', 'сентября', 'октября', 'ноября', 'декабря'];

const byMonth: Record<string, number> | undefined = (prices as any).prices?.[iata];
const rows = byMonth
  ? Object.entries(byMonth).filter(([, v]) => typeof v === 'number' && v > 0)
  : [];

const min = rows.length ? rows.reduce((a, b) => (b[1] < a[1] ? b : a)) : null;
const max = rows.length ? rows.reduce((a, b) => (b[1] > a[1] ? b : a)) : null;

const fmt = (n: number) => n.toLocaleString('ru-RU');
const nameOf = (key: string) => `${MONTHS[Number(key.slice(5, 7)) - 1]} ${key.slice(0, 4)}`;

const upd = (prices as any).updatedAt ? new Date((prices as any).updatedAt) : null;
const updText = upd ? `${upd.getUTCDate()} ${MONTHS_ROD[upd.getUTCMonth()]} ${upd.getUTCFullYear()}` : null;
---
{rows.length > 0 && (
  <>
    <table>
      <thead><tr><th>Месяц</th><th>{label}</th></tr></thead>
      <tbody>
        {rows.map(([key, val]) => (
          <tr>
            <td>{min && key === min[0] ? <b>{nameOf(key)}</b> : nameOf(key)}</td>
            <td>{min && key === min[0] ? <b>{fmt(val)}&nbsp;₽</b> : `${fmt(val)} ₽`}</td>
          </tr>
        ))}
      </tbody>
    </table>
    {updText && min && max && (
      <p class="live-table__note">
        Дешевле всего — {nameOf(min[0]).toLowerCase()}, {fmt(min[1])}&nbsp;₽; дороже всего — {nameOf(max[0]).toLowerCase()}, {fmt(max[1])}&nbsp;₽.
        Цены на одного в одну сторону из Москвы, выгрузка от {updText}, обновляется ежедневно.
      </p>
    )}
  </>
)}

<style>
  .live-table__note { color: var(--mid, #5c626b); font-size: 0.92em; }
</style>
