---
// Единый Swiss-хедер для всего сайта (брендбук). Самодостаточный: свои токены,
// Golos, бургер, active по текущему URL. Подключается один раз в Layout.astro.
// (Golos @font-face объявлен в Layout.astro — font-display:optional, один раз на сайт.)
const path = (Astro.url.pathname.replace(/\/+$/, '') || '/');
const is = (href) => {
  const h = (href.replace(/\/+$/, '') || '/');
  return h === '/' ? path === '/' : (path === h || path.startsWith(h + '/'));
};
// Меню собрано по вопросам читателя, а не по устройству сайта. Раньше в одном
// ряду стояли девять пунктов трёх разных природ: разрезы содержания
// (направления, визы, сезоны, поездки), инструменты (калькулятор, сравнение,
// чек-лист) и форматы текста (блог, новости). Читателю не за что зацепиться —
// он не знает, по какому признаку искать. Разбор тринадцати travel-сайтов
// 26.08.2026: медиана пять пунктов, первым почти у всех «куда поехать»,
// инструменты собраны под одно слово, названия — на языке читателя.
const LINKS = [
  { href: '/countries/', label: 'Куда поехать', под: [
    ['/countries/', 'Все направления', '70+ стран с фильтрами'],
    ['/trips/',     'По месяцам',      'что работает в каждом месяце'],
    ['/seasons/',   'Сезоны',          'когда лучше ехать'],
    // Сравнение живёт здесь, а не в сборах: направления сравнивают, пока
    // выбирают. В сборах его не нашёл бы тот, кто ещё не решил, куда едет.
    ['/compare/',   'Сравнить',        'два направления рядом'],
  ]},
  { href: '/visa/', label: 'Визы' },
  // «Сборы», а не «Подготовка»: человек говорит «собираюсь в поездку», а не
  // «занимаюсь подготовкой». У Condé Nast и Nomadic Matt на этом месте тоже
  // действие — Plan Your Trip, а не отглагольное существительное.
  { href: '/packing/', label: 'Сборы', под: [
    ['/packing/',    'Что взять',     'списки под страну и сезон'],
    ['/calculator/', 'Сколько стоит', 'расчёт бюджета поездки'],
  ]},
  // «Статьи», а не «Журнал»: журнал — слово редакции, читатель говорит
  // «почитать» или «статьи».
  { href: '/blog/', label: 'Статьи', под: [
    ['/blog/',    'Гайды и разборы', 'длинные тексты по странам'],
    ['/novosti/', 'Новости',         'что изменилось на этой неделе'],
  ]},
];

// Пункт подсвечен, если открыт он сам или что-то из его списка.
const activen = (п) => is(п.href) || (п.под || []).some(([h]) => is(h));
---
<header class={path === '/' ? 'sw-head over' : 'sw-head'}>
  <!-- Верхний ярус: марка и то, ради чего человек остаётся. Раньше эта строка
       лежала ниже сгиба, и до неё доходили не все. Композиция снята с Wallpaper*:
       марка и служебное сверху, меню отдельной строкой под линией. -->
  <div class="wrap band">
    <a class="wm" href="/">TravelTribe</a>
    {path !== '/' && <span class="claim">60+ стран лично · цены с перелётом</span>}
    <button class="burger" id="burger" type="button" aria-expanded="false" aria-controls="navmenu" aria-label="Открыть меню"><span></span><span></span><span></span></button>
  </div>
  <div class="wrap nav">
    <nav id="navmenu" aria-label="Основное меню"><ul>
      {LINKS.map((п) => (
        <li>
          {п.под ? (
            <details class={activen(п) ? 'grp on' : 'grp'} data-href={п.href}>
              <summary>{п.label}<svg class="v" viewBox="0 0 10 6" width="9" height="5" aria-hidden="true"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg></summary>
              <ul class="sub">
                {п.под.map(([h, имя, что]) => (
                  <li><a href={h} class={is(h) ? 'on' : ''} aria-current={is(h) ? 'page' : undefined}>
                    <span class="s-n">{имя}</span><span class="s-d">{что}</span>
                  </a></li>
                ))}
              </ul>
            </details>
          ) : (
            <a href={п.href} class={is(п.href) ? 'on' : ''} aria-current={is(п.href) ? 'page' : undefined}>{п.label}</a>
          )}
        </li>
      ))}
    </ul></nav>
  </div>
</header>

<style>
/* ⛔ На главной шапка лежит ПОВЕРХ кадра во весь экран — как у живых блогов,
   где первый экран это фотография, а не полоса меню над ней. Своего фона у неё
   там нет, цвета берутся светлые, а страница узнаёт её высоту через --head-h,
   чтобы поднять кадр под неё без сдвига разметки. */
.sw-head.over{position:absolute;top:0;left:0;right:0;z-index:20;background:transparent;
  border-bottom:none;color:#fff}
.sw-head.over .band{border-bottom-color:rgba(255,255,255,.32)}
.sw-head.over .wm,.sw-head.over .nav ul a,.sw-head.over .grp summary{color:#fff}
/* ⛔ Белые пункты уместны, пока шапка лежит ПОВЕРХ фотографии. Раскрытый
   бургер рисует меню на светлой панели — и белым оно почти невидимо: Никита
   прислал скриншот с телефона, пункты читались как блёклые тени. В открытом
   состоянии меню живёт на своём листе и красится как обычная шапка. */
.sw-head.over.open{background:var(--paper);border-bottom:1px solid var(--hair)}
.sw-head.over.open .band{border-bottom-color:var(--hair)}
.sw-head.over.open .wm,.sw-head.over.open .nav ul a,.sw-head.over.open .grp summary{color:var(--ink)}
.sw-head.over.open .burger span{background:var(--ink)}
.sw-head.over.open .nav ul a.on,.sw-head.over.open .grp.on summary{color:var(--gold)}
.sw-head.over .nav ul a.on,.sw-head.over .grp.on summary{color:#fff;
  text-decoration-color:rgba(255,255,255,.75)}
.sw-head.over .burger span{background:#fff}
/* Выпадающий список остаётся на своём листе — поверх фотографии он нечитаем. */
.sw-head.over .nav .sub a,.sw-head.over .nav .sub .s-n{color:var(--ink)}
.sw-head.over .nav .sub .s-d{color:var(--mid)}
.sw-head{--paper:#fbfbfa;--ink:#15171a;--gold:#1d40ae;--hair:#d9dbde;--line:#15171a;
  --ff:'Golos Text Variable','Golos Text',Helvetica,Arial,sans-serif;--edge:clamp(1.1rem,3vw,2.6rem);
  position:sticky;top:0;z-index:50;background:var(--paper);border-bottom:1px solid var(--line);
  font-family:var(--ff);color:var(--ink);font-variant-numeric:tabular-nums lining-nums}
.sw-head *{box-sizing:border-box}
.sw-head a{color:inherit;text-decoration:none}
.sw-head :focus-visible{outline:2px solid var(--gold);outline-offset:3px}
.sw-head .wrap{max-width:1280px;margin-inline:auto;padding-inline:var(--edge)}
/* Верхний ярус: марка слева, обещание справа, между ними линия до меню. */
/* ⛔ На главной эту же мысль несёт строка под заголовком — в шапке она была бы
   вторым экземпляром на одном экране. Там строку не показываем. */
.band{display:flex;align-items:baseline;justify-content:space-between;gap:1rem;
  padding-block:.72rem;border-bottom:1px solid var(--hair)}
.band .claim{margin-left:auto}
/* ⛔ line-height:1 обрезал строку по высоте букв — марка стала 142×22, ниже
   минимума в 24 точки, и общая проверка размеров целей покраснела на всех
   страницах во всех браузерах. Дать высоту явно. */
.wm{display:inline-flex;align-items:center;min-height:32px;font-weight:800;font-size:1.35rem;
  letter-spacing:-.03em;text-transform:uppercase;line-height:1.1}
.claim{font-size:.74rem;color:#5c626b;letter-spacing:.02em;white-space:nowrap}

/* Нижний ярус: меню по центру, разрядка как в журнальном оглавлении. */
.nav{display:flex;align-items:center;justify-content:center;gap:1rem;padding-block:0}
.nav ul{list-style:none;display:flex;justify-content:center;gap:2.2rem;font-size:.74rem;
  font-weight:600;letter-spacing:.13em;text-transform:uppercase;padding:0;margin:0}
.nav ul li{margin:0}
.nav ul a{display:inline-flex;align-items:center;min-height:44px;text-decoration:underline 1px transparent;text-underline-offset:.22em;font-weight:500}
.nav ul a:hover,.nav ul a:focus-visible{text-decoration-color:var(--gold)}
.nav ul a.on{color:var(--gold);text-decoration-color:var(--gold)}
/* ⛔ Раскрытие только по нажатию — половина решения. С мышью человек ждёт,
   что список откроется под курсором и закроется, когда курсор уйдёт: без
   этого меню кажется сломанным. Но на сенсорном экране наведения нет, там
   оно либо срабатывает до касания, либо залипает после. Поэтому наведение
   включается ТОЛЬКО там, где есть настоящий курсор, а нажатие работает
   везде — и мышью, и пальцем, и с клавиатуры. */
.grp{position:relative}
.grp summary{display:inline-flex;align-items:center;gap:.34rem;min-height:44px;cursor:pointer;
  list-style:none;font-weight:500;text-decoration:underline 1px transparent;text-underline-offset:.22em}
.grp summary::-webkit-details-marker{display:none}
.grp summary:hover,.grp summary:focus-visible{text-decoration-color:var(--gold)}
.grp.on>summary{color:var(--gold);text-decoration-color:var(--gold)}
.grp .v{transition:transform .18s ease;flex:none}
.grp[open] .v{transform:rotate(180deg)}
/* ⛔ Вес селектора обязан быть выше, чем у `.nav ul`, — тот задаёт горизонтальный
   ряд: gap 2.2rem, выравнивание по центру, разрядка капсом. В выпадающем списке
   всё это лишнее, а зазор в 35 пикселей между пунктами протекал туда и разносил
   список втрое (замер 27.08: пункт 54 px, между пунктами ещё 35 px пустоты).
   `.sub` из одного класса проигрывал `.nav ul` из класса и тега. */
.nav ul .sub{position:absolute;top:100%;left:-.9rem;min-width:17rem;background:var(--paper);
  border:1px solid var(--line);padding:.25rem 0;margin:0;list-style:none;
  display:flex;flex-direction:column;gap:0;align-items:stretch;justify-content:flex-start;
  text-transform:none;letter-spacing:0;font-size:1rem}
/* ⛔ Показывать список стилями в обход <details> нельзя: сам элемент остаётся
   закрытым, и для программ чтения с экрана содержимого как бы нет. Наведение
   ОТКРЫВАЕТ элемент по-настоящему — этим занимается скрипт ниже. */
/* ⛔ Меню прижато к правому краю страницы, поэтому список, растущий вправо,
   вылезает за экран: у «Журнала» на 134 пикселя, у «Подготовки» на 13 (замер
   26.08). Растим влево у всех групп, кроме первой, — там место есть. */
.nav ul li:not(:first-child) .sub{left:auto;right:-.9rem}
.sub li{border-top:1px solid var(--hair)}
.sub li:first-child{border-top:0}
/* ⛔ Селектор с весом выше, чем у `.nav ul a`: иначе родительские правила
   центрировали названия, а описания оставляли слева. */
/* Замер чужих меню (27.08, ширина 1440): шаг от пункта к пункту — Stripe 63,
   Airbnb 60, GitHub 53 пикселя. Воздух у них стоит МЕЖДУ пунктами, у нас
   вместо него волосяная линия, поэтому тот же воздух уходит внутрь пункта. */
.nav ul .sub a{display:flex;flex-direction:column;align-items:flex-start;gap:.12rem;
  padding:.78rem 1.05rem;min-height:44px;justify-content:center;
  text-transform:none;letter-spacing:0;text-align:left;width:100%}
.nav ul .sub a:hover,.nav ul .sub a:focus-visible{background:rgba(29,64,174,.07);text-decoration-color:transparent}
.s-n{font-size:.92rem;font-weight:600;text-transform:none;letter-spacing:0;line-height:1.3}
.s-d{font-size:.8rem;color:#5c626b;font-weight:400;text-transform:none;letter-spacing:0;line-height:1.35}
.sub a.on .s-n{color:var(--gold)}

@media (hover:hover) and (pointer:fine){
  .grp:hover>summary{color:var(--gold)}
  /* Мостик под пунктом: без него курсор по дороге к списку проходит через
     зазор, наведение срывается и список схлопывается перед самым нажатием. */
  .grp>summary::after{content:'';position:absolute;left:0;right:0;top:100%;height:10px}
}

.burger{display:none;width:44px;height:44px;flex-direction:column;justify-content:center;align-items:center;gap:5px;background:none;border:none;cursor:pointer;padding:0;margin:-.4rem -.6rem -.4rem 0}
.burger span{display:block;width:24px;height:2px;background:var(--ink);transition:transform .2s ease,opacity .2s ease}
.sw-head.open .burger span:nth-child(1){transform:translateY(7px) rotate(45deg)}
.sw-head.open .burger span:nth-child(2){opacity:0}
.sw-head.open .burger span:nth-child(3){transform:translateY(-7px) rotate(-45deg)}
@media(max-width:920px){
  .burger{display:flex}
  /* ⛔ На телефоне строка про страны выталкивала кнопку меню за край экрана —
     нажать её было нельзя. В узком ярусе остаются только марка и кнопка. */
  .band .claim{display:none}
  /* ⛔ baseline годится, пока в ряду только текст — марка и строка про страны.
     На узком экране рядом с маркой остаётся кнопка меню, у неё своя высота,
     и выравнивание по базовой линии даёт разные поля сверху и снизу
     (записанная ловушка WebKit). Здесь ряд держим по центру. */
  .band{padding-block:.55rem;align-items:center}
  #navmenu{position:absolute;left:0;right:0;top:100%;background:var(--paper);border-bottom:1px solid var(--line);display:none;max-height:calc(100vh - 54px);overflow:auto}
  .sw-head.open #navmenu{display:block}
  .nav ul{flex-direction:column;gap:0;padding:.2rem var(--edge) 1rem}
  .nav ul li{border-top:1px solid var(--hair)}
  .nav ul a{min-height:52px;width:100%;font-size:.92rem;letter-spacing:.02em}
  /* В бургере список уже вертикальный — группа разворачивается внутрь него,
     а не всплывает поверх. */
  .grp summary{min-height:52px;width:100%;justify-content:space-between;font-size:.92rem;letter-spacing:.02em}
  /* ⛔ Вес держим наравне с настольным правилом `.nav ul .sub`: иначе список
     внутри бургера снова всплывает поверх страницы вместо того, чтобы
     разворачиваться внутрь. Поймала проверка 8 сразу после правки веса. */
  .nav ul .sub{position:static;border:0;min-width:0;padding:0 0 .4rem;background:transparent}
  .sub li{border-top:0}
  .nav ul .sub a{padding:.45rem 0 .45rem 1rem;min-height:44px}
  .s-n{font-size:.9rem}
}
</style>

<script>
  // ⛔ Три вещи, без которых меню ведёт себя сломанным (найдено 27.08 на живом
  //    сайте): два списка раскрывались одновременно и налезали друг на друга;
  //    открытый список не закрывался, когда курсор уходил; закрыть его можно
  //    было только повторным нажатием по тому же пункту.
  (() => {
    const шапка = document.querySelector('.sw-head');
    if (!шапка) return;
    const группы = [...шапка.querySelectorAll('details.grp')];
    const узкий = () => window.matchMedia('(max-width:920px)').matches;
    const закрытьВсе = (кроме) => группы.forEach((г) => { if (г !== кроме) г.open = false; });

    группы.forEach((г) => {
      // Открылся один — остальные закрываются. На узком экране список
      // разворачивается внутрь бургера, там соседи не мешают друг другу.
      г.addEventListener('toggle', () => { if (г.open && !узкий()) закрытьВсе(г); });

      // Наведение открывает и закрывает список по-настоящему — меняет
      // состояние элемента, а не прячет его стилями. Только с настоящей
      // мышью: на сенсорном экране «уход курсора» не случается никогда,
      // и список залипал бы открытым.
      const мышь = () => window.matchMedia('(hover:hover) and (pointer:fine)').matches;
      let таймер;
      г.addEventListener('mouseenter', () => {
        clearTimeout(таймер);
        if (!узкий() && мышь()) г.open = true;
      });
      г.addEventListener('mouseleave', () => {
        if (узкий() || !мышь()) return;
        таймер = setTimeout(() => { г.open = false; }, 180);
      });
      // ⛔ С мышью список уже раскрыт наведением, и нажатие по заголовку
      //    схлопнуло бы то, что человек только что открыл. Гасим переключение
      //    и уводим на страницу раздела — пункт ведёт себя как ссылка.
      г.querySelector('summary').addEventListener('click', (e) => {
        if (узкий() || !мышь()) return;
        e.preventDefault();
        const адрес = г.dataset.href;
        if (адрес) window.location.href = адрес;
      });
    });

    // Esc и нажатие мимо шапки закрывают всё открытое.
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') закрытьВсе(null); });
    document.addEventListener('click', (e) => {
      if (!e.target.closest('.sw-head')) закрытьВсе(null);
    });
  })();

  // Высота шапки нужна главной: там кадр поднимается под неё.
  const шапка0 = document.querySelector('.sw-head.over');
  if (шапка0) {
    const мерить = () => document.documentElement.style
      .setProperty('--head-h', Math.round(шапка0.getBoundingClientRect().height) + 'px');
    мерить();
    window.addEventListener('resize', мерить);
  }

  const burger = document.getElementById('burger');
  const head = document.querySelector('.sw-head');
  if (burger && head) {
    const navmenu = head.querySelector('#navmenu');
    const setOpen = (o) => { burger.setAttribute('aria-expanded', String(o)); head.classList.toggle('open', o); burger.setAttribute('aria-label', o ? 'Закрыть меню' : 'Открыть меню'); };
    burger.addEventListener('click', () => setOpen(burger.getAttribute('aria-expanded') !== 'true'));
    if (navmenu) navmenu.addEventListener('click', (e) => { if (e.target.closest('a')) setOpen(false); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setOpen(false); });
    document.addEventListener('click', (e) => { if (head.classList.contains('open') && !e.target.closest('.sw-head')) setOpen(false); });
  }
</script>
