---
// CountryMap — карта с номерами точек и список мест под ней.
// ⛔ Список, а не таблица: на телефоне таблица становилась карточками с подписью у каждого
//    поля («Тип», «Координаты», «Карты») и чертой под каждой строкой — пометка Никиты
//    10.09.2026: «Слишком много линий, нужно убрать их везде и не делать такие повторения».
// У каждого места — кадр (пометка Никиты 10.09.2026: «в каждой карточке должны быть сочные
//    картинки»). Файл — в _images/poi/<страна>/, лицензия — в _credits.json той же папки; подпись
//    «Фотографии мест: …» собирается из неё, как на странице страны.
// Lazy-load из CDN через IntersectionObserver (карта инициализируется только когда видна).
// Pins — gold круг с номером 01..N, белый контур (без box-shadow по брендбуку).
//
// Usage: <CountryMap slug="japan" countryNom="Япония" />

import { getPois } from '../data/country-pois.js';
import { NOUN } from '../data/plural.js';
import { Image } from 'astro:assets';
import { typo } from '../utils/typo.js';

interface Props {
  slug: string;
  countryNom?: string;
}
const { slug, countryNom } = Astro.props;
const data = getPois(slug);
if (!data?.pois?.length) return null as any;

const poiFiles = import.meta.glob('../content/blog/_images/poi/**/*.jpg', { import: 'default' });
const poiCredits = import.meta.glob('../content/blog/_images/poi/**/_credits.json', { eager: true, import: 'default' });
const places = await Promise.all(data.pois.map(async (p) => {
  const load = p.photo ? poiFiles[`../content/blog/_images/${p.photo}`] : null;
  if (p.photo && !load) throw new Error(`Кадр места не найден: ${p.photo}`);
  return { ...p, img: load ? await load() : null };
}));
const семья = (l) => (/^CC BY-SA/i.test(l) ? 'CC BY-SA' : /^CC BY/i.test(l) ? 'CC BY' : /^CC0/i.test(l) ? 'CC0' : l);
const авторы = new Map();
for (const p of places) {
  if (!p.photo) continue;
  const cut = p.photo.lastIndexOf('/');
  const rec = (poiCredits[`../content/blog/_images/${p.photo.slice(0, cut)}/_credits.json`] || {})[p.photo.slice(cut + 1).replace(/\.\w+$/, '')];
  if (!rec?.creator) continue;
  const lic = семья(rec.license || '');
  if (!авторы.has(lic)) авторы.set(lic, []);
  if (!авторы.get(lic).includes(rec.creator)) авторы.get(lic).push(rec.creator);
}
const фотоМест = авторы.size ? `Фотографии мест: ${[...авторы].map(([lic, who]) => `${who.join(', ')} (${lic})`).join('; ')}.` : '';

// Уникальный ID контейнера карты — на случай если несколько CountryMap на одной странице
const mapId = `cmap-${slug}-${Math.random().toString(36).slice(2, 7)}`;

const TYPE_LABEL: Record<string, string> = {
  city: 'город',
  nature: 'природа',
  culture: 'культура',
  beach: 'пляж',
  food: 'еда'
};
---

<section class="cm" aria-label={`Карта — ${countryNom || slug}`}>
  <header class="cm-h">
    <h2 class="cm-t">Где смотреть{countryNom ? ` — ${countryNom}` : ''}</h2>
    <span class="cm-meta">{data.visited ? 'Реальный маршрут' : 'Обзорная карта'} · {data.pois.length} {NOUN.point(data.pois.length)}</span>
  </header>

  <div class="cm-frame">
    <div id={mapId} class="cm-map" role="application" aria-roledescription={`Интерактивная карта: ${data.pois.length} ${NOUN.point(data.pois.length)}, ${countryNom || slug}`}></div>
    <noscript>
      <p class="cm-noscript">Карта требует JavaScript; места перечислены ниже.</p>
    </noscript>
  </div>

  <ol class="cm-list">
    {places.map((p, i) => {
      const gmaps = `https://www.google.com/maps/search/?api=1&query=${p.lat},${p.lng}`;
      const ymaps = `https://yandex.ru/maps/?ll=${p.lng},${p.lat}&z=12&pt=${p.lng},${p.lat}`;
      return (
        <li class="cm-item">
          {p.img && <span class="cm-ph"><Image src={p.img} alt={p.alt || p.name} widths={[400, 800]} sizes="(max-width: 760px) 100vw, 380px" formats={['webp']} quality={76} loading="lazy" /></span>}
          <span class="cm-no" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <div class="cm-body">
            <b class="cm-name">{p.name}</b>
            {p.note && <span class="cm-note">{p.note}</span>}
            <span class="cm-foot">
              {p.type && <span class="cm-type">{TYPE_LABEL[p.type] || p.type}</span>}
              <a href={ymaps} target="_blank" rel="noopener">Яндекс Карты</a>
              <a href={gmaps} target="_blank" rel="noopener">Google Maps</a>
            </span>
          </div>
        </li>
      );
    })}
  </ol>
  {фотоМест && <p class="cm-credits">{typo(фотоМест)}</p>}
</section>

<script is:inline define:vars={{ mapId, pois: data.pois, center: data.center }}>
  (function() {
    var el = document.getElementById(mapId);
    if (!el) return;

    function load() {
      // CSS Leaflet — один раз на страницу
      if (!document.querySelector('link[data-leaflet]')) {
        var css = document.createElement('link');
        css.rel = 'stylesheet';
        css.href = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.css';
        css.integrity = 'sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=';
        css.crossOrigin = '';
        css.setAttribute('data-leaflet', '1');
        document.head.appendChild(css);
      }
      // JS Leaflet — один раз на страницу
      function init() {
        var L = window.L;
        var map = L.map(mapId, { scrollWheelZoom: false, attributionControl: true })
          .setView([center.lat, center.lng], center.zoom);
        L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
          maxZoom: 17,
          attribution: '© <a href="https://www.openstreetmap.org/copyright" target="_blank">OpenStreetMap</a>'
        }).addTo(map);

        var bounds = [];
        pois.forEach(function(p, i) {
          var n = String(i + 1).padStart(2, '0');
          var icon = L.divIcon({
            className: 'cm-pin',
            html: '<span class="cm-pin-n">' + n + '</span>',
            iconSize: [30, 30],
            iconAnchor: [15, 15]
          });
          var m = L.marker([p.lat, p.lng], { icon: icon }).addTo(map);
          var html = '<b>' + p.name + '</b>' + (p.note ? '<br><span class="cm-pop-n">' + p.note + '</span>' : '');
          m.bindPopup(html, { closeButton: true, autoClose: true });
          bounds.push([p.lat, p.lng]);
        });
        if (bounds.length > 1) {
          map.fitBounds(bounds, { padding: [40, 40], maxZoom: 9 });
        }
        // Дать клик-zoom включить wheel scroll (UX: не блокирует страничный скролл)
        map.on('click', function() { map.scrollWheelZoom.enable(); });
        map.on('mouseout', function() { map.scrollWheelZoom.disable(); });
      }
      if (window.L) { init(); return; }
      var existing = document.querySelector('script[data-leaflet]');
      if (existing) { existing.addEventListener('load', init); return; }
      var js = document.createElement('script');
      js.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js';
      js.integrity = 'sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=';
      js.crossOrigin = '';
      js.setAttribute('data-leaflet', '1');
      js.onload = init;
      document.head.appendChild(js);
    }

    // Lazy: ждать пока карта попадёт в viewport
    if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(function(entries) {
        if (!entries[0].isIntersecting) return;
        io.disconnect();
        load();
      }, { rootMargin: '200px' });
      io.observe(el);
    } else {
      load();
    }
  })();
</script>

<style>
.cm {
  padding: 56px 0;
  font-variant-numeric: tabular-nums lining-nums;
}
.cm-h { display: flex; align-items: baseline; flex-wrap: wrap; gap: 6px 16px; margin: 0 0 20px; }
.cm-t { margin: 0; }
.cm-meta { margin-left: auto; font-size: .875rem; color: var(--text-faint); }
.cm-map { width: 100%; aspect-ratio: 16 / 9; max-height: 460px; min-height: 280px; background: var(--bg); }
.cm-noscript { padding: 1rem 0; font-size: .875rem; color: var(--text-dim); }
.cm-list {
  list-style: none; margin: 28px 0 0; padding: 0;
  display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px 40px;
}
.cm-item { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 12px 14px; align-items: baseline; }
.cm-ph { grid-column: 1 / -1; display: block; aspect-ratio: 3 / 2; overflow: hidden; background: var(--bg2); }
.cm-ph :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; }
.cm-credits { margin: 24px 0 0; font-size: .8125rem; line-height: 1.5; color: var(--text-faint); text-wrap: balance; }
.cm-no { flex: none; min-width: 1.5rem; font-family: var(--ff-mono); font-size: .8125rem; color: var(--gold); }
.cm-body { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
.cm-name { font-weight: 700; font-size: 1.0625rem; line-height: 1.35; color: var(--text); }
.cm-note { font-size: .9375rem; line-height: 1.55; color: var(--text-dim); }
.cm-foot { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0 16px; font-size: .875rem; }
.cm-type { color: var(--text-faint); }
.cm-foot a {
  display: inline-block; padding: 8px 0;
  color: var(--gold); text-decoration: underline 1px; text-underline-offset: .22em;
}
/* Leaflet pin — Swiss: gold disc + ink border + white number, без shadow/радиуса */
:global(.leaflet-container) {
  font-family: var(--ff-display, "Golos Text Variable", Helvetica, Arial, sans-serif);
  background: #e9ebec;
}
:global(.cm-pin) {
  background: transparent !important;
  border: none !important;
}
:global(.cm-pin-n) {
  display: flex; align-items: center; justify-content: center;
  width: 30px; height: 30px;
  background: #1d40ae;        /* var(--gold) — нельзя в global */
  color: #fff;
  font-family: inherit;
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 0;
  font-variant-numeric: tabular-nums lining-nums;
  border: 2px solid #15171a;
}
:global(.leaflet-popup-content-wrapper) {
  border-radius: 0 !important;
  background: #fbfbfa;
  color: #15171a;
  font-family: var(--ff-display, Helvetica, Arial, sans-serif);
  font-size: .88rem;
  line-height: 1.45;
  border: 1px solid #15171a;
  box-shadow: none !important;
}
:global(.leaflet-popup-tip) {
  background: #fbfbfa;
  border-right: 1px solid #15171a;
  border-bottom: 1px solid #15171a;
  box-shadow: none !important;
}
:global(.leaflet-popup-content) { margin: .55rem .8rem; }
:global(.leaflet-popup-content b) { font-weight: 800; }
:global(.cm-pop-n) { color: #52565c; font-size: .8rem; }

@media (max-width: 760px) {
  .cm { padding: 40px 0; }
  .cm-meta { margin-left: 0; }
  .cm-map { aspect-ratio: 4 / 3; max-height: 360px; }
  .cm-list { grid-template-columns: 1fr; gap: 18px; }
}
</style>
