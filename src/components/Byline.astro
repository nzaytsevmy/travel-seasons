---
// Видимый byline для содержательных страниц (E-E-A-T): автор → /about/, Telegram и
// необязательная заметка. Даты «обновлено …» нет: читателю не важно, когда сверяли
// данные (правило Никиты 08–09.09.2026). Классы .byline-author/.byline-fresh — канон репо.
const { note } = Astro.props;
---
<p class="byline">
  <a href="/about/" class="byline-author">Никита Зайцев</a> ·
  <a href="https://t.me/traveltriberu" target="_blank" rel="noopener">@traveltriberu</a>{note && <> · <span class="byline-fresh">{note}</span></>}
</p>

<style>
  .byline { font-size: .78rem; line-height: 1.5; color: var(--text-faint); margin: .6rem 0 0; }
  .byline a { color: var(--text-dim); text-decoration: underline 1px rgba(107,104,94,.5); text-underline-offset: 2px; }
  .byline a.byline-author { color: var(--gold); text-decoration: underline 1px rgba(29,64,174,.5); text-underline-offset: .22em; }
  .byline-fresh { color: var(--text-faint); }
</style>
