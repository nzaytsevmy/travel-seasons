---
interface Props {
  notes: [string, string][];
  monthly: boolean;
}

const { notes, monthly } = Astro.props;
---
<section class="prep-season" aria-labelledby="packing-season-title">
  <h2 id="packing-season-title">{monthly ? 'Что меняется в декабре' : 'Как собрать список под маршрут'}</h2>
  <dl>
    {notes.map(([label, advice]) => (
      <div><dt>{label}</dt><dd>{advice}</dd></div>
    ))}
  </dl>
</section>

<style>
  .prep-season { margin: 0; padding: 1.5rem 0; }
  h2 { margin: 0 0 .65rem; font: 700 clamp(1.45rem, 2.6vw, 2rem) / 1.2 "Old Standard TT", Georgia, serif; }
  dl { margin: 0; }
  dl > div { display: grid; gap: .25rem; padding: .7rem 0; border-top: 1px solid #d9dbde; }
  dt { font-weight: 650; }
  dd { margin: 0; max-width: 65ch; line-height: 1.55; }
  @media (min-width: 768px) {
    dl > div { grid-template-columns: minmax(10ch, 1fr) minmax(0, 3fr); gap: 1rem; }
  }
</style>
