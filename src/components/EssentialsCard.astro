---
// EssentialsCard — Swiss/Brandbook.
// Эталон: ~/Downloads/tt-home-1-editorial.html (vlist + shead + dash + gear-grid).
// Без border-radius, без bg-карточек, только hairlines + индексы 01/02 gold + uppercase labels.

import { PLUG_TYPES, plugVerdict } from '../data/country-plug-types.js';
import { getEssentials } from '../data/country-essentials.js';
import { getCustoms } from '../data/country-customs.js';

interface Props {
  slug: string;
  countryName?: string;
}
const { slug, countryName } = Astro.props;

const plug = PLUG_TYPES[slug];
const ess = getEssentials(slug);
const cust = getCustoms(slug);

// Блок ради одной розетки не ставим: она уже стоит строкой «Розетка» в «Правилах и деньгах» страницы страны
// (пометка Никиты 11.09.2026: «слишком большое расстояние для такого малоинформативного блока»).
const hasAny = ess || cust;
if (!hasAny) return null as any;


// Короткие практики — 4 ячейки value-list
const quick: { k: string; main: string; meta?: string; note?: string }[] = [];
if (plug) quick.push({ k: 'Розетки', main: `Тип ${plug.types}`, meta: `${plug.voltage} · ${plug.hz}`, note: plugVerdict(plug.types).long });
if (ess?.water) quick.push({ k: 'Вода из-под крана', main: ess.water.tap_drinkable ? 'Можно пить' : 'Только бутилированная', meta: ess.water.note });
if (ess?.tipping) {
  const tipMain = (/нет/i.test(ess.tipping.restaurants) && /нет/i.test(ess.tipping.taxi)) ? 'Не приняты' : 'По ситуации';
  quick.push({ k: 'Чаевые', main: tipMain, meta: `Рестораны: ${ess.tipping.restaurants}. Такси: ${ess.tipping.taxi}.`, note: ess.tipping.hotel ? `Отели: ${ess.tipping.hotel}.` : undefined });
}
if (ess?.taxi_apps?.length) {
  const names = ess.taxi_apps.map(t => t.name).join(' · ');
  const head = ess.taxi_apps[0];
  const tail = ess.taxi_apps.slice(1).map(t => `${t.name} — ${t.note}`).join('. ');
  quick.push({ k: 'Такси-приложения', main: names, meta: head ? `${head.name} — ${head.note}.` : undefined, note: tail || undefined });
}

// Экстренные номера — data-таблица
const dash: { k: string; v: string; link?: { href: string; label: string } }[] = [];
if (ess?.emergency?.police) dash.push({ k: 'Полиция', v: ess.emergency.police });
if (ess?.emergency?.ambulance_fire) dash.push({ k: 'Скорая · пожарные', v: ess.emergency.ambulance_fire });
if (ess?.emergency?.ambulance) dash.push({ k: 'Скорая', v: ess.emergency.ambulance });
if (ess?.emergency?.fire) dash.push({ k: 'Пожарные', v: ess.emergency.fire });
if (ess?.emergency?.embassy_ru_phone) dash.push({ k: 'Посольство РФ', v: ess.emergency.embassy_ru_phone, link: ess.emergency.embassy_ru_url ? { href: ess.emergency.embassy_ru_url, label: 'сайт' } : undefined });

// Подзаголовок называет только то, что в блоке есть: раньше он обещал шесть тем и там, где была одна розетка.
const topics = [
  plug && 'розетки',
  ess?.tipping && 'чаевые',
  dash.length > 0 && 'экстренные номера',
  ess?.water && 'вода',
  ess?.taxi_apps?.length && 'такси',
  (cust?.forbidden?.length || cust?.limits) && 'таможня',
].filter(Boolean) as string[];
const subtitle = topics.length ? `${topics.join(', ').replace(/^./, (c) => c.toUpperCase())} — фактами.` : '';
---

<section class="ec" aria-label={`Бытовая практика — ${countryName || slug}`}>
  <header class="ec-h">
    <h2 class="ec-t">Что нужно знать на месте{countryName ? ` — ${countryName}` : ''}</h2>
  </header>
  {subtitle && <p class="ec-s">{subtitle}</p>}

  {quick.length > 0 && (
    <div class={`ec-vl ec-vl--cols-${Math.min(4, quick.length)}`}>
      {quick.map((q) => (
        <div class="ec-vi">
          <span class="ec-vk">{q.k}</span>
          <div class="ec-vm">{q.main}</div>
          {q.meta && <div class="ec-vd">{q.meta}</div>}
          {q.note && <div class="ec-vn">{q.note}</div>}
        </div>
      ))}
    </div>
  )}

  {dash.length > 0 && (
    <div class="ec-section">
      <h3 class="ec-th">Экстренные номера</h3>
      <table class="ec-dash">
        <tbody>
          {dash.map((r) => (
            <tr>
              <td data-l="Кому">{r.k}</td>
              <td data-l="Номер" class="r">
                {r.v}
                {r.link && <a href={r.link.href} target="_blank" rel="noopener" class="ec-dlink">{r.link.label}</a>}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}

  {cust?.forbidden?.length > 0 && (
    <div class="ec-section">
      <h3 class="ec-th">Таможня — нельзя ввозить</h3>
      <ul class="ec-cus">
        {cust.forbidden.map((item) => (
          <li><span class="ec-x" aria-hidden="true">×</span>{item}</li>
        ))}
      </ul>
    </div>
  )}

  {cust?.limits && (
    <div class="ec-section">
      <h3 class="ec-th">Лимиты ввоза</h3>
      <div class="ec-vl ec-vl--cols-4">
        {cust.limits.cash && <div class="ec-vi"><span class="ec-vk">Наличные</span><div class="ec-vm">{cust.limits.cash.replace(/^до /, '')}</div>{!/без декларации/i.test(cust.limits.cash) && <div class="ec-vd">без декларации</div>}</div>}
        {cust.limits.alcohol && <div class="ec-vi"><span class="ec-vk">Алкоголь</span><div class="ec-vm">{cust.limits.alcohol}</div></div>}
        {cust.limits.cigarettes && <div class="ec-vi"><span class="ec-vk">Сигареты</span><div class="ec-vm">{cust.limits.cigarettes}</div></div>}
        {cust.limits.perfume && <div class="ec-vi"><span class="ec-vk">Парфюм</span><div class="ec-vm">{cust.limits.perfume}</div></div>}
      </div>
    </div>
  )}

</section>

<style>
/* Без чёрных рамок и черт между ячейками — как разделы Омана (пометка Никиты 10.09.2026:
   «Слишком много линий, нужно убрать их везде»). Разделитель у блока один — линия сверху. */
.ec {
  padding: 56px 0;
  font-variant-numeric: tabular-nums lining-nums;
}
.ec-h { margin: 0 0 8px; }
.ec-t { margin: 0; }
.ec-s { font-size: .9375rem; line-height: 1.55; color: var(--text-dim); margin: 0 0 24px; max-width: 64ch; }
.ec-vl { display: grid; gap: 20px 32px; margin: 0 0 32px; }
.ec-vl--cols-4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
.ec-vl--cols-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
.ec-vl--cols-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
.ec-vl--cols-1 { grid-template-columns: 1fr; }
.ec-vk { display: block; font-size: .75rem; font-weight: 600; letter-spacing: .04em; text-transform: uppercase; color: var(--text-faint); margin-bottom: 6px; }
.ec-vm { font-weight: 700; font-size: 1.0625rem; line-height: 1.3; color: var(--text); }
.ec-vd { font-size: .875rem; color: var(--text-dim); margin-top: 3px; line-height: 1.5; }
.ec-vn { font-size: .8125rem; color: var(--text-faint); margin-top: 4px; line-height: 1.5; }
.ec-section { margin: 0 0 28px; }
/* Нижнее поле блока — как у разделов страницы: отступ последнего куска (и его последней части — у лимитов
   ввоза это сетка карточек) к полю не прибавляется. */
.ec > :last-child, .ec > :last-child > :last-child { margin-bottom: 0; }
.ec-th { font-size: 1.0625rem; font-weight: 700; margin: 0 0 10px; color: var(--text); }
.ec-dash { border-collapse: collapse; font-size: .9375rem; }
.ec-dash td { padding: 5px 24px 5px 0; vertical-align: baseline; color: var(--text); }
.ec-dash td.r { font-weight: 700; padding-right: 0; }
.ec-dlink { margin-left: 10px; font-size: .8125rem; font-weight: 600; color: var(--gold); text-decoration: underline 1px; text-underline-offset: .22em; }
.ec-cus { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px; }
.ec-cus li { font-size: .9375rem; line-height: 1.5; color: var(--text); display: flex; gap: 10px; }
.ec-x { color: var(--gold); font-weight: 700; flex: none; width: 1rem; }
@media (max-width: 760px) {
  .ec { padding: 40px 0; }
  .ec-vl--cols-4, .ec-vl--cols-3 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}
@media (max-width: 480px) {
  .ec-vl--cols-4, .ec-vl--cols-3, .ec-vl--cols-2 { grid-template-columns: 1fr; }
}
</style>
