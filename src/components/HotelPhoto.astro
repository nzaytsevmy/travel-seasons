---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props {
  src: ImageMetadata;
  alt: string;
  sizes: string;
  wide?: boolean;
  lead?: boolean;
  loading?: 'lazy' | 'eager';
}
const { src, alt, sizes, wide = false, lead = false, loading = 'lazy' } = Astro.props;
async function candidates(aspect: number, maximum: number) {
  // A crop must fit both native dimensions. Width-only checks admit blurry crops.
  const limit = Math.floor(Math.min(maximum, src.width, src.height * aspect));
  const widths = [...new Set([400, 800, 1200, 1600, 2400, limit].filter(width => width <= limit))].sort((a, b) => a - b);
  const variants = await Promise.all(widths.map(width => getImage({ src, width,
    height: Math.round(width / aspect), fit: 'cover', format: 'webp', quality: 88 })));
  return { srcset: variants.map((image, i) => `${image.src} ${widths[i]}w`).join(', '),
    largest: variants.at(-1)!, width: limit, height: Math.round(limit / aspect) };
}
const desktop = await candidates(wide ? 16 / 9 : 4 / 3, lead ? 2400 : 1600);
const mobile = wide ? await candidates(4 / 3, 1600) : desktop;
---
<picture style={`--hotel-photo-ratio:${wide ? '16 / 9' : '4 / 3'}`}>
  {wide && <source media="(max-width: 767px)" srcset={mobile.srcset} sizes={sizes} type="image/webp" />}
  <img src={desktop.largest.src} srcset={desktop.srcset} sizes={sizes}
    width={desktop.width} height={desktop.height} alt={alt} loading={loading}
    decoding="async" fetchpriority={loading === 'eager' ? 'high' : 'auto'} />
</picture>
<style>
  picture { display:block; width:100%; }
  img { display:block; width:100%; height:auto; aspect-ratio:var(--hotel-photo-ratio); object-fit:cover; }
  @media(max-width:767px) { img { aspect-ratio:4 / 3; } }
</style>
