---
// Одна заметка ленты /novosti/. Общая для ленты и для архива месяца, чтобы
// разметка и микроразметка не разъехались между двумя шаблонами.
//
// Устройство карточки продиктовано замерами 2026, а не вкусом:
//  · капсула-ответ первой строкой — её извлекает нейроответ, а человек по ней
//    решает, читать ли дальше;
//  · картинка — без неё заметка не попадает ни в дзен-ленту (наш фид требует
//    enclosure), ни в Discover, и заметно реже отбирается в ИИ-выдачу;
//  · имя автора — упоминания бренда коррелируют с цитированием втрое сильнее
//    обратных ссылок, а брендовых запросов у сайта пока ноль.
// Фото только свои, из уже отснятого: чужие права не трогаем.
//
// ⛔ Микроразметки NewsArticle здесь БОЛЬШЕ НЕТ. С 10.08.2026 у заметки есть своя
// страница, и статья объявляется там — один раз, со своим адресом. Пока разметка
// стояла и в ленте, и в архиве, один и тот же текст объявлялся статьёй по трём
// разным адресам; после появления собственной страницы это стало прямым
// конфликтом адресов. Лента и архив теперь дают список со ссылками (ItemList),
// как и положено листингу.
import { Image } from 'astro:assets';
import { TOPIC_LABEL, IMPACT_LABEL, formatDateRu, addedAt } from '../data/news.js';
import { pickNewsImage, newsImageNote } from '../data/news-images.js';
import { bySlug } from '../data/directions.js';
import { newsUrl } from '../data/news.js';

const { entry, Content, index = 0 } = Astro.props;
const d = entry.data;
// Когда заметка появилась в ленте: явное поле, а у старых — дата сверки.
const added = new Date(addedAt({ data: d }));
const addedIso = added.toISOString().slice(0, 10);
const countryName = (slug) => bySlug(slug)?.cases?.nom ?? slug;
// Страна заметки не обязана быть направлением сайта: робот ставит её ради
// подбора фото, а визовой страницы может не быть вовсе. Ссылку даём только на
// существующие — иначе получаем битый адрес (поймано на Намибии и Австралии).
const linkedCountries = (d.countries ?? []).filter((s) => bySlug(s));
const cover = pickNewsImage(d, entry.slug, index);
// Подпись под кадром. Для стока честно называем, ЧТО на фото и чей он: иначе
// иллюстрация к теме читается как снимок с места события. Названия у кадра со
// стока может не быть вовсе — тогда говорим прямо, что это иллюстрация, а не
// оставляем читателя с одним именем автора.
const coverNote = d.imageCredit
  ? [d.imageTitle || 'Иллюстрация к теме', `фото: ${d.imageCredit}`, d.imageLicense]
      .filter(Boolean).join(' · ')
  : newsImageNote(d);
const coverLink = d.imageSource ?? null;
---
<li class="nv-item" id={entry.slug}>
  <div class="nv-meta">
    {/* Дата на карточке — та же, по которой отсортирована лента: когда заметка
        в ней появилась. Иначе список выглядит сломанным: сверху стоит «26 июля»,
        под ним «31 июля», и читатель не понимает, по какому принципу это лежит.
        Дата самого события осталась в тексте заметки. */}
    <time datetime={addedIso}>{formatDateRu(added)}</time>
    <span class="nv-topic">{TOPIC_LABEL[d.topic]}</span>
    {d.impact === 'high' && <span class="nv-impact">{IMPACT_LABEL.high}</span>}
    {d.status && <span class="nv-status">{d.status}</span>}
  </div>

  <h2 class="nv-title"><a href={newsUrl(entry)}>{d.title}</a></h2>

  {d.tldr && <p class="nv-tldr">{d.tldr}</p>}

  {cover && (
    <figure class="nv-fig">
      {/* ⛔ Ширины 480 и 800 — и не больше. Кандидат 1200 добавляли ради Дзена и
          Discover, но им нужен крупный кадр В РАЗМЕТКЕ, а не в самой странице:
          в замере 01.08.2026 он утяжелил загрузку на мобильном с 1,74 до 2,63 с
          при бюджете 2,5. Крупный кадр отдаётся отдельным дериватом выше. */}
      <Image src={cover} alt={d.imageAlt ?? d.title} widths={[480, 800]}
             sizes="(max-width: 700px) 100vw, 700px" loading="lazy" formats={['webp']} />
      {coverNote && (
        <figcaption>
          {coverLink ? <a href={coverLink} rel="nofollow noopener" target="_blank">{coverNote}</a> : coverNote}
        </figcaption>
      )}
    </figure>
  )}

  <div class="nv-body"><Content /></div>

  {/* Разделители склеиваем без переносов строк: JSX сохраняет пробелы между
      выражениями, и «источник , источник» получает пробел перед запятой. */}
  <p class="nv-refs">
    {linkedCountries.length > 0 && (
      <span class="nv-refs-group">Разбор: {linkedCountries.map((s, i) => (
        <Fragment>{i > 0 ? ', ' : ''}<a href={`/visa/${s}/`}>{countryName(s)}</a></Fragment>
      ))}</span>
    )}
    <span class="nv-refs-group">Источник: {d.sources.map((src, i) => (
      <Fragment>{i > 0 ? ', ' : ''}<a href={src.url} rel="nofollow noopener" target="_blank">{src.name}</a></Fragment>
    ))}</span>
    <span class="nv-refs-group nv-checked">
      <a href="/about/">Никита Зайцев</a>, сверено {formatDateRu(d.checked)}
    </span>
  </p>

</li>

<style>
  /* Чернильная линейка отделяет записи, тонкая — блоки внутри записи. Разный вес
     линии задаёт структуру без единого нового элемента. Токен объявляем локально,
     как это уже сделано в двух других компонентах: глобального такого нет, и
     задуманная граница молча рисовалась бледной. */
  .nv-item { --line-strong: #15171a;
             border-top: 1px solid var(--line-strong); padding: 2rem 0 2.25rem; scroll-margin-top: 80px; }

  /* Строка над заголовком: без капса — он выпилен по всему сайту 06.07.2026.
     Дата моноширинной с табличными цифрами, чтобы столбик дат не плясал. */
  .nv-meta { display: flex; flex-wrap: wrap; gap: .5rem .9rem; align-items: baseline;
             font-size: .78rem; color: var(--text-faint); margin-bottom: .55rem; }
  .nv-meta time { font-family: var(--ff-mono); font-variant-numeric: tabular-nums; }
  .nv-impact { color: var(--gold); font-weight: 700; }
  .nv-status { color: var(--text-dim); font-size: .8rem; }

  /* Заголовок крупнее: при прежних 1.2rem контраст к тексту был 1.2×, и лента
     читалась одним длинным абзацем — глазу не за что зацепиться при прокрутке. */
  .nv-title { font-size: clamp(1.35rem, 2.2vw, 1.55rem); line-height: 1.22;
              letter-spacing: -.01em; margin: 0 0 .6rem; scroll-margin-top: 80px; }
  /* Заголовок ведёт на свою страницу заметки. Подчёркивание появляется по
     наведению: в ленте двадцать заголовков подряд, и постоянная золотая линия
     под каждым превращает список в частокол. */
  .nv-title a { color: inherit; text-decoration: none; }
  .nv-title a:hover { text-decoration: underline 1px var(--gold); text-underline-offset: .22em; }

  /* Капсула-ответ. Золотая линия слева отделяет ответ от контекста —
     глаз видит границу без второго шрифта и без заливки. */
  .nv-tldr {
    max-width: 62ch; line-height: 1.6; margin: 0 0 .9rem;
    padding-left: .9rem; border-left: 3px solid var(--gold);
  }

  /* Картинка после капсулы, а не перед: сначала ответ, потом иллюстрация.
     Одна пропорция на все кадры. Со стока приходят и 1600×1067, и 1600×1200 —
     вертикальный ритм скакал на каждой заметке. Заодно сдвиг макета нулевой по
     построению, и пропорция совпадает с той, что просит Discover. */
  .nv-fig { margin: 0 0 .9rem; }
  /* ⛔ height: auto обязателен. Без него высоту диктует атрибут height самого
     тега, а `aspect-ratio` молча не применяется: в замере 01.08.2026 кадр был
     748×1067 при объявленных 16/9. */
  .nv-fig :global(img) { width: 100%; height: auto; aspect-ratio: 16 / 9;
                         object-fit: cover; display: block; }
  .nv-fig figcaption { font-size: .74rem; color: var(--text-faint); margin-top: .35rem; }
  .nv-body { max-width: 62ch; line-height: 1.6; }
  .nv-body :global(p) { margin: 0 0 .7rem; }
  .nv-body :global(a) { color: var(--text); text-decoration: underline 1px var(--gold); text-underline-offset: .22em; }
  .nv-body :global(a:hover) { color: var(--gold); }

  .nv-refs { display: flex; flex-wrap: wrap; gap: .3rem 1.4rem; font-size: .85rem;
             color: var(--text-dim); margin: 0; }
  .nv-refs a { color: var(--text); text-decoration: underline 1px var(--gold); text-underline-offset: .22em; }
  .nv-refs a:hover { color: var(--gold); }
  .nv-checked { color: var(--text-faint); }

  @media (max-width: 700px) {
    .nv-refs { flex-direction: column; gap: .25rem; }
  }
</style>
