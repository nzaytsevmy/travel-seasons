---
// «Хочу сюда» — сохраняет направление (+ месяц, если известен со страницы)
// в localStorage (tt_trip), чтобы собрать дашборд на /my/. Без бэкенда,
// без аккаунта — честно: хранится только в этом браузере.
interface Props {
  slug: string;
  nom: string;
  monthIdx?: number | null;
}
const { slug, nom, monthIdx = null } = Astro.props;
---
<div class="tsb-wrap">
  <button type="button" class="tsb" data-slug={slug} data-month={monthIdx ?? ''} data-nom={nom}>
    <span class="tsb-txt">Хочу сюда</span>
  </button>
  <a href="/my/" class="tsb-open" hidden>Открыть мою поездку</a>
</div>

<script>
  function initTsb(wrap: HTMLElement) {
    const btn = wrap.querySelector<HTMLButtonElement>('.tsb');
    const open = wrap.querySelector<HTMLAnchorElement>('.tsb-open');
    if (!btn) return;
    const slug = btn.dataset.slug || '';
    const monthIdx = btn.dataset.month ? Number(btn.dataset.month) : null;
    const nom = btn.dataset.nom || '';
    const txt = btn.querySelector<HTMLElement>('.tsb-txt');

    const MAX = 5;

    // Раньше хранилась ОДНА поездка скаляром в tt_trip, и вторая страна молча
    // затирала первую. Теперь список в tt_trips, свежие первыми. Старый ключ
    // читаем при первом запуске и продолжаем писать первой поездкой: у человека
    // может быть открыта закэшированная страница прошлой сборки, которая знает
    // только tt_trip.
    function all(): any[] {
      try {
        const raw = localStorage.getItem('tt_trips');
        if (raw) { const a = JSON.parse(raw); if (Array.isArray(a)) return a; }
      } catch {}
      try {
        const one = JSON.parse(localStorage.getItem('tt_trip') || 'null');
        if (one && one.slug) { save([one]); return [one]; }
      } catch {}
      return [];
    }
    function save(list: any[]) {
      const cut = list.slice(0, MAX);
      try { localStorage.setItem('tt_trips', JSON.stringify(cut)); } catch {}
      try {
        if (cut.length) localStorage.setItem('tt_trip', JSON.stringify(cut[0]));
        else localStorage.removeItem('tt_trip');
      } catch {}
    }
    function current(): any {
      return all().find((t) => t && t.slug === slug) || null;
    }
    function refresh() {
      const list = all();
      const saved = list.some((x) => x && x.slug === slug);
      const t = list[0] || null;
      if (txt) txt.textContent = saved ? 'Убрать из планов' : 'Хочу сюда';
      btn.classList.toggle('is-saved', saved);
      // Ссылку на дашборд показываем, если сохранено ХОТЬ ЧТО-ТО, а не только эта
      // страна. Иначе человек, сохранивший Перу и ушедший читать про Грузию,
      // вернуться к своей поездке не может: других ссылок на /my/ на сайте нет —
      // ни в шапке, ни в подвале (проверено по dist 30.07.2026: ноль видимых).
      if (open) {
        open.hidden = !t;
        open.textContent = saved ? 'Открыть мою поездку' : 'Моя поездка: ' + (t && t.nom ? t.nom : 'открыть');
      }
    }
    btn.addEventListener('click', () => {
      const list = all();
      const i = list.findIndex((x) => x && x.slug === slug);
      if (i >= 0) list.splice(i, 1);
      else list.unshift({ slug, nom, monthIdx, days: 7, people: 1, savedAt: Date.now() });
      save(list);
      refresh();
    });
    refresh();
  }
  document.querySelectorAll<HTMLElement>('.tsb-wrap').forEach(initTsb);
</script>

<style>
.tsb-wrap { display: flex; flex-wrap: wrap; align-items: center; gap: .3rem 1rem; }
.tsb {
  display: inline-flex;
  align-items: center;
  min-height: 44px;
  padding: .4rem 0;
  background: none;
  border: none;
  cursor: pointer;
  font-family: var(--ff-display);
  font-size: .92rem;
  font-weight: 700;
  color: var(--gold);
  text-align: left;
  text-decoration: underline 1px color-mix(in srgb, var(--gold) 55%, transparent);
  text-underline-offset: 0.22em;
  text-decoration-skip-ink: auto;
}
.tsb:hover { color: var(--gold-dim); }
.tsb:focus-visible { outline: 2px solid var(--gold); outline-offset: 3px; }
.tsb.is-saved { color: var(--text-dim); text-decoration: none; }
.tsb-open {
  display: inline-flex; align-items: center; min-height: 44px;
  font-size: .84rem; font-weight: 600; color: var(--text-dim);
  text-decoration: underline 1px; text-underline-offset: 0.22em; text-decoration-skip-ink: auto;
}
.tsb-open[hidden] { display: none; }
.tsb-open:hover { color: var(--gold); }
</style>
