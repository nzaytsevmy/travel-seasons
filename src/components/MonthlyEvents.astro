---
// MonthlyEvents — события по месяцам: месяц один раз, под ним события, без линеек между строками
// и без подписи у каждого поля (пометка Никиты 10.09.2026: «Слишком много линий… не делать такие повторения»).
// Эталон: ~/Downloads/tt-home-1-editorial.html (shead + dash-таблица).

import { getHolidays } from '../data/country-holidays.js';
import { typo } from '../utils/typo.js';
import { plural } from '../data/plural.js';

interface Props {
  slug: string;
  countryNom?: string;
  countryNameVp?: string;
}
const { slug, countryNom, countryNameVp } = Astro.props;
const events = getHolidays(slug);
if (!events.length) return null as any;

const MONTH_RU = ['Январь','Февраль','Март','Апрель','Май','Июнь',
                  'Июль','Август','Сентябрь','Октябрь','Ноябрь','Декабрь'];

const byMonth: Record<number, any[]> = {};
for (const ev of events) {
  if (!byMonth[ev.month]) byMonth[ev.month] = [];
  byMonth[ev.month].push(ev);
}
const months = Object.keys(byMonth).map(Number).sort((a, b) => a - b);

const TAG_LABEL: Record<string, string> = {
  closed: 'выходные',
  fest: 'фестиваль',
  culture: 'сезонное'
};
const closedCount = events.filter(e => e.tag === 'closed').length;
---

<section class="me" aria-label={`Праздники и события — ${countryNom || slug}`}>
  <header class="me-h">
    <h2 class="me-t">События по месяцам{countryNom ? ` — ${countryNom}` : ''}</h2>
  </header>
  <p class="me-s">
    Когда страна гуляет, когда стоит и когда смотреть на сезонное явление.
    {closedCount > 0 && <> <b>{closedCount}</b> {plural(closedCount, 'дата', 'даты', 'дат')}, когда многое закрыто и цены растут.</>}
  </p>

  <div class="me-list">
    {months.map((m) => (
      <div class="me-month">
        <p class="me-mname">{MONTH_RU[m - 1]}</p>
        <div class="me-evs">
          {byMonth[m].map((ev) => (
            <div class={`me-ev me-ev--${ev.tag}`}>
              <p class="me-ehead">
                <b class="me-ename">{typo(ev.name)}</b>
                {ev.dates && <span class="me-edates"> · {typo(ev.dates)}</span>}
              </p>
              {ev.note && <p class="me-enote">{typo(ev.note)}</p>}
              <p class="me-tag">{TAG_LABEL[ev.tag] || ev.tag}</p>
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>
  <p class="me-more"><a href="/events/">Праздники и фестивали по всем странам</a></p>
</section>

<style>
.me {
  padding: 56px 0;
  font-variant-numeric: tabular-nums lining-nums;
}
.me-h { margin: 0 0 8px; }
.me-t { margin: 0; }
.me-s { font-size: .9375rem; line-height: 1.55; color: var(--text-dim); margin: 0 0 24px; max-width: 64ch; }
.me-s b { color: var(--gold); font-weight: 700; }
.me-list { display: flex; flex-direction: column; gap: 22px; }
.me-month { display: grid; grid-template-columns: 8rem minmax(0, 1fr); gap: 6px 24px; }
.me-mname { margin: 0; padding-top: 2px; font-size: .8125rem; font-weight: 600; letter-spacing: .04em; text-transform: uppercase; color: var(--gold); }
.me-evs { display: flex; flex-direction: column; gap: 14px; }
.me-ev p { margin: 0; }
.me-ehead { line-height: 1.45; }
.me-ename { font-weight: 700; color: var(--text); }
.me-edates { font-size: .9375rem; color: var(--text-dim); }
.me-ev .me-enote { margin-top: 2px; font-size: .9375rem; line-height: 1.55; color: var(--text-dim); max-width: 64ch; }
.me-ev .me-tag { margin-top: 4px; font-size: .75rem; font-weight: 600; letter-spacing: .04em; text-transform: uppercase; color: var(--text-faint); }
.me-ev--closed .me-tag { color: var(--gold); }
.me-more { margin: 24px 0 0; font-size: .9375rem; }
.me-more a { color: var(--gold); font-weight: 600; text-decoration: underline; text-underline-offset: .22em; }
@media (max-width: 760px) {
  .me { padding: 40px 0; }
  .me-month { grid-template-columns: 1fr; }
}
</style>
