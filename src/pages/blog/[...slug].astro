<style>
/* TJ-style: cover full-bleed, текст 720px по центру, широкие figures внутри текста */
.post-page { padding-bottom: 5rem; }

.post-cover {
  position: relative;
  width: 100%;
  height: clamp(360px, 56dvh, 620px);
  overflow: hidden;
  margin-bottom: 0;
}
/* Телефон: обложка в 56dvh выталкивала H1 и дату за первый экран — человек из
   поиска видел только фото и крошки (проход руками 12.08.2026, скрин @402).
   30dvh оставляет фото узнаваемым, а заголовок, дату и начало ответа — видимыми
   без скролла. Десктоп не трогаем. */
@media (max-width: 767px) {
  .post-cover { height: clamp(200px, 30dvh, 320px); }
}
.post-cover picture { width: 100%; height: 100%; display: block; }
.post-cover img { width: 100%; height: 100%; object-fit: cover; display: block; }
.cover-overlay { position: absolute; inset: 0; background: linear-gradient(to bottom, transparent 40%, var(--bg) 100%); }

.post-content {
  max-width: 720px;
  margin: 0 auto;
  padding: 2.4rem 1.4rem 0;
  overflow-wrap: break-word;
  /* Custom property для full-bleed элементов внутри (figure-wide,
     table-wide, pricing-cards). Безопасно в Safari/Chrome/Firefox 2026. */
  --bleed: max((100vw - 720px) / 2 - 1.4rem, 0px);
}

/* Inline figures внутри статьи: full-bleed при class="figure-wide".
   Используем CSS custom property --bleed (определена в .post-content) —
   надёжный pattern для Safari/Chrome/Firefox без transform-hacks. */
.prose :is(figure, img).figure-wide,
.prose :is(figure, img).full-bleed {
  margin-left: calc(-1 * min(var(--bleed), 240px));
  margin-right: calc(-1 * min(var(--bleed), 240px));
  width: auto;
  max-width: calc(100% + 2 * min(var(--bleed), 240px));
  margin-top: 2rem;
  margin-bottom: 2rem;
  border-radius: 8px;
  overflow: hidden;
}
.prose figure.figure-wide img,
.prose figure.full-bleed img { width: 100%; height: auto; display: block; border-radius: 0; }
.prose figure.figure-wide figcaption,
.prose figure.full-bleed figcaption {
  padding: 0.6rem 0.2rem 0;
  font-size: 0.85rem;
  color: var(--text-faint);
  text-align: center;
}

/* PricingCards: full-bleed через --bleed (без transform). Лимит 190px
   с каждой стороны = max 1100px на десктопе при 720px text. */
.prose :global(.pricing-cards) {
  margin-left: calc(-1 * min(var(--bleed), 190px));
  margin-right: calc(-1 * min(var(--bleed), 190px));
  margin-top: 2rem;
  margin-bottom: 2.5rem;
}

/* Wide-таблицы (4+ колонок): на телефоне карточками, на компьютере таблицей.
   ⛔ Раньше их держали строго в ширине текста, а не влезшие отдавали боковому
   пролистыванию. Замер 23.08.2026 показал, чем это оборачивалось: трём таблицам
   не хватало 82–278px, и ни у одной первая колонка не закреплялась — уехав
   вправо, читатель видел числа без подписи строки. Признака, что справа есть
   продолжение, тоже не было: таблица выглядела просто обрезанной.
   Теперь они расширяются в поля до 190px с каждой стороны — тот же приём и тот
   же лимит, что у карточек цен. Больше не берём намеренно: таблица, которая
   заметно шире текста, рвёт ритм чтения. */
.prose :global(.table-wrap.table-wide) {
  width: auto;
  max-width: calc(100% + 2 * min(var(--bleed), 190px));
  margin-left: calc(-1 * min(var(--bleed), 190px));
  margin-right: calc(-1 * min(var(--bleed), 190px));
  font-size: 0.88rem;
  margin-top: 2rem;
  margin-bottom: 2rem;
}
/* Что делать, если таблица не влезла даже в поля: пролистывание остаётся, но
   оно должно быть честным — первая колонка держится на месте, чтобы значения
   не отрывались от подписи строки, а тень у её края показывает, что справа
   есть ещё данные. Требование из разборов адаптивных таблиц у Nielsen Norman
   Group и Smashing Magazine. */
@media (min-width: 721px) {
  .prose :global(.table-wrap.table-wide tbody td:first-child),
  .prose :global(.table-wrap.table-wide thead th:first-child) {
    position: sticky;
    left: 0;
    z-index: 2;
    background: var(--bg);
  }
}
/* Узкий ноутбук: полей по бокам мало, и таблице с длинными ячейками не хватает
   считанных пикселей. У четырёх колонок на боковые отступы уходит около 110px —
   ужимаем их, и таблица влезает целиком вместо пролистывания ради 19px. */
@media (min-width: 721px) and (max-width: 1100px) {
  .prose :global(.table-wrap.table-wide :is(th, td)) {
    padding-left: 0.5rem;
    padding-right: 0.5rem;
  }
}
/* Признак продолжения справа — чистым CSS, без скрипта. Два слоя фона: белые
   «заглушки» приклеены к краям (background-attachment: local, едут вместе с
   содержимым), тени приклеены к самой обёртке (scroll — стоят на месте). Пока
   прокручивать нечего, заглушка закрывает тень; появилась прокрутка — тень
   выходит из-под неё. Приём известен как CSS-only scroll shadows.
   ⛔ Работает только при непрозрачном фоне: значение --bg должно совпадать
   с фоном страницы, иначе по краям таблицы появится светлая полоса. */
.prose :global(.table-wrap.table-wide) {
  background:
    linear-gradient(to right, var(--bg) 30%, rgba(0, 0, 0, 0)) left center,
    linear-gradient(to left, var(--bg) 30%, rgba(0, 0, 0, 0)) right center,
    radial-gradient(farthest-side at 0 50%, rgba(0, 0, 0, 0.18), rgba(0, 0, 0, 0)) left center,
    radial-gradient(farthest-side at 100% 50%, rgba(0, 0, 0, 0.18), rgba(0, 0, 0, 0)) right center;
  background-repeat: no-repeat;
  background-size: 40px 100%, 40px 100%, 14px 100%, 14px 100%;
  background-attachment: local, local, scroll, scroll;
}
@media (max-width: 720px) {
  /* Editorial stacked pattern (как FlightRoutes): первая колонка = серифный
     заголовок Newsreader, остальные колонки — compact rows с тонким uppercase
     label сверху, золотой bullet слева. Без рамок и backgrounds — никаких
     «карточек». */
  .prose :global(.table-wrap.table-wide table),
  .prose :global(.table-wrap.table-wide thead),
  .prose :global(.table-wrap.table-wide tbody),
  .prose :global(.table-wrap.table-wide tr),
  .prose :global(.table-wrap.table-wide th),
  .prose :global(.table-wrap.table-wide td) {
    display: block;
  }
  .prose :global(.table-wrap.table-wide thead) {
    position: absolute;
    top: -9999px;
    left: -9999px;
  }
  /* ⛔ Глобальные правила узкой таблицы (global.css, ≤720px) закрепляют первую
     колонку для горизонтальной прокрутки: sticky + max-width 9rem + тень справа.
     В карточном режиме прокрутки нет, и эти правила ломают вид: заголовок сжат
     до 144px и рвётся на три строки, а тень читается как вертикальная линия
     посреди текста. Отменяем их — здесь первая ячейка это заголовок карточки. */
  .prose :global(.table-wrap.table-wide tbody td:first-child),
  .prose :global(.table-wrap.table-wide thead th:first-child) {
    position: static;
    min-width: 0;
    max-width: none;
    box-shadow: none;
    background: transparent;
  }
  .prose :global(.table-wrap.table-wide :is(th, td)) {
    min-width: 0;
  }
  /* Прокрутки в карточном режиме нет — обёртка не должна её обещать */
  .prose :global(.table-wrap.table-wide) {
    overflow-x: visible;
  }
  .prose :global(.table-wrap.table-wide tbody) {
    border-top: 1px solid var(--line);
  }
  .prose :global(.table-wrap.table-wide tr) {
    padding: 1.4rem 0 1.2rem;
    border-bottom: 1px solid var(--line);
    background: transparent;
  }
  .prose :global(.table-wrap.table-wide tr:last-child) {
    border-bottom: none;
  }
  /* Первая колонка — серифный заголовок Newsreader, как в FlightRoutes */
  .prose :global(.table-wrap.table-wide tbody td:first-child) {
    font-family: var(--ff-display, 'Golos Text Variable', Helvetica, Arial, sans-serif);
    font-size: 1.35rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.2;
    color: var(--text);
    margin-bottom: 0.85rem;
    padding: 0;
  }
  .prose :global(.table-wrap.table-wide tbody td:first-child::before) {
    content: none;
  }
  /* Остальные колонки — золотой bullet, тихий uppercase label сверху, текст ниже */
  .prose :global(.table-wrap.table-wide tbody td:not(:first-child)) {
    padding: 0 0 0 0.9rem;
    margin-top: 0.55rem;
    border: none;
    font-size: 0.95rem;
    color: var(--text);
    line-height: 1.5;
    position: relative;
  }
  /* Подпись и значение в одну строку: столбиком каждая пара занимала две
     строки, и таблица из четырёх позиций уходила на полтора экрана. Флекс с
     переносом — длинное значение всё равно упадёт под подпись, короткое
     встанет рядом. */
  .prose :global(.table-wrap.table-wide tbody td:not(:first-child)) {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: 0.5rem;
    row-gap: 0.1rem;
  }
  .prose :global(.table-wrap.table-wide tbody td:not(:first-child))::before {
    content: attr(data-label);
    flex: 0 0 auto;
    font-size: 0.62rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-faint);
    padding-left: 0;
  }
  .prose :global(.table-wrap.table-wide tbody td:not(:first-child))::after {
    /* Золотой bullet слева */
    content: "";
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--gold-dim, #1d40ae);
    opacity: 0.55;
  }
}

