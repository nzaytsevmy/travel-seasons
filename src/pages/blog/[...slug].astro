---
import { getCollection, getEntry } from 'astro:content';
import { Image, Picture, getImage } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Footer from '../../components/Footer.astro';
import TableOfContents from '../../components/post/TableOfContents.astro';
import authorPhoto from '../../assets/author/nikita.jpg';
import { DIRECTIONS } from '../../data/directions.js';
import { directionForTags } from '../../data/article-country.js';
import { EXPENSIVE_DESTINATIONS } from '../../data/monetization.js';
import { aviasalesRoute, youtravelCountry } from '../../data/affiliate.js';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(p => ({ params: { slug: p.slug }, props: { post: p } }));
}

const { post } = Astro.props;
const { Content, headings } = await post.render();
const url = `https://traveltribe.ru/blog/${post.slug}/`;
const coverUrl = typeof post.data.coverImage === 'string' ? post.data.coverImage : `https://traveltribe.ru${post.data.coverImage.src}`;

// Preload hero cover для LCP <2.5s: АДАПТИВНЫЙ srcset, точно совпадающий с <Picture>
// ниже (те же widths/sizes/format/quality), чтобы preload попал ровно в тот вариант,
// который браузер реально выберет. Раньше preload был фиксированный 640px по
// предположению «Picture возьмёт 640 на mobile» — но на mobile-эмуляции Lighthouse
// (высокий DPR, 100vw) браузер берёт 960/1280, а preload грузил 640 → мимо кэша,
// LCP-картинка качалась отдельным поздним запросом (japan-guide держался на грани 0.85).
const heroPreload = typeof post.data.coverImage === 'string' ? null : await getImage({
  src: post.data.coverImage,
  widths: [640, 960, 1280],
  format: 'webp',
  quality: 65,
});
const ogImageUrl = `https://traveltribe.ru/og/${post.slug}.png`;
const wordCount = post.body.trim().split(/\s+/).length;

// Журнал проверок. Дата обновления считается ИЗ НЕГО, а не хранится отдельно:
// поле, которое нечем сверить, соблазняет подкрутить дату без правок, а это
// прямо запрещено и нам, и поиском. Есть журнал — дата равна последней сверке;
// нет журнала — прежнее поведение, чтобы 67 старых статей не поехали.
const checks = [...(post.data.checks ?? [])].sort((a, b) => a.date.valueOf() - b.date.valueOf());
const lastCheck = checks.at(-1) ?? null;
const shownUpdated = lastCheck?.date ?? post.data.updatedDate ?? null;
const dateRu = (d: Date) => d.toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' }).replace(' г.', '');
// Наверх идёт только суть — первое предложение записи. Полный текст остаётся в
// журнале: строка над заголовком раздела не должна отодвигать ответ, ради
// которого пришли из поиска (первая версия заняла шесть строк на телефоне).
const checkedShort = lastCheck
  ? (lastCheck.changed.split(/(?<=\.)\s/)[0] ?? lastCheck.changed).replace(/\s+$/, '')
  : null;

function stripMd(s: string): string {
  return s
    .replace(/!\[[^\]]*\]\([^)]+\)/g, '')
    .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')
    .replace(/\*\*([^*]+)\*\*/g, '$1')
    .replace(/\*([^*]+)\*/g, '$1')
    .replace(/`([^`]+)`/g, '$1')
    .replace(/\s+/g, ' ')
    .trim();
}

function extractFAQs(body: string): Array<{ q: string; a: string }> {
  // ⛔ `|$` обязателен. Без него совпадению нужен следующий заголовок или
  // разделитель после секции вопросов, и когда «## FAQ» — последняя секция
  // статьи, разметка молча оказывается пустой. Аккордеон при этом рисуется:
  // у него терминатора нет. Так потерялись 22 вопроса в статьях про Перу,
  // Чили и Боливию — видимые вопросы есть, для поиска их нет.
  const sectionMatch = body.match(/\n##\s+[^\n]*FAQ[^\n]*\n([\s\S]*?)(?=\n##\s|\n---\s*\n|$)/);
  if (!sectionMatch) return [];
  const block = sectionMatch[1];

  const h3Count = (block.match(/^###\s+/gm) || []).length;
  const boldCount = (block.match(/^\*\*[^\n*]+\*\*\s*$/gm) || []).length;

  let mode: 'h3' | 'bold' | null = null;
  if (h3Count >= 2) mode = 'h3';
  else if (boldCount >= 2) mode = 'bold';
  else return [];

  const matchQ = (line: string): string | null => {
    if (mode === 'h3') {
      const m = line.match(/^###\s+(.+?)\s*$/);
      return m ? m[1].trim() : null;
    }
    const m = line.match(/^\*\*([^\n*]+?)\*\*\s*$/);
    return m ? m[1].trim() : null;
  };

  const groups: Array<{ q: string; a: string[] }> = [];
  let current: { q: string; a: string[] } | null = null;
  for (const line of block.split('\n')) {
    const q = matchQ(line);
    if (q) {
      if (current) groups.push(current);
      current = { q, a: [] };
    } else if (current) {
      current.a.push(line);
    }
  }
  if (current) groups.push(current);

  return groups
    .map(g => ({
      q: g.q.replace(/\?*$/, '?').replace(/\?+/, '?'),
      a: stripMd(g.a.join('\n').trim())
    }))
    .filter(g => g.q && g.a);
}

const faqs = extractFAQs(post.body);

// «Куда дальше» — ведёт читателя из поста в конвертящие узлы (packing-чеклист,
// калькулятор) и связывает pillar↔visa↔хаб → глубина/dwell (вес Яндекса).
// Страну поста выводим из RELATED_POSTS. Раньше условие было «пост стоит ПЕРВЫМ
// в списке кластера», и 13 статей, стоящих вторыми и ниже, получали общий блок
// вместо своего, а заодно теряли список соседей по теме (он строится из того же
// направления). У страницы про загранпаспорт в Абхазию из-за этого было 15
// внутренних ссылок против 27 у соседней статьи того же кластера — замер 04.08.2026.
//
// ⛔ Бланкетно «любой пост из списка» чинить нельзя: 9 статей (оплата за границей,
// eSIM, «сколько стоит неделя») входят сразу в несколько кластеров, и страновой
// блок был бы для них враньём — им общий блок положен по делу.
// Правило: сначала кластер, где пост стоит первым (его «дом»), иначе — кластер,
// если он ровно один. Пост из нескольких кластеров остаётся с общим блоком.
const ownDirs = DIRECTIONS.filter(d => d.relatedPosts?.some(p => p.slug === post.slug));
// Третьим заходом — метки статьи. Замер 13.08.2026: по кластерам направление
// находилось у 42 статей из 66, остальные 24 получали общий блок «Куда дальше»
// со ссылкой на список стран вместо своей страны (в том числе Гагра, Рица,
// пещера — где страна очевидна). По меткам добирается 10 из этих 24.
const primaryDir = DIRECTIONS.find(d => d.relatedPosts?.[0]?.slug === post.slug)
  ?? (ownDirs.length === 1 ? ownDirs[0] : null)
  ?? directionForTags(post.data.tags || []);
// У этих материалов намеренно несколько стран или весь рынок. Подставлять в
// партнёрскую форму одну страну из навигационного кластера было бы скрытой
// подменой обещания CTA, поэтому денежный контекст оставляем без destination.
const MULTI_DESTINATION_POSTS = new Set([
  'luchshie-goroda-dlya-molodyh-2026',
  'novyy-god-2027-kuda-poehat',
  'patagonia-2026',
  'safari-afrika-2026',
  'schengen-insurance-2026',
  'schengen-visa-2026',
  'skolko-stoit-nedelya-v-rossii-2026',
  'travelata-2026',
]);
const monetizationDestination = MULTI_DESTINATION_POSTS.has(post.slug) ? '' : primaryDir?.slug;

// Дорогие направления: первой денежной точкой идёт дорога или готовый тур, а не полис.
// Решение Никиты 04.09.2026 по замеру 06.08–02.09: такие страницы доводят до партнёра
// 4,7 визита из ста против 1,6 у страниц сборов, а единственная крупная комиссия сайта
// пришла с билета со страницы Галапагосов. Ставится шаблоном, а не в тексте статей:
// одна правка вместо тринадцати, все страницы переключаются одним днём (иначе замер
// размазывается по датам), тексты и даты обновления статей не трогаются, откат — одна строка.
const expensive = EXPENSIVE_DESTINATIONS[post.slug] ?? null;
const expensiveMoney = expensive ? {
  flight: aviasalesRoute('MOW', expensive.iata, `${post.slug}_top`),
  city: expensive.city,
  // Тура нет у партнёра — строка идёт без него: общий каталог вместо страны это
  // холодный клик, который канон монетизации запрещает выдавать за диплинк.
  tour: expensive.tour ? youtravelCountry(expensive.tour, `${post.slug}_top`) : null,
  label: expensive.label,
} : null;
// Хлебные крошки. Было «Главная / Блог / <весь заголовок>»: страны в цепочке
// нет, последнее звено переносится на три строки на телефоне. Стало
// «Главная / Блог / Япония / Виза» — четыре звена, это в границах требований
// Яндекса (2–4), страна кликабельна и ведёт на свой раздел.
const THEME: Array<[RegExp, string]> = [
  [/страховк/i, 'Страховка'],
  [/виза|документ|загранпаспорт/i, 'Виза'],
  [/сезон|событ|погода/i, 'Сезоны'],
  [/сбор|чек-лист|что взять/i, 'Сборы'],
  [/деньг|карт|платеж/i, 'Деньги'],
];
const tagsLower = (post.data.tags || []).map((t: string) => String(t).toLowerCase()).join(' ');
// Слаг сильнее меток: у гайда по Австралии есть метка «Виза», и по меткам он
// получал тему «Виза», хотя это гайд по стране.
const SLUG_THEME: Array<[RegExp, string]> = [
  [/-guide-/, 'Гайд'], [/-visa-|zagranpasport/, 'Виза'],
  [/insurance|strahovka/, 'Страховка'], [/pay-|cards/, 'Деньги'],
];
const themeLabel = SLUG_THEME.find(([re]) => re.test(post.slug))?.[1]
  ?? THEME.find(([re]) => re.test(tagsLower))?.[1] ?? 'Гайд';
const crumbs = primaryDir
  ? [{ label: 'Блог', href: '/blog/' },
     { label: primaryDir.region.split(/[&(,—-]/)[0].trim(), href: `/${primaryDir.slug}/` },
     { label: themeLabel }]
  : [{ label: 'Блог', href: '/blog/' }, { label: post.data.title }];

const planVP = primaryDir ? (primaryDir.cases?.vP || primaryDir.cases?.acc || primaryDir.cases?.nom) : null;
const siblingPosts = primaryDir ? primaryDir.relatedPosts.filter(p => p.slug !== post.slug).slice(0, 3) : [];

const ldJson: any = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BlogPosting",
      "@id": `${url}#article`,
      "isPartOf": { "@id": "https://traveltribe.ru/blog/#blog" },
      "headline": post.data.title,
      "description": post.data.description,
      "image": coverUrl,
      "author": { "@id": "https://traveltribe.ru/about/#person" },
      "datePublished": post.data.pubDate.toISOString(),
      "dateModified": (shownUpdated ?? post.data.pubDate).toISOString(),
      "publisher": { "@id": "https://traveltribe.ru/#org" },
      "mainEntityOfPage": { "@type": "WebPage", "@id": url },
      "inLanguage": "ru-RU",
      "wordCount": wordCount,
      "articleSection": post.data.tags[0] ?? "Travel",
      "keywords": post.data.tags.join(', '),
      "speakable": { "@type": "SpeakableSpecification", "cssSelector": ["h1", ".prose blockquote:first-of-type", ".prose p:first-of-type"] },
      ...(post.data.tripPlace ? { "contentLocation": { "@type": "Place", "name": post.data.tripPlace } } : {}),
      ...(post.data.tripDate ? { "dateCreated": post.data.tripDate } : {})
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Главная", "item": "https://traveltribe.ru/" },
        // Разметка строится из ТЕХ ЖЕ крошек, что видит читатель: расхождение
        // видимой цепочки и разметки поисковики считают сигналом рассинхрона.
        ...crumbs.map((c, i) => ({
          "@type": "ListItem", "position": i + 2, "name": c.label,
          "item": c.href ? `https://traveltribe.ru${c.href}` : url,
        }))
      ]
    }
  ]
};

if (faqs.length >= 2) {
  ldJson["@graph"].push({
    "@type": "FAQPage",
    "@id": `${url}#faq`,
    "mainEntity": faqs.map(f => ({
      "@type": "Question",
      "name": f.q,
      "acceptedAnswer": { "@type": "Answer", "text": f.a }
    }))
  });
}

// HowTo-schema НЕ эмитим: Google убрал HowTo из rich-результатов (сентябрь 2023),
// а без видимого пошагового блока на странице это schema-без-контента = спам-сигнал
// (CLAUDE.md). Данные howto оставлены в frontmatter под будущий видимый блок.
---
<Layout
  title={post.data.title}
  description={post.data.description}
  canonical={url}
  ogType="article"
  ogTitle={post.data.title}
  ogDescription={post.data.description}
  ogImage={ogImageUrl}
  ogImageAlt={post.data.coverAlt ?? post.data.title}
  ldJson={ldJson}
  preloadImageSrcset={heroPreload?.srcSet.attribute}
  preloadImageSizes="100vw"
  monetizationDestination={monetizationDestination}
>
  <script is:inline>document.body.classList.add('post-page')</script>
  <Breadcrumbs crumbs={crumbs} />
  <main id="main" class="post-page">
    <div class="post-cover">
      <Picture
        src={post.data.coverImage}
        alt={post.data.coverAlt ?? post.data.title}
        widths={[640, 960, 1280]}
        sizes="100vw"
        formats={['webp']}
        fallbackFormat="jpg"
        quality={65}
        loading="eager"
        fetchpriority="high"
        pictureAttributes={{ style: `display:block;` }}
        style={`object-position: ${post.data.coverPosition};`}
      />
      <div class="cover-overlay"></div>
    </div>

    <article class="post-content">
      <div class="post-meta-top">
        <div class="post-tags">
          {post.data.tags.map(t => <a href={`/blog/tag/${t}/`} class="ptag">{t}</a>)}
        </div>
        <time class="post-date" datetime={post.data.pubDate.toISOString()}>
          {post.data.pubDate.toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' })}
        </time>
        {shownUpdated && shownUpdated.valueOf() !== post.data.pubDate.valueOf() && (
          <time class="post-updated" datetime={shownUpdated.toISOString()}>
            · обновлено {dateRu(shownUpdated)}
          </time>
        )}
      </div>

      <h1>{post.data.title}</h1>
      <p class="post-author">
        <a href="/about/" class="author-link">
          <Image src={authorPhoto} alt="Никита Зайцев" width={28} height={28} format="webp" quality={75} class="author-mini" />
          <span>Никита Зайцев</span>
        </a>
        · <a href="https://t.me/traveltriberu" target="_blank" rel="noopener">@traveltriberu</a>
      </p>

      {/* Строка последней сверки — вверху, а не только в журнале внизу: в ответы
          нейросетей попадает в основном верхняя треть страницы, и датированный
          факт должен быть там. Одна строка, ответ ради которого пришли, не
          отодвигает. */}
      {lastCheck && (
        <p class="post-checked">
          Сверено {dateRu(lastCheck.date)}: {checkedShort}
          {' '}<a href="#journal">как проверяли</a>
        </p>
      )}

      {post.data.tripDate && post.data.tripPlace && (
        <p class="trip-marker">
          <span class="trip-icon" aria-hidden="true">✓</span>
          Был лично — {post.data.tripPlace}, {post.data.tripDate}
        </p>
      )}

      {post.data.sourceType === 'compilation' && post.data.showSourceDisclaimer && (
        <aside class="source-disclaimer" role="note">
          <strong>Как написан этот пост.</strong>{' '}
          {post.data.sourceNote ? (
            post.data.sourceNote
          ) : (
            <>Это обзор по официальным источникам — сайтам консульств, статистике, форумам туристов. Лично эту визу/маршрут я в 2026 не оформлял, но сверил факты на актуальность. Если вы только что прошли — поправьте через <a href="https://t.me/traveltriberu" target="_blank" rel="noopener">Telegram-канал</a>, обновлю.</>
          )}
        </aside>
      )}

      {expensiveMoney && (
        <p class="post-first-money">
          Как туда попасть:{' '}
          <a href={expensiveMoney.flight} class="aff-cta" rel="sponsored">найти билет Москва — {expensiveMoney.city}</a>
          {expensiveMoney.tour && (
            <>{' · '}<a href={expensiveMoney.tour} class="aff-cta" rel="sponsored">посмотреть готовые туры {expensiveMoney.label}</a></>
          )}
        </p>
      )}

      <TableOfContents headings={headings} />

      <div class="prose">
        <Content />
      </div>

      {/* Подписка на канал. Ставится СРАЗУ после текста — в точке, где читатель
          получил обещанное и решает, уходить ли. Выше её ставить нельзя: она
          отодвинет ответ, ради которого пришли из поиска.
          Замер 13.08.2026: переходов в канал 7 за 30 дней при 6117 визитах
          (0,11%), при этом ссылок на канал на странице статьи было ВОСЕМЬ —
          в подписи автора, в справке об авторе, в подвале, в дисклеймере. То
          есть дело не в числе ссылок, а в том, что ни одна из них ничего не
          обещает: это голый ник. Здесь — одна ссылка с понятной причиной. */}
      <aside class="tg-sub">
        <p class="tg-sub-text">
          Пишу про поездки и правила въезда в Telegram — там короче и чаще, чем на сайте.
        </p>
        <a class="tg-sub-link" href="https://t.me/traveltriberu" target="_blank" rel="noopener">Читать @traveltriberu</a>
      </aside>

      {checks.length > 0 && (
        <section class="journal" id="journal" aria-labelledby="journal-title">
          <h2 class="journal-title" id="journal-title">Что и когда проверяли</h2>
          <ol class="journal-list">
            {[...checks].reverse().map((c) => (
              <li class="journal-item">
                <time class="journal-date" datetime={c.date.toISOString().slice(0, 10)}>{dateRu(c.date)}</time>
                <p class="journal-what">{c.what}</p>
                <p class="journal-changed">{c.changed}</p>
                <p class="journal-src">
                  Первоисточники: {c.sources.map((s, i) => (
                    <>{i > 0 && ', '}<a href={s.url} target="_blank" rel="noopener nofollow">{s.name}</a></>
                  ))}
                </p>
              </li>
            ))}
          </ol>
        </section>
      )}

      <nav class="post-next" aria-label="Куда дальше">
        {primaryDir ? (
          <>
            <h2 class="post-next-title">Спланировать поездку {planVP}</h2>
            <ul class="post-next-grid">
              <li><a href={`/packing/${primaryDir.slug}/`}><b>Чек-лист вещей в дорогу</b><span>Что взять по сезону и месяцам</span></a></li>
              <li><a href={`/visa/${primaryDir.slug}/`}><b>Виза и въезд для россиян</b><span>Нужна ли виза, сроки, документы</span></a></li>
              <li><a href={`/${primaryDir.slug}/`}><b>Когда ехать</b><span>Сезоны, погода и цены по месяцам</span></a></li>
              <li><a href="/calculator/"><b>Рассчитать бюджет</b><span>Перелёт, жильё и еда на поездку</span></a></li>
            </ul>
          </>
        ) : (
          <>
            <h2 class="post-next-title">Куда дальше</h2>
            <ul class="post-next-grid">
              <li><a href="/countries/"><b>Подобрать направление</b><span>Фильтр по визе, бюджету и сезону</span></a></li>
              <li><a href="/calculator/"><b>Рассчитать бюджет поездки</b><span>Перелёт, жильё и еда</span></a></li>
              <li><a href="/packing/"><b>Чек-листы вещей по странам</b><span>Что взять под погоду месяца</span></a></li>
            </ul>
          </>
        )}
        {siblingPosts.length > 0 && (
          <div class="post-next-read">
            <h3>Ещё по теме</h3>
            <ul>
              {siblingPosts.map(p => <li><a href={`/blog/${p.slug}/`}>{p.title}</a></li>)}
            </ul>
          </div>
        )}
      </nav>

      <aside class="author-bio" aria-label="Об авторе">
        <Image src={authorPhoto} alt="Никита Зайцев — автор TravelTribe" width={96} height={96} format="webp" quality={80} class="bio-avatar-img" />
        <div class="bio-text">
