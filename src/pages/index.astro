---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import HomeDestinationCard from '../components/HomeDestinationCard.astro';
import { Image, getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import { DIRECTIONS } from '../data/directions.js';
import { PRICES } from '../data/prices.js';
import { VISA_DETAILS } from '../data/visa-details.js';
import { ACTIVITY_TAGS } from '../data/country-activity-tags.js';
import { getBudgetRates } from '../utils/budget-rates.js';
import { homePhotoProvenance } from '../utils/home-photo-provenance.js';
import { formatRecommendationCount, createDestinationRows, homeCollections, moscowMonth, MONTHS_PREP, catalogHref  } from '../utils/destination-selection.js';
import { HOME_HERO, HOME_STORIES, HOME_STORY_PHOTOS, HOME_MOODS, countryPhotoSources, allocateHomePhotos } from '../data/home-journal.js';
import { COUNTRY_PHOTOS } from '../data/country-photos.js';
import { feedEntries, formatDateRu, newsUrl } from '../data/news.js';
import authorPhoto from '../assets/author/nikita.jpg';
import heroCover from '../assets/destinations/georgia.jpg';
const photoFiles = import.meta.glob('../content/blog/_images/**/*.{jpg,jpeg,webp}', { import: 'default' });
const rates = await getBudgetRates();
const rows = createDestinationRows(DIRECTIONS, PRICES, VISA_DETAILS, rates, ACTIVITY_TAGS);
const month = moscowMonth();
const state = { m: month, max_budget: 0, visa: 'any', vibe: '' };
const photoCache = new Map();
const photoHash = key => homePhotoProvenance(key).id;
async function preparePhoto(p, fallbackAlt = '') {
  const key = `src/content/blog/_images/${p.file}`;
  const metadata = await photoFiles[`../content/blog/_images/${p.file}`]?.();
  if (!metadata) throw new Error(`Кадр не найден: ${key}`);
  if (!photoCache.has(metadata.src)) {
    const image = await getImage({ src: metadata, widths: [256, 480, 960, 1200], format: 'webp', quality: 72 });
    photoCache.set(metadata.src, { id: await photoHash(key), key, src: image.src, srcset: image.srcSet.attribute, width: image.attributes.width, height: image.attributes.height });
  }
  return { ...photoCache.get(metadata.src), alt: p.alt || fallbackAlt, months: p.months || [], position: p.position || '50% 50%', mobilePosition: p.mobilePosition || '50% 45%' };
}
const pools = Object.fromEntries(await Promise.all(rows.map(async row => [row.slug, await Promise.all(countryPhotoSources(row.slug).map(p => preparePhoto(p, row.nom)))])));
async function prepareCroppedPhoto(p, ratio, cropPosition = 'centre') {
  const original = await preparePhoto(p);
  const metadata = await photoFiles[`../content/blog/_images/${p.file}`]();
  const image = await getImage({ src: metadata, width: 640, height: Math.round(640 / ratio), widths: [240, 480, 640], fit: 'cover', position: cropPosition, format: 'webp', quality: 76 });
  return { ...original, src: image.src, srcset: image.srcSet.attribute, width: image.attributes.width, height: image.attributes.height };
}
const moods = await Promise.all(HOME_MOODS.map(async mood => ({ ...mood,
  image: await prepareCroppedPhoto(mood.photo, .8, mood.vibe === 'nature' ? 'right' : 'centre'),
  mobile: await prepareCroppedPhoto(mood.photo, 1, mood.vibe === 'nature' ? 'right' : 'centre'),
})));
const featureSource = COUNTRY_PHOTOS.kenya.practice[1];
const featureBase = await preparePhoto(featureSource);
const featureImage = await getImage({ src: await photoFiles[`../content/blog/_images/${featureSource.file}`](), widths: [720, 1280, 1920], format: 'webp', quality: 76 });
const feature = { ...featureBase, src: featureImage.src, srcset: featureImage.srcSet.attribute, width: featureImage.attributes.width, height: featureImage.attributes.height };
const allPosts = await getCollection('blog');
const stories = HOME_STORIES.map(slug => {
  const post = allPosts.find(p => p.slug === slug);
  if (!post?.data.coverImage) throw new Error(`Нет существующей обложки: ${slug}`);
  return post;
});
const reserved = [await photoHash(HOME_HERO.key), feature.id, ...moods.map(m => m.image.id), ...await Promise.all(stories.map(p => photoHash(HOME_STORY_PHOTOS[p.slug])))];
const collections = allocateHomePhotos(homeCollections(rows, state), pools, reserved, month);
const freshNews = feedEntries(await getCollection('news'), 3);
const brandYear = new Date().getFullYear();
const desc = 'Куда и когда ехать, сколько стоит неделя: 70+ направлений, визы, сезоны и авторские гиды TravelTribe. Личные истории и фотографии из путешествий.';
const visible = [...new Map(Object.values(collections).flat().map(r => [r.slug, r])).values()];
const ldJson = { '@context': 'https://schema.org', '@graph': [
  { '@type': 'WebPage', '@id': 'https://traveltribe.ru/#webpage', url: 'https://traveltribe.ru/', name: `TravelTribe — куда поехать из России в ${brandYear}`, description: desc, isPartOf: { '@id': 'https://traveltribe.ru/#website' }, about: { '@id': 'https://traveltribe.ru/#org' }, inLanguage: 'ru-RU' },
  { '@type': 'ItemList', name: 'Направления на главной', itemListElement: visible.map((r, i) => ({ '@type': 'ListItem', position: i + 1, name: r.nom, url: `https://traveltribe.ru/${r.slug}/` })) },
] };
const clientData = JSON.stringify({ rows, pools, reserved, month }).replace(/</g, '\\u003c');
---
<Layout title={`Куда поехать из России в ${brandYear}: визы, сезоны, цены · TravelTribe`} description={desc} canonical="https://traveltribe.ru/" ldJson={ldJson}>
<div class="sw journal">
<main id="main">
  <section class="manifest" aria-labelledby="homeTitle">
    <Image src={heroCover} alt={HOME_HERO.alt} class="hero-ph" widths={[900, 1400, 1920]} sizes="(max-width:760px) max(100vw, min(160svh, 1240px)), max(100vw, min(176svh, 1520px))" format="webp" quality={72} loading="eager" fetchpriority="high" data-travel-photo data-photo-file={HOME_HERO.key} />
    <div class="veil"></div>
    <div class="wrap hero-in">
      <h1 class="h1" id="homeTitle">Куда, когда,<br /><span class="rd">за сколько</span></h1>
      <a class="me" href="/about/" aria-label="Об авторе: Никита Зайцев">
        <Image src={authorPhoto} alt="Никита Зайцев" class="me-ph" width={88} height={88} format="webp" quality={78} loading="eager" />
        <p class="sub"><b>Никита</b> · 60 стран лично · цены, что платил сам</p>
      </a>
      <nav class="hero-nav" aria-label="Разделы TravelTribe">
        <ul class="vlist">
          <li class="vi"><a href="/visa/"><span class="vi-l">Визы РФ</span></a></li>
          <li class="vi"><a href="/seasons/"><span class="vi-l">Когда ехать</span></a></li>
          <li class="vi"><a href="/calculator/"><span class="vi-l">Цена с перелётом</span></a></li>
          <li class="vi"><a href="/trips/"><span class="vi-l">Поездки</span></a></li>
          <li class="vi"><a href="/packing/"><span class="vi-l">Чек-листы</span></a></li>
          <li class="vi"><a href="/countries/"><span class="vi-l">70+ направлений</span></a></li>
        </ul>
      </nav>
    </div>
  </section>

  <section class="wrap journal-section jr" id="recommendations" aria-labelledby="seasonTitle">
    <header class="section-head"><div><h2 id="seasonTitle">Куда ехать в <span data-home-month>{MONTHS_PREP[month]}</span></h2></div><a id="homeCatalog" href={catalogHref(state)}>Все подходящие направления</a></header>
    <p class="home-load-error" id="homeLoadError" role="status" hidden>Не удалось применить условия. <a href="/countries/">Открыть каталог с выбранными условиями</a></p>
    <p class="budget-basis">Бюджет — неделя на одного человека из Москвы, экономный вариант. Неучтённые расходы указаны в карточке.</p>
    <p id="homeResultCount" class="selection-summary" role="status" aria-live="polite">{formatRecommendationCount(collections.recommendations.length)} · хороший или пиковый сезон</p>
    <div class="home-cards seasonal-grid" id="homeRecommendations">{collections.recommendations.map((row, i) => <HomeDestinationCard row={row} placement="recommendation" lead={i === 0} lodging />)}</div>
    <div class="home-empty" id="homeEmpty" hidden><h3>Под эти условия направлений нет</h3><p>Измените месяц в каталоге или снимите ограничения. В подбор по бюджету входят только направления с известной полной стоимостью обязательных расходов.</p><button type="button" id="homeReset">Снять ограничения</button></div>
  </section>

  <section class="wrap journal-section" aria-labelledby="freeTitle">
    <header class="section-head"><div><h2 id="freeTitle">Без визы</h2></div><a id="homeFreeCatalog" href={catalogHref({ m: month, visa: 'free' })}>Все безвизовые направления</a></header>
    <p class="selection-summary">Хороший сезон в <span data-home-month>{MONTHS_PREP[month]}</span> · паспорт РФ · без ограничения бюджета</p>
    <div class="home-cards free-grid" id="homeFree">{collections.free.map(row => <HomeDestinationCard row={row} placement="visa_free" />)}</div>
  </section>

  <aside class="wrap practical-strip" aria-label="Ответы перед поездкой"><p>Ответы перед поездкой</p><a href="/visa/">Документы для въезда</a><a href="/calculator/" data-home-calculator>Из чего складывается бюджет</a><a href="/blog/pay-abroad-2026/">Как платить за границей</a></aside>

  <section class="wrap journal-section" aria-labelledby="cheapTitle">
    <header class="section-head"><div><h2 id="cheapTitle">Неделя недорого</h2></div><a id="homeCheapCatalog" href={catalogHref({ m: month, sort: 'asc' })}>Сравнить все по цене</a></header>
    <p class="selection-summary">Шесть самых дешёвых направлений с хорошим сезоном в <span data-home-month>{MONTHS_PREP[month]}</span>. Без ограничения бюджета и условий въезда.</p>
    <div class="home-cards cheap-grid" id="homeCheap">{collections.cheap.map(row => <HomeDestinationCard row={row} placement="budget" lodging />)}</div>
  </section>

  <section class="wrap journal-section" aria-labelledby="moodTitle">
    <header class="section-head"><div><h2 id="moodTitle">Какого отдыха хочется</h2></div></header>
    <div class="mood-grid">{moods.map(mood => <a href={catalogHref(state, { vibe: mood.vibe })} class="mood-card" data-home-vibe={mood.vibe} data-photo-file={mood.image.key}><picture><source media="(max-width:767px)" srcset={mood.mobile.srcset} sizes="46vw" width={mood.mobile.width} height={mood.mobile.height} type="image/webp" /><img src={mood.image.src} srcset={mood.image.srcset} sizes="(max-width:767px) 46vw, 25vw" width={mood.image.width} height={mood.image.height} loading="lazy" decoding="async" alt={mood.image.alt} /></picture><h3>{mood.title}</h3><p>{mood.note}</p></a>)}</div>
  </section>

  <section class="feature-story anchor2" aria-labelledby="featureTitle">
    <a href="/kenya/" class="feature-photo" data-home-action="guide" data-destination="kenya" data-photo-file={feature.key}><img src={feature.src} srcset={feature.srcset} sizes="100vw" width={feature.width} height={feature.height} loading="lazy" decoding="async" alt={feature.alt} /></a>
    <div class="wrap feature-copy"><p class="eyebrow">Большая история · Кения</p><h2 id="featureTitle"><a href="/kenya/" data-home-action="guide" data-destination="kenya">Выйти за пределы<br />привычного маршрута</a></h2><p>Сафари, озёра и Индийский океан. Разберитесь с сезонами, въездом и расходами — и соберите свою поездку.</p><a class="text-link" href="/kenya/" data-home-action="guide" data-destination="kenya">Исследовать Кению</a></div>
  </section>

  <section class="wrap journal-section" aria-labelledby="storiesTitle">
    <header class="section-head"><div><h2 id="storiesTitle">Гиды и ответы</h2></div><a href="/blog/">Все материалы</a></header>
    <div class="stories-grid">{stories.map((post, i) => <article class:list={['journal-post', { 'journal-post-lead': i === 0 }]} data-photo-file={HOME_STORY_PHOTOS[post.slug]}><a class="post-photo" href={`/blog/${post.slug}/`}><Image src={post.data.coverImage} alt={post.data.coverImageAlt || post.data.title} widths={i === 0 ? [480, 960, 1200] : [256, 480, 720]} sizes={i === 0 ? '(max-width:767px) 92vw, 60vw' : '(max-width:767px) 46vw, 25vw'} format="webp" quality={74} loading="lazy" /></a><p class="eyebrow">{i === 0 ? 'Дальнее путешествие' : 'Практический гид'}</p><h3><a href={`/blog/${post.slug}/`}>{post.data.title}</a></h3></article>)}</div>
  </section>

  <section class="wrap news-strip" aria-labelledby="newsTitle"><h2 id="newsTitle">Что меняется в поездках</h2><div>{freshNews.map(entry => <a href={newsUrl(entry)}><time datetime={entry.data.date.toISOString()}>{formatDateRu(entry.data.date)}</time><span>{entry.data.title}</span></a>)}</div><a href="/novosti/">Все новости</a></section>

  <section class="wrap author-end" aria-labelledby="authorTitle"><Image src={authorPhoto} alt="Никита Зайцев, автор TravelTribe" width={160} height={160} format="webp" quality={78} loading="lazy" /><div><h2 id="authorTitle">Никита Зайцев</h2><p>60+ стран и все семь континентов. Здесь — личные истории, фотографии и практические разборы для тех, кто планирует поездку сам.</p><a href="/about/">Об авторе</a><a href="https://t.me/traveltriberu" target="_blank" rel="noopener">Дневник в Telegram</a></div></section>
</main>
<Footer />
</div>
<script type="application/json" id="homeData" set:html={clientData}></script>
<script>import '../scripts/home-planner.js';</script>
</Layout>

<style is:global>
.sw.journal{--paper:#fbfbfa;--ink:#15171a;--mid:#5c626b;--blue:#1d40ae;background:var(--paper);color:var(--ink);font-family:var(--ff-body,'Golos Text Variable','Golos Text',sans-serif);line-height:1.45}
.journal *{box-sizing:border-box}.journal .wrap{max-width:1280px;margin-inline:auto;padding-inline:clamp(16px,3.5vw,48px)}
.journal :is(h1,h2,h3){font-family:var(--ff-head,'Old Standard TT',Georgia,serif);color:var(--ink);font-weight:400;margin:0;line-height:1.1}.journal h2{scroll-margin-top:80px;font-size:clamp(30px,3.6vw,48px)}.journal h3{font-size:clamp(22px,2.1vw,30px)}
.journal a{color:inherit;text-decoration:none}.journal a:focus-visible,.journal :is(button,select):focus-visible{outline:2px solid var(--blue);outline-offset:4px}.journal :is(button,select){font:inherit;color:var(--ink);border-radius:0}
.journal img{display:block;max-width:100%;filter:grayscale(.06) contrast(1.02)}

.journal button{min-height:44px;background:transparent;border:1px solid var(--ink);padding:10px 14px;cursor:pointer}.journal button:hover{border-color:var(--blue);color:var(--blue)}
.journal .journal-section{scroll-margin-top:80px;padding-top:72px;padding-bottom:8px}.journal .section-head{display:flex;justify-content:space-between;align-items:center;gap:24px;margin-bottom:20px}.journal .section-head>a{font-size:13px;min-height:44px;display:flex;align-items:center;border-bottom:1px solid var(--blue);color:var(--blue)}.journal .eyebrow{font-family:var(--ff-mono,'PT Mono',monospace);font-size:11px;letter-spacing:.055em;line-height:1.55;color:var(--mid);margin:0 0 11px}.journal .selection-summary{font-size:13px;max-width:800px;color:var(--mid);margin:0 0 22px}
.journal .home-cards{display:grid;gap:28px 24px}.journal .home-card{min-width:0;display:flex;flex-direction:column}.journal .home-card-photo{display:block;aspect-ratio:4/3;overflow:hidden;flex:none}.journal .home-card-photo img{width:100%;height:100%;object-fit:cover;object-position:var(--focal,50% 50%)}.journal .home-card-text{padding-top:13px;display:grid;grid-template-rows:auto 1fr auto auto auto;align-items:start;flex:1}.journal .home-budget,.journal .home-entry{justify-self:start}.journal .home-card h3 a{display:inline-block;min-height:44px}.journal .home-season{font-size:14px;color:var(--mid);margin:7px 0}.journal .home-budget{font-family:var(--ff-mono,'PT Mono',monospace);font-size:13px;line-height:1.55;border-bottom:1px solid var(--ink);min-height:44px;padding-block:4px}.journal .home-entry{font-size:14px;color:var(--mid);min-height:44px;padding-block:7px}.journal .home-stay{font-size:14px;color:var(--blue);margin-top:7px;padding-top:10px;border-top:1px solid var(--line,#dcdedc);min-height:44px;width:100%}
.journal .seasonal-grid{grid-template-columns:repeat(5,minmax(0,1fr))}.journal .seasonal-grid .home-card:first-child{grid-column:1/-1;grid-row:auto;display:grid;grid-template-columns:1.25fr 1fr;gap:32px;align-items:center}.journal .seasonal-grid .home-card:first-child .home-card-text{padding-top:0}.journal .seasonal-grid .home-card:first-child .home-card-photo{aspect-ratio:4/3;min-height:0}.journal .seasonal-grid .home-card:first-child h3{font-size:38px}.journal .free-grid{grid-template-columns:1.25fr 1fr 1fr 1.25fr}.journal .free-grid .home-card:nth-child(even){padding-top:35px}.journal .free-grid .home-card-photo{aspect-ratio:4/5}.journal .cheap-grid{grid-template-columns:repeat(3,minmax(0,1fr))}.journal .cheap-grid .home-card-photo{aspect-ratio:4/3}.journal .home-empty{border-block:1px solid var(--line,#dcdedc);padding:28px 0}.journal .home-empty p{font-size:14px}.journal [hidden]{display:none!important}
.journal .practical-strip{margin-top:62px;display:grid;grid-template-columns:1.25fr 1fr 1fr 1fr;gap:24px;align-items:center}.journal .practical-strip>*{border-top:1px solid var(--ink);padding-top:16px;min-height:64px;font-size:14px;margin:0}.journal .practical-strip p{font-family:var(--ff-head,Georgia);font-size:24px;line-height:1.2}.journal .practical-strip a{color:var(--blue)}
.journal .mood-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:24px}.journal .mood-card img{aspect-ratio:4/5;width:100%;height:auto;object-fit:cover}.journal .mood-card h3{margin:15px 0 7px}.journal .mood-card p{font-size:14px;color:var(--mid);margin:0}.journal .feature-story{margin-top:72px;position:relative}.journal .feature-photo{display:block;aspect-ratio:2/1;overflow:hidden}.journal .feature-photo img{width:100%;height:100%;object-fit:cover;object-position:50% 48%}.journal .feature-copy{display:grid;grid-template-columns:1fr 1fr;gap:14px 48px;padding-top:25px}.journal .feature-copy .eyebrow{grid-column:1/-1;margin:0}.journal .feature-copy h2{grid-row:span 2}.journal .feature-copy>p:not(.eyebrow){font-size:16px;max-width:460px;margin:0;line-height:1.7}.journal .text-link{color:var(--blue);min-height:44px;display:flex;align-items:center;text-decoration:underline;text-underline-offset:5px}
.journal .stories-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:36px 24px;align-items:start}.journal .journal-post{min-width:0}.journal .budget-basis{font-size:14px;line-height:1.6;color:var(--mid);max-width:780px;margin:0 0 16px}.journal .post-photo{display:block;aspect-ratio:4/3;overflow:hidden;margin-bottom:14px}.journal .post-photo img{width:100%;height:100%;object-fit:cover}.journal .journal-post h3{font-size:23px;line-height:1.24}.journal .journal-post .eyebrow{font-size:10px;margin-bottom:6px}.journal .journal-post-lead{grid-column:span 2;grid-row:span 2}.journal .journal-post-lead .post-photo{aspect-ratio:4/5}.journal .journal-post-lead h3{font-size:35px}.journal .journal-post:last-child{grid-column:span 2;display:grid;grid-template-columns:1fr 1fr;gap:10px 18px}.journal .journal-post:last-child .post-photo{grid-row:span 2;margin:0;aspect-ratio:4/3}.journal .journal-post:last-child .eyebrow{align-self:end}
.journal .news-strip{padding-top:64px;display:grid;grid-template-columns:1fr 2fr;gap:20px 40px}.journal .news-strip h2{font-size:30px}.journal .news-strip>div>a{display:grid;grid-template-columns:90px 1fr;gap:14px;padding:13px 0;border-bottom:1px solid var(--line,#dcdedc);font-size:13px;min-height:44px}.journal .news-strip time{font-family:var(--ff-mono,monospace);font-size:10px;color:var(--mid)}.journal .news-strip>a{grid-column:2;font-size:13px;color:var(--blue);min-height:44px}.journal .author-end{padding-top:76px;padding-bottom:72px;display:grid;grid-template-columns:160px minmax(0,600px);gap:36px;align-items:center}.journal .author-end>img{width:160px;height:160px;border-radius:50%;filter:grayscale(.3)}.journal .author-end p:not(.eyebrow){font-size:15px;line-height:1.7}.journal .author-end a{display:inline-flex;align-items:center;min-height:44px;margin-right:24px;color:var(--blue);border-bottom:1px solid var(--blue)}
