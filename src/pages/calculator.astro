---
const brandYear = new Date().getFullYear();
// ⛔ Сниппет-замер 07.09.2026 (рутина дожима снята 09.09.2026, журнал удалён).
// До правки: 316 показов по названным запросам за 28 дней и НОЛЬ кликов при средней
// позиции 5,7 — «калькулятор путешествия» (166 показов) и «путешествия калькулятор»
// (111). Описание слово в слово повторяло заголовок и не давало причины кликнуть, а
// все семь конкурентов выше в выдаче — пустые формы «введите свои цифры». Отличие
// страницы: цены уже подставлены. Число направлений берём из PRICES, чтобы заголовок
// не устарел при добавлении направления. Вердикт 21.09.2026 и 05.10.2026.
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import { PRICES } from '../data/prices.js';
import { DIRECTIONS } from '../data/directions.js';
import { VISA_DETAILS } from '../data/visa-details.js';
import { DATA_UPDATED } from '../data/meta.js';
import { getBudgetRates } from '../utils/budget-rates.js';
import { build } from 'esbuild';
import { resolve } from 'node:path';
import calculatorSource from '../scripts/calculator.js?raw';
const rates = await getBudgetRates();
import { sputnik8Explore } from '../data/affiliate.js';

// Результат заполняется до первого кадра, как у прежнего inline-калькулятора.
// Сборка в IIFE сохраняет общую формулу без ожидания загрузки отдельного модуля.
const calculatorBundle = await build({
  stdin: { contents: calculatorSource, resolveDir: resolve('src/scripts'), sourcefile: 'calculator.js' },
  bundle: true, write: false, format: 'iife', platform: 'browser', target: 'es2020',
  minify: true, legalComments: 'none',
});

const groups: Record<string, Array<{i:number,name:string,iata:string}>> = {};
PRICES.forEach((p, i) => {
  if (!groups[p.g]) groups[p.g] = [];
  groups[p.g].push({ i, name: p.name, iata: p.iata });
});
// Сортировка стран внутри каждой группы по алфавиту (русская локаль)
Object.keys(groups).forEach(g => {
  groups[g].sort((a, b) => a.name.localeCompare(b.name, 'ru'));
});
// Сортировка самих групп по алфавиту
const sortedGroups: Record<string, Array<{i:number,name:string,iata:string}>> = {};
Object.keys(groups).sort((a, b) => a.localeCompare(b, 'ru')).forEach(g => {
  sortedGroups[g] = groups[g];
});

// Маппинг по NAME (а не iata) — потому что разные направления могут шарить iata
// (например, Australia-East и Australia-North в DIRECTIONS оба ссылаются на SYD).
// PRICES — источник истины: у каждого свой name + iata.
const priceIdxToSlug: Record<number, string> = {};
const priceIdxToSeasons: Record<number, any> = {};
const priceIdxToVisa: Record<number, any> = {};

PRICES.forEach((p, i) => {
  // Находим DIRECTIONS-запись с тем же name (в price.name внутри directions)
  const dir: any = DIRECTIONS.find((d: any) => d.price?.name === p.name);
  if (!dir) return;
  priceIdxToSlug[i] = dir.slug;
  priceIdxToSeasons[i] = dir.r;
  if ((VISA_DETAILS as any)[dir.slug]) {
    priceIdxToVisa[i] = { ...(VISA_DETAILS as any)[dir.slug], slug: dir.slug };
  }
});

const MONTH_NAMES = ['Янв','Фев','Мар','Апр','Май','Июн','Июл','Авг','Сен','Окт','Ноя','Дек'];
const MONTH_FULL  = ['январе','феврале','марте','апреле','мае','июне','июле','августе','сентябре','октябре','ноябре','декабре'];

// ⛔ Один источник для видимого блока и для разметки. До 02.08.2026 они жили
// порознь: в разметке стояли пять вопросов, на странице — шесть других, ни один
// не совпадал дословно. Разметка без видимого текста — спам-флаг по чеклисту.
const FAQS = [
  { q: 'Как считается бюджет на несколько человек?',
    a: 'Перелёт задаётся на всех путешественников, питание — на человека в день. Жильё считается по ночам и числу номеров. Проверь вместимость выбранного размещения.' },
  { q: 'Виза включена в итог?',
    a: 'Известные сборы за въезд входят в сумму. Если цена сборов или обязательной страховки неизвестна, калькулятор показывает известную часть бюджета и перечисляет невключённые расходы.' },
  { q: 'Что такое «лучший месяц»?',
    a: 'Это месяц с наиболее низкой оценкой перелёта среди месяцев с подходящим сезоном. Процент экономии в подсказке относится к перелёту. Жильё и питание остаются с прежними оценками.' },
  { q: 'Что означает «Оплачено»?',
    a: 'Расход остаётся в общей стоимости поездки, но вычитается из суммы, которую ещё предстоит оплатить. Запас считается только от оставшихся известных расходов.' },
  { q: 'Как сохранить свой расчёт?',
    a: 'Нажми «Сохранить в браузере», чтобы вернуться к расчёту на этом устройстве, или скопируй ссылку. В ссылку войдут выбранные условия и введённые суммы.' },
  { q: 'Учитывает ли курс рубля?',
    a: 'Да. Суммы можно смотреть в рублях или долларах — переключатель рядом с уровнем комфорта.' },
];

const ldJson = {
  "@context": "https://schema.org",
  "@graph": [
    {
      // ⛔ speakable живёт на WebPage, а не на WebApplication: у второго это свойство
      // не определено, и валидатор schema.org даёт предупреждение (21.08.2026).
      "@type": "WebPage",
      "@id": "https://traveltribe.ru/calculator/#webpage",
      "url": "https://traveltribe.ru/calculator/",
      "speakable": { "@type": "SpeakableSpecification", "cssSelector": ["h1", ".tc-lede"] },
      "isPartOf": { "@id": "https://traveltribe.ru/#website" }
    },
    {
      "@type": "WebApplication",
      "name": `Калькулятор бюджета путешествия ${brandYear}`,
      "url": "https://traveltribe.ru/calculator/",
      "description": `Интерактивный калькулятор стоимости поездки из Москвы на ${brandYear}: направления, сравнение, свои расходы, оплаченное и запас на поездку.`,
      "inLanguage": "ru-RU",
      "applicationCategory": "TravelApplication",
      "operatingSystem": "Any",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "RUB" },
      "featureList": ["70+ направлений","Сравнение до 3 стран","Сезонный коэффициент по 12 месяцам","Расчёт 1–4 путешественников","Виза в разбивке","Свои суммы","Оплаченные расходы","Запас на поездку","Сохранение расчёта"],
      "dateModified": DATA_UPDATED,
      "author": { "@id": "https://traveltribe.ru/about/#person" },
      "publisher": { "@id": "https://traveltribe.ru/#org" }
    },
    {
      "@type": "HowTo",
      "name": `Как посчитать бюджет путешествия из Москвы в ${brandYear}`,
      "totalTime": "PT2M",
      "estimatedCost": { "@type": "MonetaryAmount", "currency": "RUB", "value": "0" },
      "step": [
        { "@type":"HowToStep", "position":1, "name":"Выбрать направление", "text":"Одна из 70+ стран. Опционально добавь ещё для сравнения." },
        { "@type":"HowToStep", "position":2, "name":"Указать месяц поездки", "text":"Калькулятор учтёт сезонный коэффициент: пик +30%, не сезон −30%." },
        { "@type":"HowToStep", "position":3, "name":"Длительность и путешественники", "text":"От 1 до 90 дней, от 1 до 4 человек. Уточни число ночей и номеров." },
        { "@type":"HowToStep", "position":4, "name":"Уровень комфорта", "text":"Эконом / комфорт / люкс." },
        { "@type":"HowToStep", "position":5, "name":"Скопировать в Telegram", "text":"Готовая сводка для пересылки в чат." }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": FAQS.map((f) => ({
        "@type": "Question", "name": f.q,
        "acceptedAnswer": { "@type": "Answer", "text": f.a },
      })),
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type":"ListItem", "position":1, "name":"Главная", "item":"https://traveltribe.ru/" },
        { "@type":"ListItem", "position":2, "name":"Калькулятор", "item":"https://traveltribe.ru/calculator/" }
      ]
    }
  ]
};
---
<Layout
  title={`Калькулятор путешествия ${brandYear}: ${PRICES.length} направлений, цены уже есть`}
  description="Выбери страну и месяц, уточни свои расходы и оплаченное. Калькулятор покажет бюджет поездки, запас и сколько ещё осталось оплатить."
  canonical="https://traveltribe.ru/calculator/"
  ogTitle="Калькулятор бюджета — TravelTribe"
  ogDescription="Сравнение направлений, свои расходы, оплаченное и запас на поездку."
  ogType="website"
  ldJson={ldJson}
  noTransitions={true}
>

  <main id="main" class="tc">

    <!-- ───────────── HERO ──────────────────────────────────── -->
    <section class="tc-hero">
      <div class="tc-container">
        <h1 class="tc-h1">Сколько стоит твоя поездка</h1>
        <p class="tc-lede">Выбери направление, уточни свои расходы и посмотри, сколько осталось оплатить. Базовая оценка перелёта — из Москвы.</p>
        <p class="tc-byline">
          <a href="/about/" class="tc-byline-author">Никита Зайцев</a> ·
          <a href="https://t.me/traveltriberu" target="_blank" rel="noopener">@traveltriberu</a>
        </p>
      </div>
    </section>

    <!-- ───────────── FORM BAR (horizontal, like Google Flights) ─ -->
    <div class="tc-workbench tc-container">
    <div class="tc-work">
    <section class="tc-form-section">
      <div class="tc-container">
        <form class="tc-form" id="tcForm" onsubmit="return false">
          <div class="tc-form-grid">
            <div class="tc-field tc-field--country">
              <label class="tc-field-label" for="calcRegion">Направление</label>
              <select class="tc-input tc-input--select" id="calcRegion">
                {Object.entries(sortedGroups).map(([label, items]) => (
                  <optgroup label={label}>
                    {items.map(({ i, name }) => (
                      <option value={i}>{name}</option>
                    ))}
                  </optgroup>
                ))}
              </select>
            </div>

            <div class="tc-field">
              <label class="tc-field-label">Месяц</label>
              <select class="tc-input tc-input--select" id="monthSelect" aria-label="Месяц поездки">
                <option value="0">Любой</option>
                {MONTH_NAMES.map((m, i) => (
                  <option value={i + 1}>{['Январь','Февраль','Март','Апрель','Май','Июнь','Июль','Август','Сентябрь','Октябрь','Ноябрь','Декабрь'][i]}</option>
                ))}
              </select>
            </div>

            <div class="tc-field">
              <label class="tc-field-label">Дней</label>
              <div class="tc-stepper">
                <button class="tc-stepper-btn" id="daysDown" type="button" aria-label="Меньше дней">−</button>
                <span class="tc-stepper-val" id="calcDaysDisplay">7</span>
                <button class="tc-stepper-btn" id="daysUp" type="button" aria-label="Больше дней">+</button>
                <input type="hidden" id="calcDays" value="7" aria-hidden="true" />
              </div>
            </div>

            <div class="tc-field">
              <label class="tc-field-label">Путешественников</label>
              <div class="tc-stepper">
                <button class="tc-stepper-btn" id="travDown" type="button" aria-label="Меньше людей">−</button>
                <span class="tc-stepper-val" id="travelersDisplay">1</span>
                <button class="tc-stepper-btn" id="travUp" type="button" aria-label="Больше людей">+</button>
              </div>
            </div>

            <div class="tc-field tc-field--level">
              <label class="tc-field-label">Уровень</label>
              <div class="tc-seg" id="levelGroup" role="group" aria-label="Уровень комфорта">
                <button class="tc-seg-btn active" data-lvl="0" aria-pressed="true">Эконом</button>
                <button class="tc-seg-btn" data-lvl="1" aria-pressed="false">Комфорт</button>
                <button class="tc-seg-btn" data-lvl="2" aria-pressed="false">Люкс</button>
              </div>
            </div>

            <div class="tc-field tc-field--currency">
              <label class="tc-field-label">Валюта</label>
              <div class="tc-seg tc-seg--small" id="currGroup" role="group" aria-label="Валюта">
                <button class="tc-seg-btn active" data-cur="rub" aria-pressed="true">₽</button>
                <button class="tc-seg-btn" data-cur="usd" aria-pressed="false">$</button>
              </div>
            </div>
          </div>

          <div class="tc-form-extra">
            <select class="tc-add-country" id="addCountrySelect" aria-label="Сравнить с другой страной" hidden>
              <option value="">+ Сравнить с другой страной</option>
              {Object.entries(sortedGroups).map(([label, items]) => (
                <optgroup label={label}>
                  {items.map(({ i, name }) => (
                    <option value={i}>{name}</option>
                  ))}
                </optgroup>
              ))}
            </select>
            <span class="tc-rate" id="calcRateLabel">1 $ = {rates.USD.toFixed(2)} ₽</span>
          </div>
        </form>
      </div>
    </section>

    <section class="tc-personal-section" aria-labelledby="personalCostsTitle">
      <div class="tc-personal-heading"><h2 id="personalCostsTitle">Расходы поездки</h2><button type="button" class="tc-copy-btn" id="budgetSummaryBtn">К итогу</button></div>
      <div id="personalCosts" class="ym-hide-content"></div>
    </section>
    </div>

    <!-- ───────────── RESULT — full width hero panel ─────────── -->
    <section class="tc-result-section">
      <div class="tc-container">
        <div id="calcResult" class="tc-result ym-hide-content" tabindex="-1"></div>
        <div id="calcNotice" class="tc-notice ym-hide-content" role="status" aria-live="polite"></div>
      </div>
    </section>

    </div>
    <noscript><p class="tc-container">Для изменения условий и пересчёта бюджета включи JavaScript.</p></noscript>

    {/* Экскурсии на месте — программы и даты у партнёра */}
    <section class="tc-section">
      <div class="tc-container">
        <p class="tc-tourcta">Что посмотреть на месте? <a href={sputnik8Explore('calculator')} rel="sponsored noopener" target="_blank"><strong>Экскурсии на Sputnik8</strong></a> — программы, отзывы и даты у партнёра. </p>
      </div>
    </section>

    <!-- ───────────── FAQ ────────────────────────────────────── -->
    <section class="tc-section tc-faq">
      <div class="tc-container">
        <div class="tc-section-head">
          <h2 class="tc-section-title">Частые вопросы</h2>
        </div>
        <div class="tc-faq-list">
          {FAQS.map((f, i) => (
            <details class="tc-faq-item" open={i === 0}>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

  </main>

  <Footer />
</Layout>

<script id="calculatorData" type="application/json" set:html={JSON.stringify({ PRICES, MONTH_NAMES, MONTH_FULL, priceIdxToSeasons, priceIdxToVisa, priceIdxToSlug, rates }).replace(/</g, '\\u003c')} />
<script is:inline data-astro-rerun set:html={calculatorBundle.outputFiles[0].text} />

<style is:global>
.tc { background:var(--bg); color:var(--text); padding-bottom:32px; }
.tc .tc-container { width:100%; max-width:1280px; margin-inline:auto; padding-inline:clamp(18px,3vw,40px); box-sizing:border-box; }
.tc h1,.tc h2,.tc h3 { text-align:left; scroll-margin-top:100px; }
.tc .tc-hero { padding:32px 0 24px; }
.tc .tc-h1 { font-family:var(--ff-display); font-weight:700; font-size:clamp(30px,4vw,48px); line-height:1.08; margin:0 0 12px; }
.tc .tc-lede { max-width:770px; font-size:16px; line-height:1.55; margin:0 0 10px; }
.tc .tc-byline { margin:0; font-size:13px; color:var(--text-faint); }
.tc .tc-workbench { display:grid; grid-template-columns:minmax(0,1fr) minmax(320px,.68fr); gap:32px; align-items:start; }
.tc .tc-work,.tc .tc-result-section { min-width:0; }
.tc .tc-workbench .tc-container { padding:0; max-width:none; }
.tc .tc-form { padding:20px 0; border-top:2px solid var(--text); border-bottom:1px solid var(--line); }
.tc .tc-form-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:16px; }
.tc .tc-field { min-width:0; }
.tc .tc-field-label { display:block; font-size:14px; font-weight:600; margin-bottom:6px; }
.tc input,.tc select,.tc button { font:inherit; }
.tc .tc-input,.tc .tc-add-country { min-width:0; width:100%; max-width:100%; min-height:48px; font-size:16px; background:#fff; color:var(--text); border:1px solid var(--line); padding:8px 12px; border-radius:0; }
.tc .tc-stepper { display:flex; min-height:48px; border:1px solid var(--line); align-items:center; justify-content:space-between; }
.tc .tc-stepper-btn { width:48px; min-height:46px; background:none; border:0; cursor:pointer; font-size:20px; color:var(--text); }
.tc .tc-stepper-val { font-family:var(--ff-mono); }
.tc .tc-seg { display:flex; min-height:48px; border:1px solid var(--line); }
.tc .tc-seg-btn { flex:1; min-width:44px; min-height:46px; border:0; background:transparent; cursor:pointer; padding:8px; color:var(--text); font-size:16px; }
.tc .tc-seg-btn.active { background:var(--gold); color:#fff; }
.tc .tc-form-extra { display:flex; gap:12px; align-items:center; margin-top:16px; }
.tc .tc-add-country { flex:1; color:var(--gold); }
.tc .tc-add-country[hidden],.tc button[hidden] { display:none!important; }
.tc .tc-rate { font-size:12px; font-family:var(--ff-mono); color:var(--text-faint); flex-shrink:0; }
.tc .tc-personal-section { padding-top:24px; }
.tc .tc-personal-section h2 { font-family:var(--ff-display); font-size:28px; line-height:1.2; margin:0 0 18px; }
.tc .tc-personal-heading { display:flex; justify-content:space-between; align-items:baseline; gap:16px; }
.tc #calcResult { scroll-margin-top:108px; }
.tc .tc-stay-settings { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:12px; }
.tc .tc-stay-settings label { font-size:14px; }
.tc .tc-stay-settings input { width:100%; min-height:48px; min-width:0; border:1px solid var(--line); border-radius:0; padding:8px 10px; margin-top:6px; font-size:16px; box-sizing:border-box; background:#fff; color:var(--text); }
.tc .tc-help { font-size:13px; color:var(--text-faint); margin:12px 0 20px; line-height:1.5; }
.tc .tc-expense { border-top:1px solid var(--line); padding:16px 0; }
.tc .tc-expense-main { display:grid; grid-template-columns:minmax(0,1fr) minmax(100px,155px); gap:12px; align-items:center; }
.tc .tc-expense-main label { font-weight:600; font-size:16px; line-height:1.35; }
.tc .tc-expense-main label span { display:block; font-weight:400; font-size:13px; color:var(--text-faint); margin-top:5px; }
.tc .tc-expense-main > input { width:100%; min-width:0; min-height:48px; box-sizing:border-box; border:1px solid var(--line); border-radius:0; padding:10px; font-family:var(--ff-mono); font-size:16px; background:#fff; color:var(--text); }
.tc .tc-expense-main input[aria-invalid=true] { border:2px solid #b3261e; }
.tc .tc-expense-actions { display:flex; align-items:center; gap:8px 16px; flex-wrap:wrap; margin-top:4px; font-size:13px; }
.tc .tc-expense-actions label { display:flex; min-height:44px; align-items:center; cursor:pointer; gap:6px; }
.tc .tc-expense-actions input { width:20px; height:20px; accent-color:var(--gold); }
.tc .tc-expense-actions > span { margin-left:auto; font-family:var(--ff-mono); }
.tc .tc-expense-actions button { min-height:44px; color:var(--gold); border:0; background:transparent; text-decoration:underline; text-underline-offset:4px; cursor:pointer; padding:0; }
.tc .tc-field-error { color:#b3261e; font-size:13px; line-height:1.4; margin:6px 0; }
.tc .tc-field-error:empty { display:none; }
.tc .is-excluded .tc-expense-main { opacity:.65; }
.tc .tc-result-section { position:sticky; top:108px; border-top:2px solid var(--gold); }
.tc .tc-single { padding:20px 0; }
.tc .tc-result-tag { font-size:17px; font-weight:600; overflow-wrap:anywhere; }
.tc .tc-result-pills { display:flex; gap:8px 14px; flex-wrap:wrap; margin-top:8px; font-size:13px; color:var(--text-faint); }
.tc .tc-visa-pill { display:inline-flex; align-items:center; min-height:44px; color:var(--gold); }
.tc .tc-hero-total { padding:18px 0; }
