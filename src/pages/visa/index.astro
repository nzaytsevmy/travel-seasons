---
import Layout from '../../layouts/Layout.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { Image } from 'astro:assets';
import { DIRECTIONS } from '../../data/directions.js';
import { getEntryRequirements, visaCatalogFact } from '../../data/entry-requirements.js';

const destPhotos = import.meta.glob('../../assets/destinations/*.jpg', { eager: true, import: 'default' });
const entries = new Map(DIRECTIONS.map((d) => [d.slug, getEntryRequirements(d)]));
const groups = [
  { mode: 'free', title: 'Без визы', description: 'Паспорт, срок поездки и дополнительные условия въезда.' },
  { mode: 'evisa', title: 'Оформление онлайн', description: 'Электронные визы и разрешения, которые получают до вылета.' },
  { mode: 'arrival', title: 'Виза по прибытии', description: 'Документы и оформление на границе.' },
  { mode: 'required', title: 'Виза заранее', description: 'Комплект документов, порядок подачи и ограничения.' },
  { mode: 'route', title: 'Особые маршруты', description: 'Поездки через несколько стран и экспедиции: документы зависят от маршрута.' },
  { mode: 'domestic', title: 'По России', description: 'Документы для перелёта и поездки внутри страны.' },
  { mode: 'unknown', title: 'Правила въезда', description: 'Официальные требования для вашего направления.' },
].map((g) => ({ ...g, directions: DIRECTIONS.filter((d) => entries.get(d.slug).mode === g.mode) }));
const popular = ['turkey', 'thailand', 'georgia', 'armenia', 'vietnam', 'egypt', 'japan'];
for (const group of groups) group.directions.sort((a, b) => {
  const rank = (slug) => popular.includes(slug) ? popular.indexOf(slug) : popular.length;
  return rank(a.slug) - rank(b.slug) || a.cases.nom.localeCompare(b.cases.nom, 'ru');
});
const FAQ_ITEMS = [
  { q: 'Как найти документы для своей поездки?', a: 'Введите название страны и откройте её страницу. Там собраны условия для туристов с обычным российским паспортом: документы, срок пребывания и порядок оформления.' },
  { q: 'Что такое электронная виза?', a: visaCatalogFact('electronic') },
  { q: 'Чем срок действия визы отличается от срока пребывания?', a: 'Срок действия определяет, когда можно использовать визу. Срок пребывания определяет, как долго можно находиться в стране. Учитывайте оба условия и число въездов.' },
  { q: 'Входят ли Болгария и Румыния в Шенген?', a: visaCatalogFact('schengen') },
  { q: 'Куда подавать на туристическую визу в Японию?', a: visaCatalogFact('japan') },
].filter((f) => f.a);
const url = 'https://traveltribe.ru/visa/';
const ldJson = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'CollectionPage', '@id': `${url}#page`, url,
      name: 'Визы для россиян — правила въезда и документы',
      description: 'Документы и условия туристической поездки по странам. Визы, электронные разрешения, безвизовый въезд и поездки по России.',
      inLanguage: 'ru-RU', datePublished: '2025-09-15', dateModified: '2026-11-07',
      isPartOf: { '@id': 'https://traveltribe.ru/#website' }, mainEntity: { '@id': `${url}#itemlist` },
      author: { '@type': 'Person', name: 'Никита Зайцев', url: 'https://traveltribe.ru/about/' },
      publisher: { '@type': 'Organization', name: 'TravelTribe', url: 'https://traveltribe.ru/' } },
    { '@type': 'ItemList', '@id': `${url}#itemlist`, name: 'Визы и документы по направлениям', numberOfItems: DIRECTIONS.length,
      itemListElement: groups.flatMap((g) => g.directions).map((d, i) => ({ '@type': 'ListItem', position: i + 1,
        item: { '@type': ['TouristDestination', 'Place'], name: d.cases.nom, url: `${url}${d.slug}/`,
          description: entries.get(d.slug).summary ?? entries.get(d.slug).label } })) },
    { '@type': 'FAQPage', mainEntity: FAQ_ITEMS.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
    { '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://traveltribe.ru/' },
      { '@type': 'ListItem', position: 2, name: 'Визы', item: url } ] },
  ],
};
---
<Layout title="Визы для россиян — правила въезда и документы"
  description="Документы для туристической поездки: безвизовые страны, электронные разрешения, визы заранее и поездки по России. Сроки пребывания и условия по странам."
  canonical={url} ogTitle="Визы и документы для поездки — TravelTribe" ogDescription="Найдите свою страну: документы, срок пребывания и порядок въезда." ldJson={ldJson}>
  <Breadcrumbs crumbs={[{ label: 'Визы' }]} />
  <main id="main" class="visa-archive prep-visa-catalog" data-prep-catalog="visa">
    <header class="va-doc-head">
      <h1>Визы и правила въезда</h1>
      <p class="va-lead">Что подготовить туристу с российским паспортом: от поездки без визы до подачи документов в консульство.</p>
      <form class="va-tool" role="search" aria-label="Поиск правил въезда">
        <div class="va-search-wrap">
          <label for="visaSearch">Страна или регион</label>
          <div class="va-search-field">
            <input type="search" id="visaSearch" name="q" placeholder="Япония, Турция, Грузия…" autocomplete="off" aria-label="Поиск страны" />
            <button type="button" id="visaSearchClear" aria-label="Очистить поиск" hidden>×</button>
          </div>
        </div>
        <div class="va-mode">
          <label for="visaMode">Условия въезда</label>
          <select id="visaMode" name="visa">
            <option value="all">Все направления</option>
            {groups.filter((g) => g.directions.length && g.mode !== 'unknown').map((g) => <option value={g.mode}>{g.title}</option>)}
          </select>
        </div>
        <details class="va-extra">
          <summary>Срок и стоимость визы</summary>
          <div class="va-extra-fields">
            <label>Визовый сбор<select id="visaCost"><option value="">Любой</option><option value="free">Бесплатно</option><option value="cheap">До $50</option><option value="premium">Свыше $50</option></select></label>
            <label>Срок пребывания<select id="visaDuration"><option value="">Любой</option><option value="long">60+ дней</option></select></label>
          </div>
        </details>
        <button type="reset" id="visaReset" hidden>Сбросить</button>
        <p id="visaFilterCount" aria-live="polite" aria-atomic="true" hidden></p>
      </form>
      <noscript><style>.va-tool { display: none !important; }</style><p>Все направления и документы доступны ниже.</p></noscript>
    </header>
    <p class="va-empty" id="visaEmpty" hidden>Страна не найдена. Проверьте название или сбросьте фильтры.</p>
    {groups.filter((g) => g.directions.length).map((g, groupIndex) => (
      <>
        <section class="va-section" data-section={g.mode} aria-labelledby={`visa-${g.mode}`}>
          <header class="va-section-head"><h2 id={`visa-${g.mode}`}>{g.title}</h2><p>{g.description}</p></header>
          <div class="va-grid">
            {g.directions.map((d, i) => {
              const photo = destPhotos[`../../assets/destinations/${d.slug}.jpg`];
              const e = entries.get(d.slug);
              const cost = e.feeUsd === null ? '' : e.feeUsd === 0 ? 'free' : e.feeUsd <= 50 ? 'cheap' : 'premium';
              return (<a class="va-card" href={`/visa/${d.slug}/`} data-name={d.cases.nom.toLocaleLowerCase('ru')} data-visa={e.mode}
                data-cost={cost} data-duration-long={e.stayDays !== null && e.stayDays >= 60 ? '1' : '0'}>
                {photo && <Image src={photo} alt={d.cases.nom} widths={[160, 320, 480]} sizes="(max-width: 600px) 100px, 180px" formats={['webp']} quality={75} loading={groupIndex === 0 && i < 2 ? 'eager' : 'lazy'} />}
                <div class="va-card-body"><h3>{d.cases.nom}</h3>
                  <p class="va-card-mode">{e.label}</p>
                  {e.stay && <p class="va-card-stay">{e.stay}</p>}
                  <span class="va-card-link">{d.domestic ? 'Документы для поездки' : 'Документы и условия въезда'}</span>
                </div>
              </a>);
            })}
          </div>
        </section>
        {groupIndex === 0 && <aside class="va-money-row" aria-label="Подготовка к поездке">
          <h2>Подготовка к поездке</h2>
          <p>Сохраните документы и подберите страховку под маршрут.</p>
          <a class="aff-cta" href="https://cherehapa.tpk.mx/fkM7suze?erid=2VtzquZTwb5&sub_id=visa_index&u=https%3A%2F%2Fcherehapa.ru%2Ftravel%2F" target="_blank" rel="nofollow noopener sponsored">Сравнить страховки для поездки</a>
          <a class="aff-cta" href="https://aviasales.tpk.mx/JCSPlC17?erid=2Vtzqxkn4LF&sub_id=visa_index&u=https%3A%2F%2Fwww.aviasales.ru%2F" target="_blank" rel="nofollow noopener sponsored">Посмотреть билеты</a>
        </aside>}
      </>
    ))}
    <section class="va-faq" aria-labelledby="visa-faq-title">
      <h2 id="visa-faq-title">Частые вопросы</h2>
      {FAQ_ITEMS.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
    </section>
    <nav class="va-related" aria-label="Подробные гайды">
      <h2>Что почитать дальше</h2>
      <ul>
        <li><a href="/blog/schengen-visa-2026/">Шенген: документы и порядок подачи</a></li>
        <li><a href="/blog/japan-visa-2026/">Как оформить визу в Японию</a></li>
        <li><a href="/blog/china-guide-2026/">Путеводитель по Китаю</a></li>
        <li><a href="/blog/ees-shengen-2026/">Как проходить биометрию EES на границе</a></li>
        <li><a href="/blog/pay-abroad-2026/">Как платить за границей</a></li>
        <li><a href="/blog/turkey-guide-2026/">Путеводитель по Турции</a></li>
      </ul>
    </nav>
    <footer class="va-foot"><p>Для работы, учёбы и транзита действуют отдельные правила. Условия туристической поездки и исключения указаны на странице страны.</p><p>Автор — <a href="/about/">Никита Зайцев</a></p></footer>
  </main>
  <Footer />
</Layout>
<script>
  const form = document.querySelector<HTMLFormElement>('.va-tool');
  if (form) {
    const search = document.querySelector<HTMLInputElement>('#visaSearch')!;
    const mode = document.querySelector<HTMLSelectElement>('#visaMode')!;
    const cost = document.querySelector<HTMLSelectElement>('#visaCost')!;
    const duration = document.querySelector<HTMLSelectElement>('#visaDuration')!;
    const reset = document.querySelector<HTMLButtonElement>('#visaReset')!;
    const clear = document.querySelector<HTMLButtonElement>('#visaSearchClear')!;
    const count = document.querySelector<HTMLElement>('#visaFilterCount')!;
    const empty = document.querySelector<HTMLElement>('#visaEmpty')!;
    const cards = [...document.querySelectorAll<HTMLElement>('.va-card')];
    const sections = [...document.querySelectorAll<HTMLElement>('.va-section')];
    function filter() {
      const q = search.value.trim().toLocaleLowerCase('ru');
      const active = !!(q || mode.value !== 'all' || cost.value || duration.value);
      let visible = 0;
      for (const c of cards) {
        c.hidden = !!(q && !c.dataset.name?.includes(q)) || (mode.value !== 'all' && c.dataset.visa !== mode.value)
          || !!(cost.value && c.dataset.cost !== cost.value && !(cost.value === 'cheap' && c.dataset.cost === 'free'))
          || !!(duration.value && c.dataset.durationLong !== '1');
        if (!c.hidden) visible++;
      }
      for (const s of sections) s.hidden = ![...s.querySelectorAll<HTMLElement>('.va-card')].some((c) => !c.hidden);
      count.hidden = !active;
      const selected = [search.value.trim(), mode.value !== 'all' ? mode.selectedOptions[0]?.text : '', cost.value ? cost.selectedOptions[0]?.text : '', duration.value ? '60+ дней' : ''].filter(Boolean);
      count.textContent = `Найдено: ${visible}${selected.length ? ` · ${selected.join(' · ')}` : ''}`;
      empty.hidden = visible > 0;
      reset.hidden = !active;
      clear.hidden = !q;
      const params = new URLSearchParams();
      if (q) params.set('q', search.value.trim());
      if (mode.value !== 'all') params.set('visa', mode.value);
      if (cost.value) params.set('cost', cost.value);
      if (duration.value) params.set('dur', duration.value);
      const qs = params.toString();
      history.replaceState(null, '', `${location.pathname}${qs ? `?${qs}` : ''}${location.hash}`);
    }
    const params = new URLSearchParams(location.search);
    const choose = (el: HTMLSelectElement, value: string | null) => { if ([...el.options].some((o) => o.value === value)) el.value = value!; };
    search.value = params.get('q') ?? '';
    choose(mode, params.get('visa'));
    choose(cost, params.get('cost'));
    choose(duration, params.get('dur'));
    if (cost.value || duration.value) document.querySelector<HTMLDetailsElement>('.va-extra')!.open = true;
    form.addEventListener('input', filter);
    form.addEventListener('change', filter);
    form.addEventListener('submit', (e) => { e.preventDefault(); filter(); });
    form.addEventListener('reset', () => { search.value = ''; mode.value = 'all'; cost.value = ''; duration.value = ''; filter(); });
    clear.addEventListener('click', () => { search.value = ''; filter(); search.focus(); });
    filter();
  }
</script>
<style>
  .visa-archive { max-width: 1200px; margin: 0 auto; padding: 1.4rem clamp(1.1rem, 3vw, 2.6rem) 3rem; color: #15171a; }
  h1, h2, h3 { font-family: 'Old Standard TT', Georgia, serif; text-align: left; text-transform: none; letter-spacing: normal; }
  h1 { font-size: clamp(2.1rem, 4.5vw, 3.7rem); line-height: 1.08; margin: 0 0 .7rem; }
  h2 { font-size: clamp(1.65rem, 3vw, 2.35rem); line-height: 1.15; margin: 0 0 .45rem; }
  h3 { font-size: clamp(1.35rem, 2.3vw, 1.8rem); line-height: 1.15; margin: 0 0 .35rem; }
  p { line-height: 1.55; }
  .va-lead { max-width: 64ch; margin: 0 0 1.25rem; color: #5c626b; }
  .va-tool { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); gap: .6rem 1rem; padding-bottom: 1rem; }
  .va-tool label { display: block; font: 500 .9rem / 1.4 'Golos Text', sans-serif; }
  .va-search-field { display: flex; border-bottom: 1px solid #15171a; }
  input, select, button { font: inherit; color: #15171a; border-radius: 0; }
  #visaSearch { min-width: 0; width: 100%; min-height: 48px; border: 0; background: transparent; padding: .4rem 0; font-size: 1.1rem; }
  #visaSearch::placeholder { color: #5c626b; font-style: normal; }
  #visaSearchClear { width: 44px; flex-shrink: 0; border: 0; background: transparent; font-size: 1.4rem; }
  select { width: 100%; min-height: 48px; margin-top: .1rem; border: 1px solid #d9dbde; background: #fbfbfa; padding: .45rem .65rem; }
  .va-extra { grid-column: 1 / -1; }
  .va-extra summary { width: fit-content; min-height: 44px; align-content: center; color: #1d40ae; cursor: pointer; }
  .va-extra-fields { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; padding: .4rem 0; }
  #visaReset { justify-self: start; border: 0; border-bottom: 1px solid #1d40ae; color: #1d40ae; background: transparent; padding: 0; min-height: 44px; cursor: pointer; }
  #visaFilterCount { grid-column: 1 / -1; margin: 0; color: #5c626b; font-size: .9rem; }
  .va-section, .va-money-row, .va-faq, .va-related, .va-foot { border-top: 1px solid #d9dbde; padding: 1.5rem 0; }
  .va-section-head { margin-bottom: 1.15rem; }
  .va-section-head p { color: #5c626b; margin: 0; }
  .va-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 2rem; }
  .va-card { display: grid; grid-template-columns: 34% minmax(0, 1fr); gap: 1.1rem; padding: 1rem 0; border-bottom: 1px solid #d9dbde; color: inherit; text-decoration: none; align-items: start; min-width: 0; }
  .va-card img { width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; }
  .va-card-body { min-width: 0; }
  .va-card-mode { color: #1d40ae; font-size: .9rem; margin: 0 0 .25rem; }
  .va-card-stay { font-size: .95rem; margin: 0 0 .7rem; }
  .va-card-link { display: inline-block; font-size: .85rem; text-decoration: underline; text-underline-offset: .2em; }
  .va-card:hover h3 { color: #1d40ae; }
  .va-money-row p, .va-foot p { max-width: 64ch; color: #5c626b; }
  .va-money-row a { display: inline-flex; align-items: center; min-height: 44px; margin-right: 1.5rem; }
  .va-faq { max-width: 70ch; }
  .va-faq details { border-bottom: 1px solid #d9dbde; }
  .va-faq summary { min-height: 44px; align-content: center; padding: .65rem 0; font-weight: 600; cursor: pointer; }
  .va-related ul { padding-left: 1.2rem; margin: .6rem 0 0; }
  .va-related a { display: inline-flex; align-items: center; min-height: 44px; }
  a { text-underline-offset: .2em; }
  :is(a, button, input, select, summary):focus-visible { outline: 2px solid #1d40ae; outline-offset: 4px; }
  [hidden] { display: none !important; }
  @media (max-width: 767px) { .va-grid { grid-template-columns: 1fr; } }
  @media (max-width: 600px) {
    .va-tool { grid-template-columns: 1fr; gap: .4rem; }
    .va-mode { display: grid; grid-template-columns: auto minmax(0, 1fr); align-items: center; gap: .7rem; }
    .va-card { grid-template-columns: 100px minmax(0, 1fr); gap: 1rem; }
    .va-card img { aspect-ratio: 1 / 1; }
    .va-section, .va-money-row, .va-faq, .va-related { padding-block: 1.1rem; }
  }
  @media (max-width: 380px) { .va-extra-fields { grid-template-columns: 1fr; } }
</style>
