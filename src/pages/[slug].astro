  .om-practice :global(img) { width: 100%; height: 300px; object-fit: cover; display: block; }
  /* Левый кадр тянется на высоту двух правых, как на Омане. Без процентных высот внутри
     сетки: Safari считает их от всей фигуры, и подпись ложится поверх кадра. Фигура —
     flex-колонка, кадр заполняет остаток абсолютным позиционированием. */
  .om-tall { display: flex; flex-direction: column; }
