---
// Краткий hub для каждой страны: /<slug>/
// «Если коротко» — visa + сезоны + бюджет + связанные посты + FAQ.
//
// Pattern: /japan/ и /antarctica/ (вручную написанные хабы) служат
// эталоном. Этот файл генерирует аналогичные страницы для всех остальных
// направлений автоматически из DIRECTIONS data.
//
// URL conflicts: /japan/, /antarctica/ и /oman/ — explicit static pages в Astro
// перебивают dynamic [slug]. Они исключены из getStaticPaths.

import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import DestinationTabs from '../components/DestinationTabs.astro';
import { Image, getImage } from 'astro:assets';
import { DIRECTIONS, MONTHS, VISITED } from '../data/directions.js';
import { PRICES } from '../data/prices.js';
import { getVisaDetails } from '../data/visa-details.js';
import { getHubSnippet } from '../data/hub-snippets.js';
import { DATA_UPDATED, DATA_UPDATED_RU } from '../data/meta.js';
import { newsForCountry, newsUrl, formatDateRu } from '../data/news.js';
import AviasalesWidget from '../components/post/AviasalesWidget.astro';
import StickyCta from '../components/StickyCta.astro';
import BudgetBlock from '../components/BudgetBlock.astro';
import EssentialsCard from '../components/EssentialsCard.astro';
import YearClimateChart from '../components/YearClimateChart.astro';
import MonthlyEvents from '../components/MonthlyEvents.astro';
import ClimateChart from '../components/ClimateChart.astro';
import CountryMap from '../components/CountryMap.astro';
import { countryPhotos } from '../data/country-photos.js';
import { TP_LINKS, aviasalesRoute, otelloStay, cherehapaCountry, ostrovokCountry, youtravelCountry, kiwitaxiRoute, sputnik8City, mirturbazRegion } from '../data/affiliate.js';
import livePrices from '../data/prices-cache.json';

// РФ-инвентарь жилья: на этих хабах вместо Островка — Яндекс Путешествия (сильнее по РФ).
// Подпись к связанному гайду должна отражать РЕАЛЬНЫЙ sourceType статьи:
// «личный опыт автора» под compilation-гайдом — ложное заявление об опыте
// (бьёт по E-E-A-T и просто неправда). Берём тип из самой статьи.
const _posts = await getCollection('blog');
const POST_SOURCE = Object.fromEntries(_posts.map(p => [p.slug, p.data.sourceType]));

const RU_STAY = new Set(['abkhazia', 'kamchatka', 'karelia', 'dagestan', 'altai']);
// Направления, где самостоятельные ездят за рулём — аренда авто как отдельный блок.
// Пакетный интент (чартер+отель): рядом с авторскими турами — сравнение пакетных.
import { similarDestinations } from '../data/similar.js';
import { COMPARE_PAIRS } from '../data/compare-pairs.js';
import { getGuide } from '../data/country-guides.js';
import { buildEssentialsFaq } from '../data/essentials-faq.js';
import { hasEssentials } from '../data/country-essentials.js';
import { hasCustoms } from '../data/country-customs.js';
import { hasHolidays } from '../data/country-holidays.js';
import { hasPois } from '../data/country-pois.js';
import { typo } from '../utils/typo.js';
import { climateChart } from '../data/country-climate-chart.js';
import { PLUG_TYPES } from '../data/country-plug-types.js';
import author from '../assets/author/nikita.jpg';

// Pre-import all destination photos (Vite needs static imports). glob lazy:
const destPhotos = import.meta.glob('../assets/destinations/*.jpg', {
  eager: true,
  import: 'default',
});
// Inline-фото гайда (Я.Диск, «был лично») — отдельная папка от обложек.
const inlinePhotos = import.meta.glob('../assets/destinations/inline/*.jpg', {
  eager: true,
  import: 'default',
});

export async function getStaticPaths() {
  // Reserved slugs — те что уже есть как кастомные pages.
  const reserved = new Set([
    'japan', 'antarctica', 'oman',
    'blog', 'about', 'calculator', 'seasons', 'cards', 'trips', 'visa',
    '404', 'rss.xml', 'sitemap-images.xml', 'dzen-rss.xml',
  ]);
  return DIRECTIONS
    .filter(d => !reserved.has(d.slug))
    .map(d => ({ params: { slug: d.slug }, props: { d } }));
}

const { d } = Astro.props;
const yr = new Date().getFullYear();

// Свежие заметки об этом направлении. Связь идёт по стране, проставленной у
// заметки. Смысл блока — не «новости ради новостей»: хаб получает регулярно
// обновляемый кусок, а заметка — переход на страницу, которая уже ранжируется.
const countryNews = newsForCountry(await getCollection('news'), d.slug, 3);
// «Похожие направления» — превращает чтение одной страны в сессию из нескольких
// (глубина/dwell/last-click = ПФ + показы партнёрских CTA). Матч по визе/бюджету/вайбу/сезону.
const similar = similarDestinations(d.slug, 3);
const url = `https://traveltribe.ru/${d.slug}/`;

// Готовый разбор пары для /compare/ — только если курировано в compare-pairs.js
// (не создаём выдуманную ссылку на несуществующую страницу).
const comparePairDef = COMPARE_PAIRS.find((p) => p.a === d.slug || p.b === d.slug);
const compareOtherSlug = comparePairDef && (comparePairDef.a === d.slug ? comparePairDef.b : comparePairDef.a);
const compareOther = compareOtherSlug && DIRECTIONS.find((x) => x.slug === compareOtherSlug);
const compareUrl = comparePairDef ? `/compare/${comparePairDef.a}-vs-${comparePairDef.b}/` : `/compare/?a=${d.slug}`;

// Resolve cover photo if downloaded
const coverPath = `../assets/destinations/${d.slug}.jpg`;
const coverImage = destPhotos[coverPath];

// Hero LCP: ширины + responsive-preload (imagesrcset совпадает с <Image>, иначе
// браузер скачает не тот вариант). 768w добавлен под мобайл (раньше тянул 1024w).
const HERO_WIDTHS = [512, 768, 1024, 1600];
const heroPreload = coverImage
  ? await getImage({ src: coverImage, widths: HERO_WIDTHS, formats: ['webp'], quality: 72 })
  : null;

// Расширенный гайд (если заполнен в country-guides.js) — иначе базовый хаб
const guide = getGuide(d.slug);

// Inline-фото гайда, привязанные к секции (поле after). Возвращает
// разрешённый ассет + подпись для вставки сразу после нужного блока.
const photosAfter = (key) =>
  (guide?.photos || [])
    .filter((p) => p.after === key)
    .map((p) => ({ ...p, img: inlinePhotos[`../assets/destinations/inline/${p.file}.jpg`] }))
    .filter((p) => p.img);

const VISA_LABEL = { free: 'Без визы', evisa: 'eVisa', required: 'Виза обязательна' };
const BUDGET_LABEL = {
  low: '$ — до $80/день',
  mid: '$$ — $80–250/день',
  high: '$$$ — от $250/день',
};
const VISA_SUMMARY = {
  free: `${d.cases.nom} даёт россиянам безвизовый въезд (обычно 30–90 дней по загранпаспорту).`,
  evisa: `Для въезда ${d.cases.vP} россиянам нужна eVisa — оформляется онлайн до вылета, без посольства.`,
  required: `Для поездки ${d.cases.vP} нужна полноценная виза. Оформляется через визовый центр или посольство.`,
};
// Реальные верифицированные визовые специфики на страну (visa-details.js)
const vd = getVisaDetails(d.slug, d.visa);
// Никита был здесь лично? (E-E-A-T-сигнал в шапке; список — VISITED в directions.js)
const visited = VISITED.has(d.slug);
// Постраничная атрибуция кликов в кабинете TP (только латиница/цифры/_).
const subId = 'hub_' + d.slug.replaceAll('-', '_');
// Трансфер считаем один раз: помощник возвращает адрес и подпись с конкретным маршрутом
// либо null там, где маршрут у партнёра не проверен.
const трансфер = kiwitaxiRoute(d.slug, subId);

// Best months for this destination
const rank = { P: 4, G: 3, O: 2, B: 1, X: 0 };
const monthsRanked = MONTHS
  .map((m, i) => ({ ...m, status: d.r[i], text: d.t[i], rank: rank[d.r[i]] || 0 }));
const bestMonths = monthsRanked.filter(m => m.rank >= 3).slice(0, 3);
const worstMonths = monthsRanked.filter(m => m.rank <= 1).slice(0, 2);

// ⛔ Цена перелёта берётся из ЖИВОЙ выгрузки, а не из прикидки в таблице цен.
// Замер 29.08.2026: 16 карточек стран из 51 обещали вдвое меньше реального —
// Грузия «от $100» при живом минимуме ≈$251, Мексика «от $550» при ≈$1062,
// Бали «от $400» при ≈$669. Человек кликал на обещанную цену, видел вдвое
// большую и уходил. На этой же цифре стоял и весь недельный бюджет.
// Курс — тот же, по которому собран справочник бюджетов (90 ₽ за доллар).
const КУРС = 90;
const живыеМесяцы = d.price?.iata ? Object.values(livePrices.prices[d.price.iata] ?? {}).filter(Boolean) : [];
const живойМинимум = живыеМесяцы.length ? Math.round(Math.min(...живыеМесяцы) / КУРС) : null;
const flightFrom = живойМинимум ?? d.price?.flight?.[0];
const hotelFrom = d.price?.hotel?.[0];
const foodFrom = d.price?.food?.[0];
const weekTotal = flightFrom ? flightFrom + (hotelFrom || 0) * 7 + (foodFrom || 0) * 7 : null;
// Индекс в PRICES для глубокой ссылки на калькулятор с преселекцией страны
const priceIdx = d.price ? PRICES.findIndex(p => p.iata === d.price.iata && p.name === d.price.name) : -1;
const calcUrl = priceIdx >= 0 ? `/calculator/?r=${priceIdx}` : '/calculator/';

// FAQ generated from data.
// ⛔ Визового вопроса здесь нет намеренно. До 04.09.2026 витрина и /visa/<страна>/
// клали в разметку один и тот же вопрос с одним и тем же текстом ответа, и Google
// не мог выбрать владельца: 64 запроса, 697 показов, ноль переходов на 30
// направлениях. Владелец визового интента — /visa/<страна>/. Витрина называет
// статус видимым текстом в капсуле и уводит ссылкой, но за ответ не борется.
const faqs = [
  {
    q: `Сколько стоит поездка ${d.cases.vP} в ${yr}?`,
    a: weekTotal
      ? `Эконом-вариант на 7 дней — от $${weekTotal} на человека (перелёт из Москвы $${flightFrom}, проживание от $${hotelFrom}/ночь, питание от $${foodFrom}/день). Бюджет на день: ${BUDGET_LABEL[d.budget]}.`
      : `Бюджет на день: ${BUDGET_LABEL[d.budget]}. Перелёт зависит от сезона и пересадок.`,
  },
  {
    q: `Когда лучше ехать ${d.cases.vP}?`,
    a: bestMonths.length
      ? `Лучшие месяцы: ${bestMonths.map(m => m.nom).join(', ')}. ${bestMonths[0]?.text || ''}`
      : `${d.cases.nom} имеет переменчивые сезоны — смотри помесячный календарь ниже.`,
  },
];
// Доп. вопросы из расширенного гайда — и в видимый FAQ, и в schema (AEO)
if (guide?.faq?.length) faqs.push(...guide.faq);

// FAQ из бытовой практики (розетки/чаевые/экстренные/вода/такси/таможня) —
// renders только если EssentialsCard/CustomsCard для slug заполнены.
const essVp = d.cases?.vP || `в ${d.cases?.loc || d.cases?.nom || ''}`;
if (hasEssentials(d.slug) || hasCustoms(d.slug)) {
  faqs.push(...buildEssentialsFaq(d.slug, essVp));
}

// Изображения для schema (обложка + inline-фото) — ImageObject с финальными URL.
const SITE = 'https://traveltribe.ru';
const schemaImages = [];
if (coverImage) schemaImages.push(coverImage);
for (const p of (guide?.photos || [])) {
  const im = inlinePhotos[`../assets/destinations/inline/${p.file}.jpg`];
  if (im) schemaImages.push(im);
}
const imageNodes = schemaImages.map((im) => ({
  "@type": "ImageObject",
  "url": `${SITE}${im.src}`,
  "width": im.width,
  "height": im.height,
}));

// Анти-каннибализация: страна с глубоким блог-гайдом (kind:'guide') — голову
// запроса «{страна} для россиян» отдаём гайду, хаб уводим на регионы/сезоны,
// чтобы две страницы не делили один интент. Без гайда хаб остаётся головным.
const deepGuide = d.relatedPosts?.find((p) => p.kind === 'guide');
// Пер-страновое переопределение сниппета (data/hub-snippets.js): формула одна на
// все направления, а спрос у стран разный — «когда ехать» у одних, «как добраться»
// у других. Переопределение бьёт формулу; страны без записи идут по формуле и
// служат контролем замера. H1, адрес и canonical оно не трогает.
const hubOverride = getHubSnippet(d.slug);
const hubTitle = hubOverride?.title ?? (deepGuide
  ? `${d.cases.nom} ${yr}: регионы, когда ехать и куда лететь`
  : `${d.cases.nom} ${yr} для россиян: когда ехать, цены, маршрут`);
// ⛔ Хвост включается, только если без него описание короче 100 знаков: у стран с
// коротким названием и одним-двумя лучшими месяцами выходило 92–99, и это ловил
// внешний аудит (21.08.2026). Хвост говорит, что на странице, а не добивает длину.
// ⛔ Потолок описания 200, а не 155 (21.08.2026). Google режет около 155–160 и
// показывает начало, Яндекс выводит до 250 — на его выдаче короткое описание просто
// теряет место. Суть держим в первых 150 знаках: тогда обрезка Google ничего не ломает.
const hubDescTail = ' Что посмотреть, сколько дней закладывать и когда дешевле.';
const hubDescBase = (deepGuide
  ? `${d.cases.nom}: регионы и куда лететь, когда ехать по месяцам${bestMonths.length ? ` — ${bestMonths.slice(0, 3).map((m) => m.nom).join(', ')}` : ''}, бюджет по сезонам. Полный гайд для россиян — отдельно.`
  : `${d.cases.nom} ${yr} для россиян: ${VISA_LABEL[d.visa].toLowerCase()} (${vd.duration}), когда ехать — ${bestMonths.map((m) => m.nom).join(', ')}, бюджет от $${weekTotal || 'N/A'}/нед.`);
const hubDesc = hubOverride?.description ?? (hubDescBase.length < 100 ? hubDescBase + hubDescTail : hubDescBase).slice(0, 200);
const hubOgTitle = deepGuide
  ? `${d.cases.nom} ${yr} — регионы, сезоны, куда лететь`
  : `${d.cases.nom} ${yr} — когда ехать, цены, маршрут`;

// ——— Макет Омана для всех стран (10.09.2026) ———
// Решение Никиты: «макет 1 в 1 как у Омана с данными каждой страны, ничего не выбрасывай».
// Всё ниже считается из тех же данных, что и раньше; ни одной строки руками.
const cc = climateChart(d.slug);
// Вода — у первого города графика, если источник её даёт.
const seaRow = cc?.cities?.[0]?.sea ? cc.cities[0] : null;
const plug = PLUG_TYPES[d.slug];
const cap = (s) => s.charAt(0).toUpperCase() + s.slice(1);
// Внутренние направления: для них «виза россиянам» — нелепость, раздел зовётся «Документы».
const DOMESTIC = new Set(['kamchatka', 'karelia', 'dagestan', 'altai']);
const domestic = DOMESTIC.has(d.slug);
const firstSentence = (s) => { const m = s.match(/^.+?[.!?](?=\s|$)/); return (m ? m[0] : s).trim(); };
// Лид — первая фраза вступления гайда; у стран без гайда — живая строка о лучшем
// месяце из тех же данных, что и полоса месяцев («Январь: +23 °C днём…»). Голое
// перечисление городов («Доха.») читалось как заглушка.
const лучший = bestMonths[0];
const lead = typo(guide?.intro ? firstSentence(guide.intro)
  : лучший?.text ? `${cap(лучший.nom)}: ${лучший.text.replace(/\.$/, '')}.`
  : `${d.sub}.`);
const inline = (guide?.photos || [])
  .map((p) => ({ ...p, img: inlinePhotos[`../assets/destinations/inline/${p.file}.jpg`] }))
  .filter((p) => p.img);
// Кадры страны по слотам макета Омана: широкий после событий по месяцам и три в разделе
// въезда. Подпись «Фотографии: …» собирается из тех же записей о лицензии, по которым
// кадр прошёл проверку происхождения; свой кадр подписи не требует.
const hubImageFiles = import.meta.glob('../content/blog/_images/**/*.{jpg,jpeg,webp}', { import: 'default' });
const hubCredits = import.meta.glob('../content/blog/_images/**/_credits.json', { eager: true, import: 'default' });
const фотоСтраны = countryPhotos(d.slug);
const сКадром = async (p) => {
  const load = hubImageFiles[`../content/blog/_images/${p.file}`];
  if (!load) throw new Error(`Кадр страницы ${d.slug} не найден: ${p.file}`);
  return { ...p, img: await load() };
};
const широкий = фотоСтраны ? await сКадром(фотоСтраны.wide) : null;
const практика = фотоСтраны ? await Promise.all(фотоСтраны.practice.map(сКадром)) : [];
const семьяЛицензии = (l) => (/pixabay/i.test(l) ? 'Pixabay' : /^CC BY-SA/i.test(l) ? 'CC BY-SA' : /^CC BY/i.test(l) ? 'CC BY' : /^CC0/i.test(l) ? 'CC0' : l);
const авторы = new Map();
for (const p of [широкий, ...практика].filter(Boolean)) {
  const cut = p.file.lastIndexOf('/');
  const записи = hubCredits[`../content/blog/_images/${p.file.slice(0, cut)}/_credits.json`] || {};
  const имя = p.file.slice(cut + 1);
  const rec = записи[имя.replace(/\.\w+$/, '')] || записи[имя];
  if (!rec?.creator) continue;
  const lic = семьяЛицензии(rec.license || '');
  авторы.set(lic, [...new Set([...(авторы.get(lic) || []), rec.creator])]);
}
const фотоКредиты = авторы.size ? `Фотографии: ${[...авторы].map(([lic, who]) => `${who.join(', ')} (${lic})`).join('; ')}.` : '';
// Партнёрские ссылки — с ТЕМИ ЖЕ метками, что были: замер 20.09 сравнивает периоды,
// и смена меток посередине разорвала бы ряд.
const билеты = d.price?.iata ? aviasalesRoute('MOW', d.price.iata, subId) : null;
const жильё = RU_STAY.has(d.slug) ? otelloStay(`hub_${d.slug}`) : ostrovokCountry(d.slug, `hub_${d.slug}`);
const полис = cherehapaCountry(d.slug, `hub_${d.slug}`);
const тур = youtravelCountry(d.slug, `hub_${d.slug}`);
const экскурсии = sputnik8City(d.slug, subId);
const базы = mirturbazRegion(d.slug, subId);
// Значение визы в карточке — короткое: длинные сроки вида «15/30/90 дн = €30/35/40»
// рвутся по косой черте, это Никита уже снимал на Омане («90/» и «год)» на разных строках).
const срок = vd.duration && !vd.duration.includes('/') ? vd.duration.split(' (')[0] : '';
const визаКоротко = typo(domestic ? 'паспорт РФ'
  : d.visa === 'free' ? `не нужна${срок ? `, до ${срок}` : ''}`
  : d.visa === 'evisa' ? 'eVisa онлайн'
  : 'нужна заранее');
const бюджетКоротко = BUDGET_LABEL[d.budget].split('—')[1]?.trim().replace('/день', '') || BUDGET_LABEL[d.budget];
// Заголовок держит обе формулировки спроса: «когда ехать в X» — прежний заголовок
// раздела, и «погода по месяцам» — запрос, по которому страницы стран показываются.
const погодаH2 = `Когда ехать ${d.cases.vP}${seaRow ? ' и когда купаться' : ''}: погода по месяцам`;
// ⛔ Не «Нужна ли виза…»: владелец визового запроса — /visa/<страна>/ (решение 04.09.2026,
// 64 запроса, 697 показов и ноль переходов, когда хаб и визовая страница делили вопрос).
const визаH2 = domestic ? 'Документы и правила' : 'Въезд, деньги и связь';
const МЕС_П = ['январе', 'феврале', 'марте', 'апреле', 'мае', 'июне', 'июле', 'августе', 'сентябре', 'октябре', 'ноябре', 'декабре'];
// Про воду — без «с ноября по апрель»: для Австралии, ЮАР и Аргентины это лето.
const морскаяФраза = seaRow ? (() => {
  const s = seaRow.sea; const lo = Math.min(...s), hi = Math.max(...s);
  return typo(`Вторая строка в клетках — вода у ${seaRow.name === 'Салала' ? 'Салалы' : 'берега'}: от ${Math.round(lo)} °C в ${МЕС_П[s.indexOf(lo)]} до ${Math.round(hi)} °C в ${МЕС_П[s.indexOf(hi)]}.`);
})() : '';
const разделов = (n) => (n % 10 === 1 && n % 100 !== 11 ? 'раздел' : n % 10 >= 2 && n % 10 <= 4 && (n % 100 < 12 || n % 100 > 14) ? 'раздела' : 'разделов');
const tocItems = [
  (guide?.intro || guide?.highlights?.length) && { id: 'zachem', t: `Зачем ехать ${d.cases.vP}` },
  { id: 'pogoda', t: погодаH2 },
  hasHolidays(d.slug) && { id: 'sobytiya', t: 'События по месяцам' },
  guide?.itinerary?.length && { id: 'marshrut', t: 'Маршрут на 7–10 дней' },
  hasPois(d.slug) && { id: 'mesta', t: 'Где смотреть' },
  (guide?.getThere || guide?.compare?.options?.length || (RU_STAY.has(d.slug) && трансфер)) && { id: 'doroga', t: `Как добраться ${d.cases.vP}` },
  (guide?.stay?.length || RU_STAY.has(d.slug)) && { id: 'zhile', t: 'Где остановиться' },
  { id: 'dengi', t: `Сколько стоит поездка ${d.cases.vP}` },
  { id: 'viza', t: визаH2 },
  (plug || hasEssentials(d.slug) || hasCustoms(d.slug)) && { id: 'na-meste', t: 'Что нужно знать на месте' },
  { id: 'sbory', t: `Что взять ${d.cases.vP}` },
  { id: 'faq', t: `FAQ: что чаще спрашивают про ${d.cases.acc}` },
].filter(Boolean);

const ldJson = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": `${url}#page`,
      "url": url,
      "name": hubTitle,
      "description": hubDesc,
      "inLanguage": "ru-RU",
      "isPartOf": { "@id": "https://traveltribe.ru/#website" },
      "about": { "@type": "Country", "name": d.cases.nom },
      ...(imageNodes.length ? { "image": imageNodes, "primaryImageOfPage": imageNodes[0] } : {}),
      "datePublished": "2026-04-30",
      "dateModified": DATA_UPDATED,
      "author": { "@id": "https://traveltribe.ru/about/#person" },
      "publisher": { "@id": "https://traveltribe.ru/#org" },
      "speakable": { "@type": "SpeakableSpecification", "cssSelector": ["h1", ".om-lead", ".om-facts"] },
      "mainEntity": { "@id": `${url}#faq` }
    },
    {
      "@type": "FAQPage",
      "@id": `${url}#faq`,
      "mainEntity": faqs.map(f => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": { "@type": "Answer", "text": f.a }
      }))
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Главная", "item": "https://traveltribe.ru/" },
        { "@type": "ListItem", "position": 2, "name": "Страны", "item": "https://traveltribe.ru/countries/" },
        { "@type": "ListItem", "position": 3, "name": d.cases.nom, "item": url },
      ]
    }
  ]
};
// Маршрут как ItemList (AEO: структурированные шаги гайда)
if (guide?.itinerary?.length) {
  ldJson["@graph"].push({
    "@type": "ItemList",
    "@id": `${url}#itinerary`,
    "name": `Маршрут — ${d.cases.nom}, 7–10 дней`,
    "itemListElement": guide.itinerary.map((s, i) => ({
      "@type": "ListItem", "position": i + 1, "name": s.t, "description": s.d,
    })),
  });
}
---
<Layout
  title={hubTitle}
  description={hubDesc}
  canonical={url}
  ogTitle={hubOgTitle}
  ogDescription={`${VISA_LABEL[d.visa]} · бюджет ${BUDGET_LABEL[d.budget].split('—')[0].trim()} · лучшие месяцы: ${bestMonths.slice(0,2).map(m => m.nom).join(', ')}`}
  ogType="article"
  ldJson={ldJson}
  preloadImageSrcset={heroPreload?.srcSet?.attribute}
  preloadImageSizes="100vw"
  monetizationDestination={d.slug}
>
  <main id="main" class="om">
    <Breadcrumbs crumbs={[{ label: 'Страны', href: '/countries/' }, { label: d.cases.nom }]} />

    {coverImage && (
      <figure class="om-hero">
        <Image src={coverImage} alt={d.cases.nom} widths={HERO_WIDTHS} sizes="100vw" formats={['webp']} quality={72} loading="eager" fetchpriority="high" />
      </figure>
    )}

    <header class="om-top">
      <div class="om-title">
        <h1>{d.cases.nom} <span class="om-yr">{yr}</span></h1>
        <p class="om-lead">{lead}</p>
      </div>
      <div class="om-answer">
        <dl class="om-facts">
          <div><dt>{domestic ? 'Документы' : 'Виза россиянам'}</dt><dd>{визаКоротко}</dd></div>
          <div><dt>Лучшие месяцы</dt><dd>{bestMonths.length ? bestMonths.map((m) => m.nom).join(', ') : 'круглый год'}</dd></div>
          <div><dt>Бюджет в день</dt><dd>{бюджетКоротко}</dd></div>
          {flightFrom && <div><dt>Перелёт из Москвы</dt><dd>от ${flightFrom}</dd></div>}
          {weekTotal && <div><dt>Неделя на одного</dt><dd>от ${weekTotal}</dd></div>}
        </dl>
        {билеты && flightFrom && (
          <a class="om-btn" href={билеты} rel="sponsored nofollow noopener" target="_blank">Билеты {d.cases.vP} от ${flightFrom}</a>
        )}
      </div>
      <div class="om-byline">
        <Image src={author} alt="Никита Зайцев" width={52} height={64} format="webp" quality={80} />
        <p><a href="/about/">Никита Зайцев</a>, автор traveltribe.ru{visited ? '. Был здесь сам' : ''}.</p>
      </div>
    </header>

    <DestinationTabs d={d} active="hub" />

    {/* Оглавление: сразу под шапкой, в теле страницы, пункты слово в слово как
        заголовки разделов (NN/g, Tables of Contents). Разделы открыты целиком —
        Google даёт ссылки-переходы к разделам только на видимый при загрузке текст.
        Компактно (замечание Никиты 10.09.2026: «крайне много занимает места»): на
        широком экране пункты идут строкой через точку — NN/g советует горизонтальную
        раскладку для коротких заголовков; на телефоне список свёрнут в одну строку над
        содержимым — так делают PatternFly и Red Hat. Не липкий: NN/g видел, что липкое
        свёрнутое оглавление на телефоне люди не замечают. */}
    <nav class="om-toc" aria-label="На этой странице">
      <details id="om-toc" open>
        <summary class="om-toc-h">На этой странице <span class="om-toc-n">{tocItems.length} {разделов(tocItems.length)}</span></summary>
        <ol>
          {tocItems.map((it) => (<li><a href={`#${it.id}`}>{it.t}</a></li>))}
        </ol>
      </details>
      <script is:inline>(function () { var t = document.getElementById('om-toc'); if (t && window.matchMedia('(max-width: 900px)').matches) t.open = false; })();</script>
    </nav>

    {deepGuide && (
      <p class="om-body om-linkline om-guide"><a href={`/blog/${deepGuide.slug}/`}>Полный гайд: {deepGuide.title}</a></p>
    )}

    {(guide?.intro || guide?.highlights?.length > 0) && (
      <section class="om-sec" id="zachem">
        <h2>Зачем ехать {d.cases.vP}</h2>
        {guide.intro && <p class="om-body">{typo(guide.intro)}</p>}
        {inline.length >= 2 ? (
          <div class="om-pair">
            {inline.slice(0, 2).map((p) => (
              <figure>
                <Image src={p.img} alt={p.alt} widths={[400, 592, 900]} sizes="(max-width: 900px) 100vw, 592px" formats={['webp']} quality={78} loading="lazy" />
                <figcaption>{typo(p.caption)}</figcaption>
              </figure>
            ))}
          </div>
        ) : photosAfter('highlights').map((p) => (
          <figure class="om-figure">
            <Image src={p.img} alt={p.alt} widths={[640, 1024, 1520]} sizes="(max-width: 800px) 100vw, 760px" formats={['webp']} quality={72} loading="lazy" />
            <figcaption>{typo(p.caption)}</figcaption>
          </figure>
        ))}
        {guide.highlights?.length > 0 && (
          <>
            <h3>Главные впечатления</h3>
            <ul class="om-list">
              {guide.highlights.map((h) => <li><b>{h.t}</b>{typo(` — ${h.d}`)}</li>)}
            </ul>
          </>
        )}
        {экскурсии && (
          <p class="om-body om-linkline"><a href={экскурсии} rel="sponsored noopener" target="_blank">Экскурсии {d.cases.loc} с местными гидами</a> <span class="om-dim">расписание и отзывы видно до оплаты</span></p>
        )}
        {guide.authorNote && <p class="om-note">{typo(guide.authorNote)}</p>}
      </section>
    )}

    <section class="om-sec" id="pogoda">
      <h2>{погодаH2}</h2>
      <p class="om-body">{typo(`Лучшие месяцы — ${bestMonths.map((m) => m.nom).join(', ') || '—'}${worstMonths.length ? `; хуже всего — ${worstMonths.map((m) => m.nom).join(', ')}` : ''}.`)}</p>
      <YearClimateChart slug={d.slug} />
      <div class="om-heat">
        {monthsRanked.map((m, i) => {
          const cls = m.status === 'P' ? 'peak' : m.status === 'G' ? 'good' : m.status === 'O' ? 'off' : m.status === 'B' ? 'bad' : 'closed';
          return (
            <a href={`/trips/${m.slug}/${d.slug}/`} class={`om-mh om-mh--${cls}`} title={seaRow ? `${m.text || m.nom}. Вода — ${Math.round(seaRow.sea[i])} °C` : (m.text || m.nom)}>
              <span>{cap(m.nom).slice(0, 3)}</span>
              {seaRow && <small>{Math.round(seaRow.sea[i])}°</small>}
            </a>
          );
        })}
      </div>
      <div class="om-legend">
        <span><i class="om-mh--peak"></i>пик</span>
        <span><i class="om-mh--good"></i>хорошо</span>
        <span><i class="om-mh--off"></i>нормально</span>
        <span><i class="om-mh--bad"></i>не сезон</span>
        <span><i class="om-mh--closed"></i>закрыто</span>
      </div>
      {seaRow && <p class="om-body om-sea">{морскаяФраза}</p>}
      <ClimateChart slug={d.slug} countryNom={d.cases.vP} />
      <ul class="om-months">
        {monthsRanked.map((m) => (<li><b>{cap(m.nom)}</b>{typo(` — ${m.text || '—'}`)}</li>))}
      </ul>
    </section>

    <div id="sobytiya" class="om-embed">
      <MonthlyEvents slug={d.slug} countryNom={d.cases.nom} countryNameVp={essVp} />
    </div>

    {/* width — размер запасного src для тех, кто не читает srcset: без него Astro отдаёт
        оригинал в 1920 px, и детальный кадр весит больше мегабайта (проверка SEO сайта
        не пускает файлы тяжелее 800 КБ). */}
    {широкий && (
      <figure class="om-wide">
        <Image src={широкий.img} alt={широкий.alt} width={Math.min(1800, широкий.img.width)} widths={[800, 1200, 1800]} sizes="100vw" formats={['webp']} quality={78} loading="lazy" />
        <figcaption>{typo(широкий.caption)}</figcaption>
      </figure>
    )}

    {guide?.itinerary?.length > 0 && (
      <section class="om-sec" id="marshrut">
        <h2>Маршрут на 7–10 дней</h2>
        <ol class="om-steps">
          {guide.itinerary.map((s) => (<li><b>{s.t}.</b>{typo(` ${s.d}`)}</li>))}
        </ol>
        {inline.length < 2 && photosAfter('itinerary').map((p) => (
          <figure class="om-figure">
            <Image src={p.img} alt={p.alt} widths={[640, 1024, 1520]} sizes="(max-width: 800px) 100vw, 760px" formats={['webp']} quality={72} loading="lazy" />
            <figcaption>{typo(p.caption)}</figcaption>
          </figure>
        ))}
      </section>
    )}

    <div id="mesta" class="om-embed">
      <CountryMap slug={d.slug} countryNom={d.cases.nom} />
    </div>

    {(guide?.getThere || guide?.compare?.options?.length > 0 || (RU_STAY.has(d.slug) && трансфер)) && (
      <section class="om-sec" id="doroga">
        <h2>Как добраться {d.cases.vP}</h2>
        {guide?.getThere && <p class="om-body">{typo(guide.getThere)}</p>}
        {guide?.getThere && !guide.compare && !guide.noFlightCta && билеты && flightFrom && (
          <div class="om-cta-row">
            <a href={билеты} class="om-btn" rel="sponsored noopener" target="_blank">Сравнить билеты Москва — {d.cases.nom} от ${flightFrom}</a>
            <span class="om-dim">оплата картами РФ</span>
          </div>
        )}
        {трансфер && (
          <p class="om-body om-linkline"><a href={трансфер.href} rel="sponsored noopener" target="_blank">{трансфер.label} — цена фиксируется при заказе</a> <span class="om-dim">водитель встречает с табличкой · 90 минут ожидания при задержке рейса</span></p>
        )}
        {guide?.compare?.options?.length > 0 && (
          <>
            <h3>{guide.compare.title}</h3>
            {guide.compare.intro && <p class="om-body">{typo(guide.compare.intro)}</p>}
            <div class="om-comp">
              {guide.compare.options.map((o) => (
                <div class="om-cc">
                  <p class="om-cc-name">{o.name}</p>
                  {o.sub && <p class="om-cc-sub">{o.sub}</p>}
                  <p class="om-cc-for">{typo(o.for)}</p>
                  <a class="om-link" href={o.flightIata ? aviasalesRoute('MOW', o.flightIata, subId) : o.href} rel="sponsored noopener" target="_blank">{o.ctaLabel}</a>
                </div>
              ))}
            </div>
          </>
        )}
      </section>
    )}

    {(guide?.stay?.length > 0 || RU_STAY.has(d.slug)) && (
      <section class="om-sec" id="zhile">
        <h2>Где остановиться</h2>
        {guide?.stay?.length > 0 && (
          <ul class="om-list">
            {guide.stay.map((s) => <li><b>{s.t}</b>{typo(` — ${s.d}`)}</li>)}
          </ul>
        )}
        <p class="om-body om-linkline"><a href={жильё} rel="sponsored noopener" target="_blank">{RU_STAY.has(d.slug) ? `Подобрать жильё ${d.cases.loc}` : `Подобрать отель ${d.cases.loc}`}</a> <span class="om-dim">{RU_STAY.has(d.slug) ? 'оплата российскими картами · цены и отзывы видно до оплаты' : 'оплата российскими картами · цены в ₽'}</span></p>
        {базы && (
          <p class="om-body om-linkline"><a href={базы} rel="sponsored noopener" target="_blank">Базы отдыха и дома у воды {d.cases.loc}</a> <span class="om-dim">формат, которого нет у отельных агрегаторов</span></p>
        )}
      </section>
    )}

    {RU_STAY.has(d.slug) && !guide?.highlights?.length && экскурсии && (
      <section class="om-sec" id="posmotret">
        <h2>Что посмотреть</h2>
        <p class="om-body om-linkline"><a href={экскурсии} rel="sponsored noopener" target="_blank">Экскурсии {d.cases.loc} с местными гидами</a> <span class="om-dim">расписание, отзывы и цена видны до оплаты</span></p>
      </section>
    )}

    <section class="om-sec" id="dengi">
      <h2>Сколько стоит поездка {d.cases.vP}</h2>
      <div class="om-money">
        <div>
          {flightFrom && <p class="om-big">от ${flightFrom} <span class="om-small om-dim">перелёт из Москвы, в одну сторону</span></p>}
          <p class="om-body">{typo(`Бюджет в день — ${бюджетКоротко} на человека без перелёта.`)}</p>
          {билеты && (
            <div class="om-cta-row">
              <a class="om-btn" href={билеты} rel="sponsored nofollow noopener" target="_blank">Найти билеты</a>
            </div>
          )}
        </div>
        <div class="om-prices">
          {flightFrom && <div class="om-prow"><span>Перелёт, в одну сторону</span><span>от ${flightFrom}</span></div>}
          {hotelFrom && <div class="om-prow"><span>Жильё за ночь</span><span>от ${hotelFrom}</span></div>}
          {foodFrom && <div class="om-prow"><span>Еда в день</span><span>от ${foodFrom}</span></div>}
          {weekTotal && <div class="om-prow"><span>Неделя на одного</span><span>от ${weekTotal}</span></div>}
        </div>
      </div>
      <div class="om-money">
        <div>
          <h3>Жильё и страховка</h3>
          <div class="om-cta-row">
            <a class="om-btn om-btn-ghost" href={жильё} rel="sponsored nofollow noopener" target="_blank">{RU_STAY.has(d.slug) ? `Жильё ${d.cases.loc}` : `Отели ${d.cases.loc}`}</a>
            <a class="om-btn om-btn-ghost" href={полис} rel="sponsored nofollow noopener" target="_blank">Собрать полис</a>
          </div>
        </div>
        <div class="om-prices">
          <div class="om-prow"><span>Свой расчёт поездки</span><span><a href={calcUrl}>калькулятор</a></span></div>
          <div class="om-prow"><span>Что взять с собой</span><span><a href={`/packing/${d.slug}/`}>сборы {d.cases.vP}</a></span></div>
        </div>
      </div>
      {guide?.data?.length > 0 && (
        <>
          <h3>{d.cases.nom} в цифрах — {yr}</h3>
          <div class="om-visa om-rules">
            {guide.data.map((row) => (<div class="om-prow"><span>{row.k}</span><span>{typo(row.v)}</span></div>))}
          </div>
          {guide.dataNote && <p class="om-small om-dim">{typo(guide.dataNote)}</p>}
        </>
      )}
      <div class="om-embed">
        <BudgetBlock slug={d.slug} />
      </div>
      <AviasalesWidget origin="MOW" destination={d.price.iata} title={`Найти билеты — ${d.cases.vP}`} subid={subId} plain />
    </section>

    <section class="om-sec" id="gid">
      <h2>Поехать с экспертом</h2>
      <p class="om-body om-linkline"><a href={тур} rel="sponsored noopener" target="_blank">Авторские туры {d.cases.vP}</a> <span class="om-dim">маршрут, логистика и малая группа уже собраны</span></p>
    </section>

    <section class="om-sec" id="viza">
      <h2>{визаH2}</h2>
      <div class="om-visa">
        <div class="om-prow"><span>{domestic ? 'Документы' : 'Виза'}</span><span>{typo(domestic ? vd.timing : `${vd.cost}, ${vd.duration}`)}</span></div>
        {!domestic && <div class="om-prow"><span>Как оформляется</span><span>{typo(vd.timing)}</span></div>}
      </div>
      <p class="om-body">{typo(vd.summary ?? VISA_SUMMARY[d.visa])}</p>
      <p class="om-body om-linkline"><a href={`/visa/${d.slug}/`}>{domestic ? `Документы для поездки ${d.cases.vP}` : `Виза ${d.cases.vP}: документы, сроки и что проверить перед вылетом`}</a></p>
      {(guide?.practical?.length > 0 || plug) && (
        <>
          <h3>Правила и деньги</h3>
          <div class="om-visa om-rules">
            {(guide?.practical || []).map((s) => (<div class="om-prow"><span>{s.t}</span><span>{typo(s.d)}</span></div>))}
            {plug && <div class="om-prow"><span>Розетка</span><span>{typo(`тип ${plug.types}, ${plug.voltage}`)}</span></div>}
          </div>
          {guide?.practical?.length > 0 && (
            <p class="om-body om-linkline"><a href={полис} rel="sponsored noopener" target="_blank">Подобрать полис {d.cases.vP}</a> <span class="om-dim">{guide.insuranceNote || 'оплата картами РФ'}</span></p>
          )}
        </>
      )}
      {практика.length === 3 && (
        <div class="om-practice">
          <figure class="om-tall">
            <div class="om-fill"><Image src={практика[0].img} alt={практика[0].alt} width={Math.min(900, практика[0].img.width)} widths={[400, 592, 900]} sizes="(max-width: 900px) 100vw, 592px" formats={['webp']} quality={78} loading="lazy" /></div>
            <figcaption>{typo(практика[0].caption)}</figcaption>
          </figure>
          <div>
            {практика.slice(1).map((p) => (
              <figure class="om-inline">
                <Image src={p.img} alt={p.alt} width={Math.min(900, p.img.width)} widths={[400, 592, 900]} sizes="(max-width: 900px) 100vw, 592px" formats={['webp']} quality={78} loading="lazy" />
                <figcaption>{typo(p.caption)}</figcaption>
              </figure>
            ))}
          </div>
        </div>
      )}
    </section>

    <div id="na-meste" class="om-embed">
      <EssentialsCard slug={d.slug} countryName={d.cases.nom} />
    </div>

    <section class="om-sec" id="sbory">
      <h2>Что взять {d.cases.vP}</h2>
      <p class="om-body">{typo('Чек-лист по месяцам: одежда под погоду, документы, аптечка, техника, переходник.')}</p>
      <p class="om-body om-linkline"><a href={`/packing/${d.slug}/`}>Открыть чек-лист {d.cases.gen || d.cases.prep || d.cases.nom}</a></p>
    </section>

    <section class="om-sec" id="faq">
      <h2>FAQ: что чаще спрашивают про {d.cases.acc}</h2>
      <dl class="om-faq">
        {faqs.map((f) => (<><dt>{typo(f.q)}</dt><dd>{typo(f.a)}</dd></>))}
      </dl>
    </section>

    {d.relatedPosts.length > 0 && (
      <section class="om-sec" id="gaidy">
        <h2>Подробные гайды о {d.cases.prep}</h2>
        <ul class="om-related">
          {d.relatedPosts.map((p) => (
            <li>
              <a href={`/blog/${p.slug}/`}>{p.title}</a>
              <span>{p.kind === 'visa' ? 'про визу пошагово' : p.kind === 'season' ? 'про конкретный сезон' : p.kind === 'insurance' ? 'про страховку и полис'
                : (POST_SOURCE[p.slug] === 'personal' || POST_SOURCE[p.slug] === 'hybrid') ? 'личный опыт автора' : 'подробный разбор'}</span>
            </li>
          ))}
        </ul>
      </section>
    )}

    {countryNews.length > 0 && (
      <section class="om-sec" data-volatile="news">
        <h2>Свежее о {d.cases.prep}</h2>
        <ul class="om-related">
          {countryNews.map((n) => (
            <li><a href={newsUrl(n)}>{n.data.title}</a><span>{formatDateRu(n.data.date)}</span></li>
          ))}
          <li><a href="/novosti/">Все новости путешествий</a></li>
        </ul>
      </section>
    )}

    {similar.length > 0 && (
      <section class="om-sec">
        <h2>Похожие направления</h2>
        <ul class="om-related">
          {similar.map((r) => (<li><a href={`/${r.slug}/`}>{r.nom}</a><span>{r.why}{r.goodNow ? ' · хорошо сейчас' : ''}</span></li>))}
        </ul>
      </section>
    )}

    <section class="om-sec">
      <h2>Что почитать дальше</h2>
      <ul class="om-related">
        <li><a href="/seasons/">Сравнение всех 70+ направлений по сезонам</a></li>
        <li><a href={calcUrl}>Калькулятор бюджета поездки</a></li>
        <li><a href={`/trips/${MONTHS[new Date().getMonth()].slug}/${d.slug}/`}>{d.cases.nom} в {MONTHS[new Date().getMonth()].prep} {yr}</a></li>
        <li><a href={`/visa/${d.slug}/`}>Виза {d.cases.vP} — детально</a></li>
        <li><a href={compareUrl}>{compareOther ? `${d.cases.nom} или ${compareOther.cases.nom}` : `Сравнить ${d.cases.nom} с другим направлением`}</a></li>
        <li><a href="/countries/">Все страны на сайте</a></li>
      </ul>
    </section>

    {фотоКредиты && <p class="om-credits">{typo(фотоКредиты)}</p>}

    <div class="om-foot">
      <Image src={author} alt="Никита Зайцев" width={60} height={74} format="webp" quality={80} />
      <div>
        <p><a href="/about/">Никита Зайцев</a>, автор traveltribe.ru · <a href="https://t.me/traveltriberu" rel="noopener" target="_blank">@traveltriberu</a></p>
        {visited && <p class="om-dim">{`Был ${d.cases.loc} сам.`}</p>}
      </div>
    </div>
  </main>

  {билеты && flightFrom ? (
    <StickyCta href={билеты} label={`Билеты ${d.cases.vP} от $${flightFrom}`} />
  ) : RU_STAY.has(d.slug) && (
    <StickyCta href={otelloStay(`hub_${d.slug}`)} label={`Подобрать жильё ${d.cases.loc}`} />
  )}

  <Footer />
</Layout>

<style>
  /* Макет Омана для всех стран (10.09.2026). Основа — src/pages/oman.astro один в
     один; ниже добавлено только то, чего у Омана нет: оглавление, списки гайда,
     маршрут, сравнение, связанные материалы, легенда полосы месяцев. */
  .om { max-width: 1280px; margin: 0 auto; padding: 0 24px 64px; }
  .om h2 { font-family: var(--ff-display); font-weight: 400; font-size: clamp(1.75rem, 3.4vw, 2.5rem); line-height: 1.1; margin: 0 0 20px; scroll-margin-top: 80px; text-wrap: balance; }
