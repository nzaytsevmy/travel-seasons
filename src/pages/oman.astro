  @media (max-width: 900px) {
    .om-top, .om-pair, .om-money, .om-practice { grid-template-columns: 1fr; gap: 28px; }
    .om-title, .om-answer, .om-byline,
    .om-pair > *, .om-money > *, .om-practice > * { grid-column: 1 / -1; }
    .om-heat { grid-template-columns: repeat(6, 1fr); }
  }
  @media (max-width: 768px) {
    .om { padding: 0 16px 48px; }
    .om-sec { padding: 40px 0; }
    .om-hero, .om-wide { margin-left: -16px; margin-right: -16px; }
    .om-hero figcaption, .om-wide figcaption { padding: 0 16px; }
    .om-practice :global(img) { height: 240px; }
    .om-fill { flex: none; min-height: 0; aspect-ratio: 3 / 2; }
