  .om-wide { margin: 0 -24px; }
  .om-wide :global(img) { width: 100%; height: clamp(240px, 30vw, 480px); object-fit: cover; display: block; }

  .om-big { font-family: var(--ff-display); font-size: clamp(2rem, 4vw, 3rem); line-height: 1.05; margin: 0 0 16px; }
  .om-big .om-small { display: block; font-size: 0.9375rem; margin-top: 4px; }
  .om-prow { display: flex; justify-content: space-between; align-items: center; gap: 24px; min-height: 52px; padding: 0; box-sizing: border-box; border-bottom: 1px solid var(--line); font-size: 0.9375rem; }
  .om-prices .om-prow:first-child, .om-visa .om-prow:first-child { border-top: 1px solid var(--line); }
  .om-money + .om-money { margin-top: 40px; padding-top: 40px; border-top: 1px solid var(--line); }
  .om-prow span:first-child { color: var(--text-faint); }
  .om-prow span:last-child { font-family: var(--ff-mono); text-align: right; display: flex; justify-content: flex-end; align-items: center; }
  /* Правила и деньги: значения длинные — обычным шрифтом, слева, с переносом. */
  .om-rules { margin-top: 32px; }
  .om-rules .om-prow { align-items: flex-start; }
  .om-rules .om-prow span:last-child { flex: 1 1 auto; font-family: var(--ff-body); text-align: left; justify-content: flex-start; line-height: 1.45; padding: 10px 0; max-width: 62ch; }
  .om-rules .om-prow span:first-child { flex: 0 0 132px; padding: 10px 0; }
  .om-visa { max-width: 760px; margin-bottom: 24px; }
  /* Цели нажатия: ссылка-строка и отдельная ссылка-абзац дотягивают до 44 px.
     Ссылки внутри предложения под правило не попадают — они часть текста. */
  .om-prow a, .om-linkline a { display: inline-flex; align-items: center; min-height: 44px; }
  /* Текстовые ссылки — цветом сайта и с подчёркиванием: глобальный стиль сбрасывает
     оформление ссылок, и без этого они неотличимы от текста («не понятно, что это
     ссылки» — Никита, 09.09.2026). Кнопки и клетки месяцев — отдельно. */
  .om-prow a, .om-linkline a, .om-byline a, .om-foot a { color: var(--gold); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 3px; }
  .om-prow a:hover, .om-linkline a:hover, .om-byline a:hover, .om-foot a:hover { color: var(--gold-dim); }

  .om-practice :global(img) { width: 100%; height: 300px; object-fit: cover; display: block; }
  /* Левый кадр тянется на высоту двух правых. Без процентных высот внутри сетки:
     Safari считает их от всей фигуры, и подпись ложится поверх кадра (живой сайт,
     09.09.2026; в Chrome было чисто). Фигура — flex-колонка в растянутой ячейке,
     кадр заполняет остаток абсолютным позиционированием: так во всех браузерах. */
  .om-tall { display: flex; flex-direction: column; }
  .om-fill { position: relative; flex: 1 1 auto; min-height: 300px; }
  .om-practice .om-fill :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 45% 50%; }
  .om-practice > div { display: grid; row-gap: 20px; align-content: start; }
  .om-inline { margin: 0; }

  .om-faq { margin: 0; max-width: 760px; }
  .om-faq dt { font-weight: 600; font-size: 1.0625rem; margin: 20px 0 6px; }
  .om-faq dd { margin: 0; font-size: 1rem; line-height: 1.6; color: var(--text-dim); }

  .om-credits { font-size: 0.8125rem; color: var(--text-faint); margin: 40px 0 0; }
  .om-foot { display: flex; gap: 16px; align-items: flex-start; padding: 32px 0 0; border-top: 1px solid var(--line); }
  .om-foot :global(img) { width: 60px; height: 74px; object-fit: cover; object-position: 50% 20%; flex: none; }

  @media (max-width: 1100px) {
    .om-title { grid-column: span 7; }
    .om-answer { grid-column: span 5; }
