---
import Layout from '../../layouts/Layout.astro';
import Footer from '../../components/Footer.astro';
import { ROUTES } from '../../data/routes.js';

const canonical = 'https://traveltribe.ru/routes/';
const title = 'Маршруты путешествий по дням — TravelTribe';
const description = 'Готовые маршруты по дням: настройте даты, состав и остановки без регистрации, сохраните план поездки на устройстве.';
const ldJson = [
  {
    '@type': 'CollectionPage',
    '@id': `${canonical}#page`,
    url: canonical,
    name: title,
    description,
    inLanguage: 'ru-RU',
    speakable: { '@type': 'SpeakableSpecification', cssSelector: ['h1', '.routes-lede'] },
    isPartOf: { '@id': 'https://traveltribe.ru/#website' },
    author: { '@id': 'https://traveltribe.ru/about/#person' },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://traveltribe.ru/' },
      { '@type': 'ListItem', position: 2, name: 'Маршруты', item: canonical },
    ],
  },
  {
    '@type': 'ItemList',
    name: 'Готовые маршруты TravelTribe',
    itemListElement: ROUTES.map((route, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: route.title,
      url: `${canonical}${route.slug}/`,
    })),
  },
];
---
<Layout title={title} description={description} canonical={canonical} ldJson={ldJson}>
  <main id="main" class="routes-hub">
    <section class="routes-hero">
      <p class="routes-kicker">Готовые планы, которые можно менять</p>
      <h1>Маршрут — не статья, а рабочий план</h1>
      <p class="routes-lede">Выбери основу, переставь остановки и сохрани. Регистрация не нужна; Яндекс ID понадобится только для синхронизации между устройствами.</p>
      <a class="routes-main-action" href="#ready-routes">Выбрать маршрут</a>
    </section>

    <section class="routes-list" id="ready-routes">
      <div class="routes-section-head">
        <h2>Готовые маршруты</h2>
        <p>{ROUTES.length} планов из уже проверенных гайдов</p>
      </div>
      <ol>
        {ROUTES.map((route) => (
          <li>
            <div class="routes-meta">
              <span>{route.destination}</span>
              <span>{route.durationDays} {route.durationDays === 1 ? 'день' : route.durationDays < 5 ? 'дня' : 'дней'}</span>
            </div>
            <h3><a href={`/routes/${route.slug}/`}>{route.title}</a></h3>
            <p>{route.summary}</p>
            <p class="routes-mode">{route.mode}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="routes-how">
      <h2>Что здесь можно сделать?</h2>
      <div>
        <p><strong>Сначала попробовать.</strong> Даты, люди и остановки меняются до входа.</p>
        <p><strong>Сохранить локально.</strong> План останется на этом устройстве и появится в «Моих поездках».</p>
        <p><strong>Синхронизировать отдельно.</strong> Облако не включается само и не забирает даты поездки в аналитику.</p>
      </div>
    </section>

    <section class="routes-proof">
      <h2>Откуда взялись остановки?</h2>
      <p>Каждый план собран из опубликованного гайда TravelTribe. У маршрута показана дата пересверки источника; новые визовые, ценовые и пограничные утверждения здесь не добавляются.</p>
    </section>
  </main>
  <Footer />
</Layout>

<style>
.routes-hub{max-width:1280px;margin:0 auto;padding:clamp(2.5rem,6vw,6rem) clamp(1.1rem,3vw,2.6rem) 5rem;color:var(--text)}
.routes-hero{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:var(--gutter,1.5rem);padding-bottom:clamp(3rem,7vw,6rem)}
.routes-kicker{grid-column:1/5;color:var(--gold);font-weight:600;margin:0;font-size:.86rem}
.routes-hero h1{grid-column:1/10;font:800 clamp(2.6rem,7vw,6.4rem)/.94 var(--ff-body);letter-spacing:-.045em;margin:.5rem 0 0}
.routes-lede{grid-column:7/13;font-size:clamp(1.05rem,1.6vw,1.3rem);line-height:1.55;margin:1rem 0 0;color:var(--text-dim)}
.routes-main-action{grid-column:7/10;display:inline-flex;align-items:center;min-height:48px;margin-top:1rem;color:var(--gold);font-weight:700;text-underline-offset:.22em}
.routes-list,.routes-how,.routes-proof{border-top:2px solid var(--text);padding-top:1.25rem}
.routes-list h2,.routes-how h2,.routes-proof h2{font:800 clamp(1.5rem,3vw,2.2rem)/1.05 var(--ff-body);letter-spacing:-.03em;margin:0;scroll-margin-top:80px}
.routes-section-head{display:flex;justify-content:space-between;align-items:center;gap:1rem}
.routes-section-head p{font:.76rem var(--ff-mono);color:var(--text-dim);margin:0}
.routes-list ol{list-style:none;margin:1.5rem 0 0;padding:0;display:grid;grid-template-columns:repeat(12,minmax(0,1fr))}
.routes-list li{grid-column:span 6;border-top:1px solid var(--line);padding:1.25rem 1.5rem 2rem 0}
.routes-list li:nth-child(even){padding-left:1.5rem;border-left:1px solid var(--line)}
.routes-meta{display:flex;gap:1rem;font:.7rem var(--ff-mono);text-transform:uppercase;color:var(--text-dim)}
.routes-list h3{font:750 clamp(1.25rem,2vw,1.7rem)/1.12 var(--ff-body);margin:.55rem 0 0}
.routes-list h3 a{color:var(--text);text-decoration:underline 1px transparent;text-underline-offset:.22em}
.routes-list h3 a:hover{color:var(--gold);text-decoration-color:var(--gold)}
.routes-list li>p{max-width:52ch;margin:.7rem 0 0;color:var(--text-dim);line-height:1.5}
.routes-list .routes-mode{font-size:.82rem;color:var(--text)}
.routes-how,.routes-proof{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:var(--gutter,1.5rem);margin-top:clamp(3rem,7vw,6rem)}
.routes-how h2,.routes-proof h2{grid-column:1/6}
.routes-how>div,.routes-proof>p{grid-column:7/13;margin:0}
.routes-how p{border-top:1px solid var(--line);padding:1rem 0;margin:0;line-height:1.55}
.routes-proof>p{line-height:1.6;color:var(--text-dim)}
@media(max-width:760px){
  .routes-hero{grid-template-columns:repeat(4,minmax(0,1fr))}
  .routes-kicker,.routes-hero h1,.routes-lede,.routes-main-action{grid-column:1/-1}
  .routes-hero h1{font-size:clamp(2.6rem,15vw,4.4rem)}
  .routes-list ol{display:block}
  .routes-list li,.routes-list li:nth-child(even){padding:1.25rem 0 2rem;border-left:0}
  .routes-section-head{align-items:flex-start;flex-direction:column}
  .routes-how,.routes-proof{grid-template-columns:repeat(4,minmax(0,1fr))}
  .routes-how h2,.routes-proof h2,.routes-how>div,.routes-proof>p{grid-column:1/-1}
}
</style>
