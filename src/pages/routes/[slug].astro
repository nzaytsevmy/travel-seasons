---
import Layout from '../../layouts/Layout.astro';
import Footer from '../../components/Footer.astro';
import RoutePlanner from '../../components/RoutePlanner.astro';
import { ROUTES } from '../../data/routes.js';
import { youtravelCountry } from '../../data/affiliate.js';

export function getStaticPaths() {
  return ROUTES.map((route) => ({ params: { slug: route.slug }, props: { route } }));
}

const { route } = Astro.props;
const canonical = `https://traveltribe.ru/routes/${route.slug}/`;
const title = `${route.title}: готовый план по дням — TravelTribe`;
const description = `${route.summary} Настройте даты, людей и остановки, затем сохраните маршрут без регистрации.`;
const readyTourUrl = youtravelCountry(route.destinationSlug, `route_${route.slug}_ready_tour`);
const ldJson = [
  {
    '@type': 'WebPage',
    '@id': `${canonical}#page`,
    url: canonical,
    name: title,
    description,
    inLanguage: 'ru-RU',
    isPartOf: { '@id': 'https://traveltribe.ru/#website' },
    author: { '@id': 'https://traveltribe.ru/about/#person' },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://traveltribe.ru/' },
      { '@type': 'ListItem', position: 2, name: 'Маршруты', item: 'https://traveltribe.ru/routes/' },
      { '@type': 'ListItem', position: 3, name: route.title, item: canonical },
    ],
  },
];
---
<Layout
  title={title}
  description={description}
  canonical={canonical}
  noindex={!route.indexable}
  ldJson={ldJson}
  monetizationDestination={route.destinationSlug}
>
  <main id="main" class="route-page" data-route-slug={route.slug}>
    <nav class="route-crumbs" aria-label="Хлебные крошки">
      <a href="/">Главная</a><span aria-hidden="true">/</span><a href="/routes/">Маршруты</a><span aria-hidden="true">/</span><span>{route.title}</span>
    </nav>
    <header class="route-hero">
      <div>
        <p class="route-place">{route.destination} · {route.durationDays} {route.durationDays === 1 ? 'день' : route.durationDays < 5 ? 'дня' : 'дней'}</p>
        <h1>{route.title}</h1>
      </div>
      <div class="route-intro">
        <p>{route.summary}</p>
        <p class="route-mode">{route.mode}</p>
        <a href="#route-editor">Настроить этот маршрут</a>
      </div>
    </header>

    <section class="route-preview">
      <div class="route-preview-head">
        <h2>Что входит в основу?</h2>
        <p>Любую остановку можно убрать или переставить ниже.</p>
      </div>
      <ol>
        {route.stops.map((stop) => (
          <li><span>День {stop.day}</span><strong>{stop.label}</strong></li>
        ))}
      </ol>
    </section>

    <RoutePlanner route={route} />

    <aside class="route-booking">
      <h2>Если не хочется собирать всё самому</h2>
      <div>
        <p>Сравни готовые авторские туры по направлению с этим планом: программу, размер группы и то, что входит в цену.</p>
        <a href={readyTourUrl} rel="sponsored" data-route-partner>Посмотреть готовые туры в {route.destination}</a>
        <small>Партнёрская ссылка: TravelTribe может получить комиссию, цена для вас не меняется.</small>
      </div>
    </aside>

    <aside class="route-source">
      <h2>Источник маршрута</h2>
      <div>
        <p>Основа взята из материала <a href={route.sourceUrl}>{route.sourceLabel}</a>. Последняя пересверка источника: {route.sourceCheckedAt}.</p>
        <p>Перед бронированием открой исходный гайд: там находятся ограничения, цены и ссылки на первоисточники. Эта страница не подменяет их коротким пересказом.</p>
      </div>
    </aside>
  </main>
  <Footer />
</Layout>

<script>
  import { trackProductEvent } from '../../scripts/product-analytics';

  if (!document.documentElement.dataset.routePartnerTracking) {
    document.documentElement.dataset.routePartnerTracking = '1';
    document.addEventListener('click', (event) => {
      const anchor = (event.target as Element | null)?.closest?.('[data-route-partner]');
      if (!anchor) return;
      const page = anchor.closest<HTMLElement>('[data-route-slug]');
      trackProductEvent('route_partner_click', { route_slug: page?.dataset.routeSlug || '' });
    });
  }
</script>

<style>
.route-page{max-width:1280px;margin:0 auto;padding:2rem clamp(1.1rem,3vw,2.6rem) 5rem;color:var(--text)}
.route-crumbs{display:flex;flex-wrap:wrap;gap:.45rem;color:var(--text-dim);font-size:.78rem;min-height:44px;align-items:center}
.route-crumbs a{display:inline-flex;align-items:center;min-height:24px;color:var(--gold);text-underline-offset:.22em}
.route-hero{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:var(--gutter,1.5rem);padding:clamp(2rem,5vw,4.5rem) 0 clamp(3rem,7vw,6rem)}
.route-hero>div:first-child{grid-column:1/9}
.route-place{color:var(--gold);font-weight:650;margin:0}
.route-hero h1{font:800 clamp(2.7rem,7vw,6rem)/.94 var(--ff-body);letter-spacing:-.045em;margin:.55rem 0 0}
.route-intro{grid-column:9/13;align-self:end}
.route-intro>p{font-size:1.05rem;line-height:1.55;margin:0;color:var(--text-dim)}
.route-intro .route-mode{font-size:.82rem;color:var(--text);border-left:3px solid var(--gold);padding-left:.8rem;margin:1rem 0}
.route-intro>a{display:inline-flex;align-items:center;min-height:48px;color:var(--gold);font-weight:700;text-underline-offset:.22em}
.route-preview{border-top:2px solid var(--text);padding-top:1.25rem}
.route-preview-head{display:flex;justify-content:space-between;align-items:center;gap:1rem}
.route-preview h2,.route-booking h2,.route-source h2{font:800 clamp(1.5rem,3vw,2.2rem)/1.05 var(--ff-body);letter-spacing:-.03em;margin:0;scroll-margin-top:80px}
.route-preview-head p{font-size:.82rem;color:var(--text-dim);margin:0}
.route-preview ol{list-style:none;margin:1.5rem 0 0;padding:0;border-top:1px solid var(--line)}
.route-preview li{display:grid;grid-template-columns:6rem minmax(0,1fr);gap:1rem;padding:1rem 0;border-bottom:1px solid var(--line);align-items:start}
.route-preview li span{font:.72rem var(--ff-mono);text-transform:uppercase;color:var(--text-dim)}
.route-preview li strong{font-size:1.02rem}
.route-booking,.route-source{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:var(--gutter,1.5rem);border-top:2px solid var(--text);padding-top:1.25rem;margin-top:clamp(3rem,7vw,6rem)}
.route-booking h2,.route-source h2{grid-column:1/6}
.route-booking>div,.route-source>div{grid-column:7/13;color:var(--text-dim);line-height:1.6}
.route-booking>div p:first-child,.route-source>div p:first-child{margin-top:0}
.route-booking a,.route-source a{color:var(--gold);text-underline-offset:.22em}
.route-booking a{display:inline-flex;align-items:center;min-height:48px;font-weight:700}
.route-booking small{display:block;margin-top:.5rem;font-size:.72rem;color:var(--text-faint)}
@media(max-width:760px){
  .route-hero{grid-template-columns:repeat(4,minmax(0,1fr))}
  .route-hero>div:first-child,.route-intro{grid-column:1/-1}
  .route-hero h1{font-size:clamp(2.7rem,15vw,4.5rem)}
  .route-preview-head{align-items:flex-start;flex-direction:column}
  .route-preview li{grid-template-columns:4.5rem minmax(0,1fr)}
  .route-booking,.route-source{grid-template-columns:repeat(4,minmax(0,1fr))}
  .route-booking h2,.route-booking>div,.route-source h2,.route-source>div{grid-column:1/-1}
}
</style>
