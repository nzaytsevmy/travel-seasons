---
// /novosti/YYYY-MM/ — архив месяца: список заметок со ссылками на их страницы.
// Строится только для месяцев, которые уже ушли из ленты (src/data/news.js).
//
// ⛔ Раньше архив печатал каждую заметку месяца целиком. С 10.08.2026 полный
// текст живёт на своей странице заметки, а архив остаётся тем, чем и был по
// смыслу, — оглавлением месяца. Иначе один и тот же текст лежал по трём адресам.
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Footer from '../../components/Footer.astro';
import NewsCompact from '../../components/NewsCompact.astro';
import { getCollection } from 'astro:content';
import { archiveKeys, entriesOfMonth, monthTitleRu, formatDateRu, newsUrl } from '../../data/news.js';
import { plural } from '../../data/plural.js';

export async function getStaticPaths() {
  const all = await getCollection('news');
  return archiveKeys(all).map((month) => ({ params: { month } }));
}

const { month } = Astro.params;
const all = await getCollection('news');
const items = entriesOfMonth(all, month);

const others = archiveKeys(all).filter((k) => k !== month);
const monthRu = monthTitleRu(month);
const url = `https://traveltribe.ru/novosti/${month}/`;
const title = `Новости путешествий: ${monthRu.toLowerCase()}`;
const description = `Что менялось во въездных правилах, доступе к местам и перелётах в ${monthRu.toLowerCase()}. Каждая заметка со ссылкой на первоисточник.`;

// Самая поздняя проверка внутри месяца. Именно она, а не дата сборки: архив
// замороженный, и помечать его «обновлён сегодня» — враньё поисковику.
const lastChecked = items.reduce((a, e) => (e.data.checked > a ? e.data.checked : a), items[0].data.checked);

const ldJson = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": `${url}#page`,
      "url": url,
      "name": title,
      "description": description,
      "inLanguage": "ru-RU",
      "dateModified": lastChecked.toISOString().slice(0, 10),
      "author": { "@id": "https://traveltribe.ru/about/#person" },
      "speakable": { "@type": "SpeakableSpecification", "cssSelector": ["h1", ".nv-tldr"] },
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Главная", "item": "https://traveltribe.ru/" },
        { "@type": "ListItem", "position": 2, "name": "Новости", "item": "https://traveltribe.ru/novosti/" },
        { "@type": "ListItem", "position": 3, "name": monthRu, "item": url },
      ],
    },
    {
      "@type": "ItemList",
      "itemListElement": items.map((e, i) => ({
        "@type": "ListItem",
        "position": i + 1,
        "name": e.data.title,
        "url": `https://traveltribe.ru${newsUrl(e)}`,
      })),
    },
  ],
};
---
<Layout title={title} description={description} canonical={url} ldJson={ldJson}>
  <Breadcrumbs crumbs={[{ label: 'Новости', href: '/novosti/' }, { label: monthRu }]} />
  <main id="main" class="nv">

    <header class="nv-head">
      <h1 class="nv-h1">Новости за {monthRu.toLowerCase()}</h1>
      <p class="nv-lead">
        Архив: {items.length} {plural(items.length, 'заметка', 'заметки', 'заметок')} за месяц.
        Свежее — в <a href="/novosti/">ленте новостей</a>.
      </p>
      <p class="nv-byline">
        Ведёт <a href="/about/">Никита Зайцев</a> · последняя проверка: {formatDateRu(lastChecked)} ·
        <a href="/novosti/rss.xml">RSS</a>
      </p>
    </header>

    <ol class="nv-list">
      {items.map((entry) => <NewsCompact entry={entry} />)}
    </ol>

    {others.length > 0 && (
      <section class="nv-section">
        <h2>Другие месяцы</h2>
        <ul class="nv-links">
          {others.map((k) => <li><a href={`/novosti/${k}/`}>{monthTitleRu(k)}</a></li>)}
        </ul>
      </section>
    )}

  </main>

  <Footer />
</Layout>

<style>
  .nv { max-width: 780px; margin: 0 auto; padding: 0 var(--gutter, 16px) 4rem; }
  .nv-head { padding-bottom: 1.6rem; }
  .nv-h1 { font-size: clamp(1.6rem, 4vw, 2.3rem); line-height: 1.15; margin: 0 0 .9rem; }
  .nv-lead { max-width: 62ch; line-height: 1.6; margin: 0 0 1rem; }
  .nv-lead a { color: var(--gold); text-decoration: underline 1px var(--gold); text-underline-offset: .22em; }
  .nv-byline { font-size: .85rem; color: var(--text-dim); margin: 0; }
  .nv-byline a { color: var(--gold); text-decoration: underline 1px var(--gold); text-underline-offset: .22em; }
  .nv-list { list-style: none; margin: 0; padding: 0; }
  .nv-section { border-top: 1px solid var(--line-strong, var(--line)); padding-top: 1.6rem; margin-top: 2.4rem; }
  .nv-section h2 { font-size: 1.35rem; margin: 0 0 .7rem; scroll-margin-top: 80px; }
  .nv-links { list-style: none; margin: 0; padding: 0; }
  .nv-links li { padding: .6rem 0; border-bottom: 1px solid var(--line); font-size: .98rem; }
  .nv-links a { color: var(--gold); text-decoration: underline 1px var(--gold); text-underline-offset: .22em; }
</style>
