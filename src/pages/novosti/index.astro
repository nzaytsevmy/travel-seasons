---
// /novosti/ — лента новостей о путешествиях, природе и правилах въезда.
//
// Витрина, а не свалка: у свежих заметок карточка с кадром и капсулой-ответом,
// у остальных — строка со ссылкой. Текст заметки целиком живёт на её странице.
// Длина ленты постоянная (FEED_SIZE), всё остальное — в /novosti/YYYY-MM/;
// страница месяца есть у каждого месяца с заметками, включая текущий, поэтому
// дня, когда заметка не видна нигде, не бывает.
//
// ⛔ Раньше здесь печатались ВСЕ заметки целиком, и у заметки не было своей
// страницы вовсе. Замер 10.08.2026: страница весила 179 КБ, а раздел за 30 дней
// набрал в Google ноль показов — ранжироваться было нечему, на двадцать заметок
// приходилось три адреса.
//
// ⛔ Второй заход, 08.09.2026. Своя страница у заметки сработала: 497 показов и
// 9 кликов за 28 дней при средней позиции 7,6 против 10,7 по сайту. А вот сама
// лента снова разрослась — 87 заметок и 230 КБ: хвост тянул весь текущий месяц,
// и длина зависела от дня месяца, а не от замысла. Теперь на ленте постоянные
// FEED_SIZE заметок, всё остальное — в архиве своего месяца, и архив есть у
// каждого месяца, включая текущий. Ранжируется всё равно не лента (19 показов,
// позиция 20,7), а страницы заметок; лента — вход для читателя и путь обхода.
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Footer from '../../components/Footer.astro';
import NewsItem from '../../components/NewsItem.astro';
import NewsCompact from '../../components/NewsCompact.astro';
import { getCollection } from 'astro:content';
import { feedEntries, monthKeys, entriesOfMonth, monthTitleRu, newsUrl,
         FULL_ON_FEED, FEED_SIZE } from '../../data/news.js';
import { plural } from '../../data/plural.js';

const all = await getCollection('news');
const fresh = feedEntries(all, FEED_SIZE);
const months = monthKeys(all).map((k) => ({ key: k, count: entriesOfMonth(all, k).length }));

const full = fresh.slice(0, FULL_ON_FEED);
const rest = fresh.slice(FULL_ON_FEED);

const url = 'https://traveltribe.ru/novosti/';
const title = 'Новости путешествий 2026: визы, природа, транспорт';
const description = 'Что произошло за последние дни: изменения въездных правил, новости нацпарков и перелёты — коротко и с датами.';

const lastChecked = fresh.length ? fresh[0].data.checked : null;

const ldJson = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": `${url}#page`,
      "url": url,
      "name": title,
      "description": description,
      "inLanguage": "ru-RU",
      ...(lastChecked ? { "dateModified": lastChecked.toISOString().slice(0, 10) } : {}),
      "author": { "@id": "https://traveltribe.ru/about/#person" },
      // Капсула-ответ у каждой заметки — то, что зачитывает голосовой ответ и
      // из чего собирается цитата в ИИ-выдаче. Паттерн тот же, что на одиннадцати
      // других шаблонах сайта.
      "speakable": { "@type": "SpeakableSpecification", "cssSelector": ["h1", ".nv-tldr"] },
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Главная", "item": "https://traveltribe.ru/" },
        { "@type": "ListItem", "position": 2, "name": "Новости", "item": url },
      ],
    },
    {
      // ⛔ Перечисляем ТОЛЬКО то, что на странице. Пока лента печатала весь
      // месяц, сюда уходили все 87 заметок — 21 КБ разметки, описывающей
      // список, которого читатель не видел.
      "@type": "ItemList",
      "itemListElement": fresh.map((e, i) => ({
        "@type": "ListItem",
        "position": i + 1,
        "name": e.data.title,
        "url": `https://traveltribe.ru${newsUrl(e)}`,
      })),
    },
  ],
};
---
<Layout title={title} description={description} canonical={url} ldJson={ldJson}>
  <Breadcrumbs crumbs={[{ label: 'Новости' }]} />
  <main id="main" class="nv">

    <header class="nv-head">
      <h1 class="nv-h1">Новости путешествий</h1>
      <p class="nv-lead">
        Короткие заметки о том, что меняется прямо сейчас: въездные правила, доступ
        к местам и перелёты, а ещё находки о дикой природе, ради которых, собственно,
        и едут.
      </p>
      <p class="nv-byline">
        Ведёт <a href="/about/">Никита Зайцев</a> ·
        <a href="/novosti/rss.xml">RSS</a>
      </p>
    </header>

    {full.length > 0 ? (
      <ol class="nv-list">
        {full.map((entry, i) => <NewsItem entry={entry} index={i} />)}
      </ol>
    ) : (
      <p class="nv-empty">
        Свежих заметок пока нет. Так бывает: если за день не случилось ничего, что
        меняет чьи-то планы, я ничего не публикую.
      </p>
    )}

    {rest.length > 0 && (
      <section class="nv-section">
        <h2>Раньше в ленте</h2>
        <ol class="nv-compact">
          {rest.map((entry) => <NewsCompact entry={entry} />)}
        </ol>
      </section>
    )}

    {months.length > 0 && (
      <section class="nv-section">
        <h2>Все заметки по месяцам</h2>
        <p class="nv-what">
          На этой странице — последние {fresh.length}. Остальное разложено по месяцам:
          заметка попадает в свой месяц в день выпуска и остаётся там навсегда.
        </p>
        <ul class="nv-links">
          {months.map(({ key, count }) => (
            <li>
              <a href={`/novosti/${key}/`}>{monthTitleRu(key)}</a>
              <span class="nv-count">{count} {plural(count, 'заметка', 'заметки', 'заметок')}</span>
            </li>
          ))}
        </ul>
      </section>
    )}

    <section class="nv-section">
      <h2>Что сюда попадает, а что нет</h2>
      <p class="nv-what">
        Попадает то, что меняет чьи-то планы (правило въезда, сбор, закрытие или
        открытие места, отмена рейсов) и то, что просто удивительно и про природу.
        Не попадает: подборки «топ-10», рейтинги, опросы, маркетинговые релизы
        и внутренняя кухня турбизнеса. Не попадает и то, что протухнет за неделю.
      </p>
      <p class="nv-what">
        Источник у каждой заметки — тот, кто объявил факт: министерство, посольство,
        авиавласти, администрация парка, научный институт. Отраслевые издания я читаю,
        но как наводку, где искать, а не как источник цифры. Поисковой выдаче и блогам
        не верю: на них уже ловились ошибки.
      </p>
    </section>

    <section class="nv-section">
      <h2>Куда дальше</h2>
      <ul class="nv-links">
        <li><a href="/izmeneniya/">Изменения въездных правил</a> — разобранная хронология, а не лента</li>
        <li><a href="/visa/">Визы по странам</a> — что нужно и сколько стоит</li>
        <li><a href="/blog/">Блог</a> — длинные разборы поездок со своими фото</li>
        <li><a href="https://t.me/traveltriberu" rel="noopener" target="_blank">@traveltriberu</a> — то же самое, только в телеграме</li>
      </ul>
    </section>

  </main>

  <Footer />
</Layout>

<style>
  .nv { max-width: 780px; margin: 0 auto; padding: 0 var(--gutter, 16px) 4rem; }

  .nv-head { padding-bottom: 1.6rem; }
  .nv-h1 { font-size: clamp(1.6rem, 4vw, 2.3rem); line-height: 1.15; margin: 0 0 .9rem; }
  .nv-lead { max-width: 62ch; line-height: 1.6; margin: 0 0 1rem; }
  .nv-byline { font-size: .85rem; color: var(--text-dim); margin: 0; }
  .nv-byline a { color: var(--gold); text-decoration: underline 1px var(--gold); text-underline-offset: .22em; }

  .nv-list { list-style: none; margin: 0; padding: 0; }
  .nv-compact { list-style: none; margin: 0; padding: 0; }
  .nv-empty { max-width: 62ch; line-height: 1.6; color: var(--text-dim);
              border-top: 1px solid var(--line-strong, var(--line)); padding-top: 1.5rem; }

  .nv-section { border-top: 1px solid var(--line-strong, var(--line)); padding-top: 1.6rem; margin-top: 2.4rem; }
  .nv-section h2 { font-size: 1.35rem; margin: 0 0 .7rem; scroll-margin-top: 80px; }
  .nv-what { max-width: 62ch; line-height: 1.6; margin: 0 0 .7rem; }

  .nv-links { list-style: none; margin: 0; padding: 0; }
  .nv-links li { padding: .6rem 0; font-size: .98rem; }
  .nv-links a { color: var(--gold); text-decoration: underline 1px var(--gold); text-underline-offset: .22em; }
  /* Счётчик заметок в месяце. Отдельным тоном, чтобы строка читалась как
     «месяц — сколько», а не как продолжение ссылки. */
  .nv-count { color: var(--text-faint); font-size: .85rem; margin-left: .55rem; }
</style>
