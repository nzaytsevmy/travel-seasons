---
// /my/ — локальный дашборд с опциональной облачной синхронизацией. Канонический
// формат tt_plans_v2 хранит до 20 планов, старые tt_trip/tt_trips мигрируют без
// удаления и продолжают получать совместимое окно для закэшированных страниц.
// noindex — персональная страница, не контент для поиска.
import Layout from '../../layouts/Layout.astro';
import Footer from '../../components/Footer.astro';
import { DIRECTIONS, MONTHS } from '../../data/directions.js';
import { PRICES } from '../../data/prices.js';
import { DATA_UPDATED_RU } from '../../data/meta.js';

// slug → индекс в PRICES (для глубокой ссылки в калькулятор, тот же паттерн,
// что использует [slug].astro: PRICES.findIndex по iata+name).
const slugToPriceIdx = {};
for (const d of DIRECTIONS) {
  if (!d.price) continue;
  const idx = PRICES.findIndex((p) => p.iata === d.price.iata && p.name === d.price.name);
  if (idx >= 0) slugToPriceIdx[d.slug] = idx;
}

const url = 'https://traveltribe.ru/my/';
const title = 'Мои поездки — TravelTribe';
const accountApiOrigin = import.meta.env.PUBLIC_ACCOUNT_API_ORIGIN || 'https://api.traveltribe.ru';
const syncEnabled = import.meta.env.PUBLIC_ROUTE_SYNC_ENABLED === 'true';
---
<Layout title={title} description="Личный план поездки: виза, бюджет, сезон и чек-лист для сохранённого направления." canonical={url} noindex={true}>
  <main id="main" class="myp">
    <section class="myp-hero">
      <h1 class="myp-h1" id="mypTitle">Мои поездки</h1>
      <p class="myp-lede" id="mypLede">
        Сохрани направление или настрой готовый маршрут — здесь останутся даты, остановки, виза, бюджет и сборы.
      </p>
    </section>

    <section class="myp-account" data-account-panel data-api-origin={accountApiOrigin} data-sync-enabled={String(syncEnabled)}>
      <div class="myp-shead"><h2>Синхронизация</h2><span data-account-state>Только это устройство</span></div>
      <p data-account-copy>Яндекс ID нужен только для переноса планов между устройствами. TravelTribe использует только технический идентификатор: имя и логин не сохраняются, почта и телефон не запрашиваются.</p>
      <label class="myp-consent"><input type="checkbox" data-account-consent /><span>Согласен на создание технической учётной записи по <a href="/legal/account-consent/">отдельным условиям</a>.</span></label>
      <div class="myp-account-actions">
        <button type="button" data-account-sync disabled>{syncEnabled ? 'Войти через Яндекс ID и синхронизировать' : 'Облачная синхронизация пока закрыта'}</button>
        <button type="button" data-account-export hidden>Скачать мои данные</button>
        <button type="button" data-account-logout hidden>Выйти</button>
        <button type="button" data-account-delete hidden>Удалить облачную учётную запись</button>
      </div>
      <div class="myp-conflict-actions" data-conflict-actions hidden>
        <p>Облачный и локальный планы менялись отдельно. Автоматически выбирать один из них небезопасно.</p>
        <button type="button" data-conflict-cloud>Использовать облачную версию</button>
        <button type="button" data-conflict-copy>Сохранить обе версии</button>
      </div>
      <p class="myp-account-status" data-account-status role="status" aria-live="polite">Локальные планы работают без входа.</p>
    </section>

    <div id="mypEmpty" class="myp-empty">
      <ul class="myp-empty-links">
        <li><a href="/countries/"><b>Все направления</b></a><span>выбрать куда</span></li>
        <li><a href="/trips/"><b>Куда ехать по месяцам</b></a><span>календарь по сезону</span></li>
        <li><a href="/compare/"><b>Сравнить направления</b></a><span>две страны бок о бок</span></li>
      </ul>
    </div>

    <div id="mypDash" class="myp-dash" hidden>
      {/* Переключатель поездок. Скрыт, пока сохранена одна — переключать нечего. */}
      <nav id="mypTrips" class="myp-trips" aria-label="Сохранённые поездки" hidden></nav>
      <section class="myp-section">
        <div class="myp-shead"><h2>Параметры поездки</h2></div>
        <div class="myp-form">
          <label class="myp-field">
            <span>Месяц</span>
            <select id="mypMonth">
              {MONTHS.map((m, i) => <option value={i}>{m.nom.charAt(0).toUpperCase() + m.nom.slice(1)}</option>)}
            </select>
          </label>
          <label class="myp-field">
            <span>Дней</span>
            <input type="number" id="mypDays" min="1" max="90" value="7" />
          </label>
          <label class="myp-field">
            <span>Человек</span>
            <input type="number" id="mypPeople" min="1" max="10" value="1" />
          </label>
          <label class="myp-field">
            <span>Дата вылета (опционально)</span>
            <input type="date" id="mypDate" />
          </label>
        </div>
        <p class="myp-countdown" id="mypCountdown"></p>
      </section>

      <section class="myp-section" id="mypRouteWrap" hidden>
        <div class="myp-shead"><h2>Маршрут по дням</h2></div>
        <ol class="myp-route-stops" id="mypRouteStops"></ol>
        <p class="myp-line"><a id="mypRouteEdit" href="/routes/">Изменить остановки</a></p>
      </section>

      <section class="myp-section">
        <div class="myp-shead"><h2>Виза</h2></div>
        <p class="myp-line" id="mypVisa"></p>
      </section>

      <section class="myp-section">
        <div class="myp-shead"><h2>Бюджет</h2></div>
        <p class="myp-line" id="mypBudget"></p>
      </section>

      <section class="myp-section">
        <div class="myp-shead"><h2>Сезон</h2></div>
        <p class="myp-line" id="mypSeason"></p>
      </section>

      <section class="myp-section" id="mypHolidaysWrap" hidden>
        <div class="myp-shead"><h2>События в этом месяце</h2></div>
        <ul class="myp-list" id="mypHolidays"></ul>
      </section>

      <section class="myp-section">
        <div class="myp-shead"><h2>Сборы</h2></div>
        <p class="myp-line" id="mypPacking"></p>
      </section>

      {/* Шенгенские дни. Показываем, только если человек что-то считал в
          калькуляторе 90/180 — цифру берём оттуда, а не пересчитываем. */}
      <section class="myp-section" id="mypSchengenWrap" hidden>
        <div class="myp-shead"><h2>Шенгенские дни</h2></div>
        <p class="myp-line" id="mypSchengen"></p>
      </section>

      <section class="myp-section">
        <div class="myp-shead"><h2>Дальше</h2></div>
        <ul class="myp-list" id="mypLinks"></ul>
      </section>

      <p class="myp-remove"><button type="button" id="mypRemove">Убрать эту поездку</button></p>
    </div>

    <p class="myp-disclaimer">Без Яндекс ID планы хранятся только в этом браузере. Облачная копия создаётся лишь после отдельного согласия и входа.</p>
    <p class="myp-updated">Актуально на: {DATA_UPDATED_RU}</p>
  </main>

  <Footer />
</Layout>

<script type="application/json" id="mypPriceIdx" set:html={JSON.stringify(slugToPriceIdx)} />
<script>
  import { listPlans, writePlans } from '../../scripts/trip-plans';
  import { deleteAccount, downloadAccountExport, getBootstrap, keepLocalCopies, logout, syncPlans, useCloudPlans } from '../../scripts/account-client';
  import { trackProductEvent } from '../../scripts/product-analytics';

  const PRICE_IDX = JSON.parse(document.getElementById('mypPriceIdx').textContent);
  const MONTHS = ['january','february','march','april','may','june','july','august','september','october','november','december'];
  const MONTH_PREP = ['январе','феврале','марте','апреле','мае','июне','июле','августе','сентябре','октябре','ноябре','декабре'];
  const RANK_LABEL = { P: 'Пик сезона', G: 'Хорошо', O: 'Нормально', B: 'Не лучший месяц', X: 'Закрыто' };
  const TAG_LABEL = { closed: 'выходные/закрыто', fest: 'фестиваль', culture: 'сезонное' };

  let ACTIVE = 0;

  const getTrips = () => listPlans();
  const setTrips = (list) => writePlans(list);

  function fmt(n, cur) { return cur === 'RUB' ? n.toLocaleString('ru-RU') + ' ₽' : '$' + n; }

  // Итог сборов пишет сам виджет (ключ __progress) — здесь мы только читаем,
  // чтобы цифры на дашборде и в чек-листе не разъезжались. Для тех, кто отмечал
  // пункты до появления этого ключа, остаётся старая проверка «хоть что-то есть».
  function packingProgress(slug, monthSlug) {
    const uid = `pmu-${slug}-${monthSlug}`;
    try {
      const raw = localStorage.getItem(`pck:${uid}:__progress`);
      if (raw) {
        const p = JSON.parse(raw);
        if (p && typeof p.d === 'number' && typeof p.t === 'number') return p;
      }
    } catch {}
    const prefix = `pck:${uid}:`;
    for (let i = 0; i < localStorage.length; i++) {
      const k = localStorage.key(i);
      if (k && k.startsWith(prefix) && localStorage.getItem(k) === '1') return { d: null, t: null };
    }
    return null;
  }

  function drawPicker(trips) {
    const wrap = document.getElementById('mypTrips');
    if (!wrap) return;
    // Одна поездка — переключать нечего, не мозолим глаза.
    wrap.hidden = trips.length < 2;
    wrap.innerHTML = trips.map((t, i) =>
      `<button type="button" data-trip="${i}" class="myp-trip${i === ACTIVE ? ' is-on' : ''}"` +
      `${i === ACTIVE ? ' aria-current="true"' : ''}></button>`).join('');
    wrap.querySelectorAll('[data-trip]').forEach((button, i) => {
      button.textContent = trips[i]?.title || trips[i]?.nom || trips[i]?.slug;
    });
    wrap.querySelectorAll('[data-trip]').forEach((b) =>
      b.addEventListener('click', () => { ACTIVE = Number(b.dataset.trip); render(); }));
  }

  async function render() {
    const trips = getTrips();
    const empty = document.getElementById('mypEmpty');
    const dash = document.getElementById('mypDash');
    if (ACTIVE >= trips.length) ACTIVE = 0;
    const trip = trips[ACTIVE] || null;
    drawPicker(trips);
    if (!trip) {
      empty.hidden = false;
      dash.hidden = true;
      return;
    }

    const res = await fetch(`/data/trip/${trip.slug}.json`);
    if (!res.ok) { empty.hidden = false; dash.hidden = true; return; }
    const data = await res.json();

    empty.hidden = true;
    dash.hidden = false;

    document.getElementById('mypTitle').textContent = trip.title || data.nom;
    document.getElementById('mypLede').textContent = `План поездки ${data.vP}. Сохранено ${new Date(trip.savedAt).toLocaleDateString('ru-RU')}.`;

    const routeWrap = document.getElementById('mypRouteWrap');
    const routeStops = document.getElementById('mypRouteStops');
    const routeEdit = document.getElementById('mypRouteEdit');
    if (trip.kind === 'route' && trip.routeSlug && trip.stops?.length) {
      routeStops.replaceChildren(...trip.stops.map((stop) => {
        const li = document.createElement('li');
        const day = document.createElement('span');
        const label = document.createElement('strong');
        day.textContent = `День ${stop.day}`;
        label.textContent = stop.label;
        li.append(day, label);
        return li;
      }));
      routeEdit.href = `/routes/${trip.routeSlug}/`;
      routeWrap.hidden = false;
    } else {
      routeWrap.hidden = true;
    }

    const monthSel = document.getElementById('mypMonth');
    const daysInp = document.getElementById('mypDays');
    const peopleInp = document.getElementById('mypPeople');
    const dateInp = document.getElementById('mypDate');
    monthSel.value = trip.monthIdx != null ? String(trip.monthIdx) : String(new Date().getMonth());
    daysInp.value = trip.days || 7;
    peopleInp.value = trip.people || 1;
    dateInp.value = trip.dateStart || '';

    function save() {
      trip.monthIdx = Number(monthSel.value);
      trip.days = Math.max(1, Number(daysInp.value) || 7);
      trip.people = Math.max(1, Number(peopleInp.value) || 1);
      trip.dateStart = dateInp.value || null;
      const list = getTrips();
      list[ACTIVE] = trip;
      setTrips(list);
      draw();
    }
    // render() вызывается повторно после переключения, удаления и синхронизации.
    // Присваивание обработчика не накапливает старые замыкания и не сохраняет
    // один ввод несколько раз после каждого перерендера.
    [monthSel, daysInp, peopleInp, dateInp].forEach((el) => { el.onchange = save; });

    document.getElementById('mypRemove').onclick = () => {
      const list = getTrips();
      list.splice(ACTIVE, 1);
      setTrips(list);
      ACTIVE = 0;
      render();
    };

    function draw() {
      const monthIdx = Number(monthSel.value);
      const monthSlug = MONTHS[monthIdx];

      const countdownEl = document.getElementById('mypCountdown');
      if (dateInp.value) {
        const days = Math.ceil((new Date(dateInp.value) - new Date()) / 86400000);
        countdownEl.textContent = days > 0 ? `До вылета: ${days} дн.` : (days === 0 ? 'Сегодня вылет!' : 'Дата уже прошла.');
      } else {
        countdownEl.textContent = '';
      }

      const visaEl = document.getElementById('mypVisa');
      if (data.visaFree) {
        visaEl.innerHTML = `<b>Не нужна</b> — безвизовый въезд.`;
      } else if (data.visa) {
        visaEl.innerHTML = `${data.visa.duration} · ${data.visa.cost} · ${data.visa.timing}. <a href="/visa/${data.slug}/">Детали визы</a>`;
      } else {
        visaEl.innerHTML = `<a href="/visa/${data.slug}/">Смотри детали визы</a>`;
      }

      const budgetEl = document.getElementById('mypBudget');
      const days = Number(daysInp.value) || 7;
      const people = Number(peopleInp.value) || 1;
      if (data.budget) {
        const total = data.budget.midrange * days * people;
        budgetEl.innerHTML = `На ${days} дн. × ${people} чел. по среднему уровню — ориентир <b>${fmt(total, data.budget.currency)}</b> (без перелёта). ${data.flightFrom ? `Перелёт от $${data.flightFrom} в одну сторону.` : ''} <a href="${PRICE_IDX[data.slug] != null ? '/calculator/?r=' + PRICE_IDX[data.slug] : '/calculator/'}">Точнее в калькуляторе</a>`;
      } else {
        budgetEl.innerHTML = `<a href="/calculator/">Посчитать в калькуляторе</a>`;
      }

      const seasonEl = document.getElementById('mypSeason');
      const code = data.r[monthIdx];
      const text = data.t[monthIdx] || '';
      seasonEl.innerHTML = `<b>${RANK_LABEL[code] || code}</b> в ${MONTH_PREP[monthIdx]}. ${text}`;

      const holEl = document.getElementById('mypHolidays');
      const holWrap = document.getElementById('mypHolidaysWrap');
      const monthEvents = (data.holidays || []).filter((h) => h.month === monthIdx + 1);
      if (monthEvents.length) {
        holWrap.hidden = false;
        holEl.innerHTML = monthEvents.map((e) => `<li><b>${e.name}${e.dates ? ' — ' + e.dates : ''}</b><span>${TAG_LABEL[e.tag] || e.tag}${e.note ? ' · ' + e.note : ''}</span></li>`).join('');
      } else {
        holWrap.hidden = true;
      }

      const packEl = document.getElementById('mypPacking');
      const packingUrl = `/packing/${data.slug}/${monthSlug}/`;
      const prog = packingProgress(data.slug, monthSlug);
      const label = !prog
        ? 'Ещё не открыт.'
        : prog.d === null
          ? 'Чек-лист начат ✓'
          : prog.d >= prog.t
            ? `Собрано ${prog.d} из ${prog.t} — всё готово ✓`
            : `Собрано ${prog.d} из ${prog.t}`;
      packEl.innerHTML = `${label} <a href="${packingUrl}">Открыть чек-лист</a>`;

      // Шенгенские дни — из итога, записанного калькулятором 90/180.
      const schWrap = document.getElementById('mypSchengenWrap');
      const schEl = document.getElementById('mypSchengen');
      let sch = null;
      try { sch = JSON.parse(localStorage.getItem('eesc:summary:v1') || 'null'); } catch {}
      if (schWrap && schEl && sch && typeof sch.left === 'number') {
        const on = sch.check ? ' на ' + new Date(sch.check).toLocaleDateString('ru-RU') : '';
        schEl.innerHTML = sch.used > 90
          ? `Превышение: использовано ${sch.used} из 90${on}. <a href="/blog/ees-2026/">Пересчитать</a>`
          : `Использовано ${sch.used} из 90, осталось ${sch.left}${on}. <a href="/blog/ees-2026/">Пересчитать</a>`;
        schWrap.hidden = false;
      } else if (schWrap) {
        schWrap.hidden = true;
      }

      const linksEl = document.getElementById('mypLinks');
      linksEl.innerHTML = `
        <li><a href="/${data.slug}/"><b>${data.nom} — карточка направления</b></a><span>виза, бюджет, маршруты</span></li>
        <li><a href="/events/${monthSlug}/"><b>События в ${MONTH_PREP[monthIdx]}</b></a><span>по всем странам</span></li>
        <li><a href="/blog/ees-2026/"><b>Шенген 90/180</b></a><span>калькулятор дней, если едешь в ЕС</span></li>
      `;
    }
    draw();
  }

  render();

  async function initAccount() {
    const panel = document.querySelector('[data-account-panel]');
    if (!(panel instanceof HTMLElement) || panel.dataset.ready === '1') return;
    panel.dataset.ready = '1';
    const enabled = panel.dataset.syncEnabled === 'true';
    const origin = panel.dataset.apiOrigin || '';
    const consent = panel.querySelector('[data-account-consent]');
    const sync = panel.querySelector('[data-account-sync]');
    const exportButton = panel.querySelector('[data-account-export]');
    const logoutButton = panel.querySelector('[data-account-logout]');
    const deleteButton = panel.querySelector('[data-account-delete]');
    const state = panel.querySelector('[data-account-state]');
    const status = panel.querySelector('[data-account-status]');
    const conflictActions = panel.querySelector('[data-conflict-actions]');
    const useCloud = panel.querySelector('[data-conflict-cloud]');
    const keepCopies = panel.querySelector('[data-conflict-copy]');
    if (!(consent instanceof HTMLInputElement) || !(sync instanceof HTMLButtonElement) || !(status instanceof HTMLElement)) return;
    let bootstrap = null;
    let pendingConflict = null;
    const say = (message) => { status.textContent = message; };
    const showConflict = (result) => {
      pendingConflict = { conflicts: result.conflicts, cloudPlans: result.cloudPlans };
      if (conflictActions instanceof HTMLElement) conflictActions.hidden = false;
      say('Есть конфликт версий. Ничего не перезаписано — выбери вариант ниже.');
    };
    consent.addEventListener('change', () => {
      sync.disabled = !enabled || !consent.checked;
      if (consent.checked) trackProductEvent('consent_accept', { plan_kind: 'account' });
    });

    async function loadAccount() {
      if (!enabled) return null;
      try {
        bootstrap = await getBootstrap(origin);
        if (bootstrap.authenticated) {
          state.textContent = 'Яндекс ID подключён';
          sync.textContent = 'Синхронизировать сейчас';
          sync.disabled = false;
          const consentLabel = consent.closest('label');
          if (consentLabel instanceof HTMLElement) consentLabel.hidden = true;
          for (const button of [exportButton, logoutButton, deleteButton]) if (button instanceof HTMLElement) button.hidden = false;
        }
        return bootstrap;
      } catch {
        say('Сервер синхронизации недоступен. Локальные планы не затронуты.');
        return null;
      }
    }

    sync.addEventListener('click', async () => {
      const current = bootstrap || await loadAccount();
      if (!current?.authenticated) {
        try { localStorage.setItem('tt_account_consent_v2', JSON.stringify({ version: 'account_v2', acceptedAt: Date.now() })); } catch {}
        trackProductEvent('auth_start', { plan_kind: 'account' });
        location.assign(`${origin}/v1/auth/yandex/start?consent=account_v2&return_to=${encodeURIComponent('/my/?sync=1')}`);
        return;
      }
      say('Синхронизирую планы…');
      const result = await syncPlans(origin, current.csrfToken || '');
      if (result.ok) {
        if (conflictActions instanceof HTMLElement) conflictActions.hidden = true;
        say('Все планы синхронизированы.');
      } else if (result.conflict) showConflict(result);
      else if (result.reason === 'limit') say('Для синхронизации оставь не больше 20 планов. Ничего не удалено.');
      else say('Связь прервалась. Планы остались на устройстве.');
      if (result.ok) render();
    });
    useCloud?.addEventListener('click', () => {
      if (!pendingConflict) return;
      const result = useCloudPlans(pendingConflict);
      if (!result.ok) {
        say('Нельзя объединить планы без потери: общий лимит — 20. Удали лишний план и повтори.');
        return;
      }
      pendingConflict = null;
      if (conflictActions instanceof HTMLElement) conflictActions.hidden = true;
      say('На этом устройстве выбрана облачная версия.');
      render();
    });
    keepCopies?.addEventListener('click', async () => {
      if (!pendingConflict || !bootstrap?.csrfToken) return;
      say('Сохраняю обе версии…');
      const result = await keepLocalCopies(origin, bootstrap.csrfToken, pendingConflict);
      if (result.ok) {
        pendingConflict = null;
        if (conflictActions instanceof HTMLElement) conflictActions.hidden = true;
        say('Обе версии сохранены: локальная помечена как копия.');
        render();
      } else {
        say(result.reason === 'limit' ? 'Для копии нет места: лимит — 20 планов.' : 'Не удалось сохранить копию. Локальные данные не изменены.');
      }
    });
    exportButton?.addEventListener('click', async () => {
      try { await downloadAccountExport(origin); say('Экспорт скачан.'); } catch { say('Не удалось скачать экспорт.'); }
    });
    logoutButton?.addEventListener('click', async () => {
      if (!bootstrap?.csrfToken) return;
      try { await logout(origin, bootstrap.csrfToken); location.reload(); } catch { say('Не удалось выйти.'); }
    });
    deleteButton?.addEventListener('click', async () => {
      if (!bootstrap?.csrfToken || !confirm('Удалить облачную учётную запись и все её планы? Локальные планы на этом устройстве останутся.')) return;
      try { await deleteAccount(origin, bootstrap.csrfToken); location.reload(); } catch { say('Не удалось удалить облачную учётную запись.'); }
    });

    const params = new URLSearchParams(location.search);
    if (enabled && (params.get('sync') === '1' || params.get('auth') === 'success')) {
      if (params.get('auth') === 'success') trackProductEvent('auth_success', { plan_kind: 'account' });
      const current = await loadAccount();
      if (current?.authenticated && current.csrfToken) {
        const result = await syncPlans(origin, current.csrfToken);
        if (result.ok) say('Вход выполнен, планы синхронизированы.');
        else if (result.conflict) showConflict(result);
        else if (result.reason === 'limit') say('Вход выполнен. Для синхронизации оставь не больше 20 планов; ничего не удалено.');
        else say('Вход выполнен, но синхронизацию нужно повторить.');
        render();
      }
    }
  }
  initAccount();
</script>

