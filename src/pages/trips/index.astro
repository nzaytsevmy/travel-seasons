---
// Хаб «Куда поехать по месяцам» — Swiss / International Typographic по BRANDBOOK.md.
// Самодостаточный scoped-визуал: свои токены, только hairlines, один акцент gold, без эмодзи.
import { Image, getImage } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { DIRECTIONS } from '../../data/directions.js';
import { DATA_UPDATED_RU } from '../../data/meta.js';

// Кадры направлений: те же файлы, что на страницах стран — новых не заводим.
const destPhotos = import.meta.glob('../../assets/destinations/*.jpg', { eager: true, import: 'default' });
const фотоНаправления = (slug) => destPhotos[`../../assets/destinations/${slug}.jpg`];

const MONTHS = [
  { slug: 'january',   nom: 'Январь',   prep: 'январе',   short: 'Янв' },
  { slug: 'february',  nom: 'Февраль',  prep: 'феврале',  short: 'Фев' },
  { slug: 'march',     nom: 'Март',     prep: 'марте',    short: 'Мар' },
  { slug: 'april',     nom: 'Апрель',   prep: 'апреле',   short: 'Апр' },
  { slug: 'may',       nom: 'Май',      prep: 'мае',      short: 'Май' },
  { slug: 'june',      nom: 'Июнь',     prep: 'июне',     short: 'Июн' },
  { slug: 'july',      nom: 'Июль',     prep: 'июле',     short: 'Июл' },
  { slug: 'august',    nom: 'Август',   prep: 'августе',  short: 'Авг' },
  { slug: 'september', nom: 'Сентябрь', prep: 'сентябре', short: 'Сен' },
  { slug: 'october',   nom: 'Октябрь',  prep: 'октябре',  short: 'Окт' },
  { slug: 'november',  nom: 'Ноябрь',   prep: 'ноябре',   short: 'Ноя' },
  { slug: 'december',  nom: 'Декабрь',  prep: 'декабре',  short: 'Дек' },
];

const plural = (n) => (n % 10 === 1 && n % 100 !== 11 ? 'направление' : (n % 10 >= 2 && n % 10 <= 4 && (n % 100 < 10 || n % 100 >= 20) ? 'направления' : 'направлений'));

// Для каждого месяца: топ-пик-направления (имена) + сколько всего в сезоне (P или G).
// ⛔ Кадр берём у направления на пике — но следим, чтобы он не повторялся:
//    у соседних месяцев пики совпадают, и на первой сборке Новая Зеландия
//    стояла в двух карточках, а Австралия в трёх. Идём по списку пиков и
//    берём первое ещё не занятое; если все заняты — разрешаем повтор,
//    пустая карточка хуже.
const занятыеКадры = new Set();
const monthSummary = MONTHS.map((m, i) => {
  const peakDirs = DIRECTIONS.filter(d => d.r[i] === 'P');
  const peak = peakDirs.map(d => d.cases.nom);
  const totalGood = DIRECTIONS.filter(d => d.r[i] === 'P' || d.r[i] === 'G').length;
  const сКадром = peakDirs.filter(d => фотоНаправления(d.slug));
  const photoDir = сКадром.find(d => !занятыеКадры.has(d.slug)) || сКадром[0] || null;
  if (photoDir) занятыеКадры.add(photoDir.slug);
  return { ...m, peak, peakCount: peakDirs.length, totalGood,
           photo: photoDir ? фотоНаправления(photoDir.slug) : null,
           photoName: photoDir ? photoDir.cases.nom : null };
});

// ── Разрезы: те же данные, что в фильтре на главной ──────────────────────
const визовыеГруппы = [
  { key: 'free',     name: 'Без визы',                  href: '/bezviz/',          test: d => d.visa === 'free' },
  { key: 'evisa',    name: 'Виза онлайн или по прилёту', href: '/countries/?v=evisa', test: d => d.visa === 'evisa' },
  { key: 'required', name: 'Виза заранее',              href: '/countries/?v=required', test: d => d.visa === 'required' },
].map(г => {
  const список = DIRECTIONS.filter(г.test);
  const сФото = список.find(d => фотоНаправления(d.slug));
  return { ...г, count: список.length, examples: список.slice(0, 4).map(d => d.cases.nom),
           photo: сФото ? фотоНаправления(сФото.slug) : null };
});

const бюджетныеГруппы = [
  { key: 'low',  name: 'До 100 тысяч',       href: '/countries/?b=low' },
  { key: 'mid',  name: '100–200 тысяч',      href: '/countries/?b=mid' },
  { key: 'high', name: 'Дороже 200 тысяч',   href: '/countries/?b=high' },
].map(г => {
  const список = DIRECTIONS.filter(d => d.budget === г.key);
  const сФото = список.find(d => фотоНаправления(d.slug));
  return { ...г, count: список.length, examples: список.slice(0, 4).map(d => d.cases.nom),
           photo: сФото ? фотоНаправления(сФото.slug) : null };
});

const группыСвета = [...new Set(DIRECTIONS.map(d => d.group))]
  .map(g => ({ name: g, count: DIRECTIONS.filter(d => d.group === g).length }))
  .sort((a, b) => b.count - a.count);

const curIdx = new Date().getMonth();   // месяц сборки = «сейчас»
const cur = monthSummary[curIdx];

const faqs = [
  {
    q: 'Как выбрать месяц для поездки в 2026?',
    a: 'Открой нужный месяц — для каждого собраны направления с пиком сезона, хорошей погодой, ценой перелёта из Москвы и визовым режимом для россиян. Сначала смотри блок «Пик сезона»: там погода и инфраструктура работают на 100%.',
  },
  {
    q: 'В каком месяце дешевле всего путешествовать?',
    a: 'Цена зависит не от месяца вообще, а от связки направление + сезон: низкий сезон в конкретной стране даёт перелёт и отели на 20–30% дешевле пика. На странице каждого месяца дешёвые перелёты подсвечены.',
  },
  {
    q: 'Где смотреть визу и бюджет по месяцу?',
    a: 'На странице месяца у каждого направления указан визовый режим для россиян и ориентир бюджета на день. Точную сумму под свои даты считает калькулятор бюджета.',
  },
];

const url = 'https://traveltribe.ru/trips/';
const title = 'Куда поехать по месяцам 2026 — календарь';
const description = 'Календарь поездок 2026: где сезон в каждом месяце года для россиян. 70+ направлений, актуальные цены, виза и бюджет — выбери свой месяц.';

const ldJson = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": `${url}#webpage`,
      "url": url,
      "name": title,
      "description": description,
      "inLanguage": "ru-RU",
      "isPartOf": { "@id": "https://traveltribe.ru/#website" }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Главная", "item": "https://traveltribe.ru/" },
        { "@type": "ListItem", "position": 2, "name": "Календарь поездок", "item": url }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": faqs.map(f => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": { "@type": "Answer", "text": f.a }
      }))
    },
    {
      "@type": "ItemList",
      "name": "Месяцы для путешествий 2026",
      "numberOfItems": 12,
      "itemListElement": MONTHS.map((m, i) => ({
        "@type": "ListItem",
        "position": i + 1,
        "name": `Куда поехать в ${m.prep}`,
        "url": `https://traveltribe.ru/trips/${m.slug}/`
      }))
    }
  ]
};
---
<Layout
  title={title}
  description={description}
  canonical={url}
  ogTitle="Календарь поездок 2026 — куда лететь по месяцам"
  ogDescription={description}
  ldJson={ldJson}
>
  <Breadcrumbs crumbs={[{ label: 'Календарь поездок' }]} />

  <main id="main" class="sw">
    <div class="wrap">
      <header class="hero grid">
        <div class="meta">Сезоны и визы<br><b>актуальны на {DATA_UPDATED_RU}</b></div>
        <h1 class="h1">Куда поехать <span class="rd">по месяцам</span></h1>
        <p class="sub">Отпуск в марте? Планируешь декабрь? Выбери месяц — покажу, где сейчас пик сезона, цены на перелёт из Москвы и какая нужна виза. 70+ направлений, реальные данные.</p>
        <p class="byl">
          <a href="/about/" class="byl-a">Никита Зайцев</a> ·
          <a href="https://t.me/traveltriberu" target="_blank" rel="noopener">@traveltriberu</a> ·
          <span>был лично на 7 континентах</span>
        </p>
      </header>

      <section class="sec" aria-labelledby="h-now">
        <div class="shead">
          <h2 id="h-now">Сейчас — {cur.nom} 2026</h2>
          <a href={`/trips/${cur.slug}/`}>Все направления {cur.prep}</a>
        </div>
        <p class="lead"><b>{cur.totalGood}</b> {plural(cur.totalGood)} в сезоне {cur.prep}.{cur.peak.length ? ` На пике: ${cur.peak.slice(0, 6).join(', ')}.` : ''}</p>
      </section>

      <section class="sec" aria-labelledby="h-months">
        <div class="shead">
          <h2 id="h-months">Куда поехать в каждом месяце</h2>
          <span class="cap">Сезон · виза · цены внутри</span>
        </div>
        {/* ⛔ Ссылка стоит на названии месяца, а не оборачивает карточку:
            обёрнутая карточка зачитывается вслух одной строкой со всем
            содержимым. Нажимается при этом вся — за счёт растянутого слоя. */}
        <ol class="mgrid">
          {monthSummary.map((m) => (
            <li class={m.slug === cur.slug ? 'mc mc-now' : 'mc'}>
              {m.photo && (
                <div class="mc-ph">
                  <Image src={m.photo} alt={`${m.photoName} — пик сезона в ${m.prep}`}
                         widths={[300, 600]} sizes="(max-width:560px) 50vw, (max-width:1000px) 33vw, 23vw"
                         formats={['webp']} quality={72} loading="lazy" decoding="async" />
                  <span class="mc-tag">{m.photoName}</span>
                </div>
              )}
              <div class="mc-body">
                <div class="mc-ttl">
                  <h3 class="mc-name"><a href={`/trips/${m.slug}/`}>{m.nom}{m.slug === cur.slug && ' · сейчас'}</a></h3>
                  <span class="mc-num">{m.totalGood} напр.</span>
                </div>
                <ol class="mc-peak">
                  {m.peak.slice(0, 3).map((n, i) => (<li><b>{i + 1}</b>{n}</li>))}
                </ol>
                <span class="mc-go" aria-hidden="true">Открыть {m.nom.toLowerCase()}</span>
              </div>
            </li>
          ))}
        </ol>
      </section>

      <section class="sec" aria-labelledby="h-visa">
        <div class="shead"><h2 id="h-visa">Нужна ли виза</h2></div>
        <p class="lead">Что спросят на границе. Посчитано по нашей таблице виз на {DATA_UPDATED_RU}.</p>
        <ul class="wgrid">
          {визовыеГруппы.map(г => (
            <li class="wc">
              {г.photo && <div class="wc-ph"><Image src={г.photo} alt="" widths={[220]} sizes="112px"
                            formats={['webp']} quality={70} loading="lazy" decoding="async" /></div>}
              <div class="wc-body">
                <h3 class="wc-name"><a href={г.href}>{г.name}</a></h3>
                <span class="wc-num">{г.count} {plural(г.count)}</span>
                <p class="wc-ex">{г.examples.join(', ')}…</p>
              </div>
            </li>
          ))}
        </ul>
      </section>

      <section class="sec" aria-labelledby="h-money">
        <div class="shead"><h2 id="h-money">Сколько стоит поездка</h2></div>
        <p class="lead">Вся поездка на двоих на неделю с перелётом — те же пороги, что в фильтре на главной.</p>
        <ul class="wgrid">
          {бюджетныеГруппы.map(г => (
            <li class="wc">
              {г.photo && <div class="wc-ph"><Image src={г.photo} alt="" widths={[220]} sizes="112px"
                            formats={['webp']} quality={70} loading="lazy" decoding="async" /></div>}
              <div class="wc-body">
                <h3 class="wc-name"><a href={г.href}>{г.name}</a></h3>
                <span class="wc-num">{г.count} {plural(г.count)}</span>
                <p class="wc-ex">{г.examples.join(', ')}…</p>
              </div>
            </li>
          ))}
        </ul>
      </section>

      <section class="sec" aria-labelledby="h-groups">
        <div class="shead"><h2 id="h-groups">По частям света</h2></div>
        <p class="lead">Все {DIRECTIONS.length} {plural(DIRECTIONS.length)}, разложенные по {группыСвета.length} группам.</p>
        <nav aria-labelledby="h-groups"><ul class="gcols">
          {группыСвета.map(г => (
            <li><a href="/countries/">{г.name}<span>{г.count}</span></a></li>
          ))}
        </ul></nav>
      </section>

      <section class="sec" aria-labelledby="h-faq">
        <div class="shead"><h2 id="h-faq">Частые вопросы</h2></div>
        <div class="faq">
          {faqs.map(f => (
            <details class="fi">
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </section>

      <section class="sec" aria-labelledby="h-more">
        <div class="shead"><h2 id="h-more">Что ещё посмотреть</h2></div>
        <ul class="vl">
          <li><a href="/seasons/">Полная таблица сезонов</a><span>70+ направлений × 12 месяцев в одной интерактивной таблице</span></li>
          <li><a href="/calculator/">Калькулятор бюджета</a><span>посчитать поездку с актуальным курсом ЦБ РФ</span></li>
          <li><a href="/packing/">Чек-листы поездок</a><span>что взять в каждую страну по сезону</span></li>
          <li><a href="/blog/schengen-visa-2026/">Шенгенская виза 2026</a><span>куда дают и где меньше отказов</span></li>
          <li><a href="/blog/hainan-guide-2026/">Хайнань без визы</a><span>гайд по Китаю с безвизом до 31.12.2027</span></li>
          <li><a href="/blog/japan-guide-2026/">Япония 2026</a><span>полный гайд по поездке</span></li>
        </ul>
      </section>
    </div>
  </main>

  <Footer />
</Layout>

<style is:global>
  /* Swiss-страница: тёплый фон только на этом маршруте */
  body { background: #f4f2eb; }
</style>

<style>
.sw{--paper:#f4f2eb;--ink:#1b1914;--mid:#6b685e;--line:#23211a;--hair:#cdc9bd;--gold:#8e6618;
  --ff:'Golos Text Variable','Golos Text',Helvetica,Arial,sans-serif;--edge:clamp(1.1rem,3vw,2.6rem);
  background:var(--paper);color:var(--ink);font-family:var(--ff);font-weight:400;line-height:1.4;
  font-variant-numeric:tabular-nums lining-nums;-webkit-font-smoothing:antialiased;padding-bottom:clamp(3rem,6vw,5rem)}
:where(.sw) :where(h1,h2,h3,h4,p,ul,li){margin:0}
.sw :where(h1,h2,h3,h4){font-family:var(--ff);color:var(--ink)}
.sw a{color:inherit;text-decoration:none}
.sw :focus-visible{outline:2px solid var(--gold);outline-offset:3px}
.wrap{max-width:1280px;margin-inline:auto;padding-inline:var(--edge)}
.grid{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:0 clamp(.8rem,2vw,1.6rem)}

/* Hero — асимметрия, flush-left */
.hero{padding:clamp(2rem,5vw,4rem) 0 clamp(1.2rem,2.5vw,2rem)}
.meta{grid-column:8/13;grid-row:1;text-align:right;align-self:start;font-size:.8rem;color:var(--mid);line-height:1.5}
.meta b{color:var(--ink);font-weight:500}
.h1{grid-column:1/13;grid-row:2;font-weight:700;font-size:clamp(2.4rem,7vw,6.4rem);line-height:1.02;letter-spacing:-.035em;overflow-wrap:break-word;margin-top:clamp(1.2rem,2.5vw,2rem);padding-bottom:.06em}
.h1 .rd{color:var(--gold)}
.sub{grid-column:1/9;grid-row:3;font-size:clamp(1rem,1.3vw,1.18rem);color:var(--ink);margin-top:clamp(1.4rem,2vw,1.8rem);max-width:52ch;line-height:1.55}
.byl{grid-column:1/13;grid-row:4;margin-top:1.4rem;font-size:.78rem;color:var(--mid)}
.byl a{color:var(--mid);display:inline-flex;align-items:center;min-height:2.75rem}
/* ⛔ Ссылки были высотой 19 точек — пальцем не попасть. Норма 44. */
.mc-name a{display:inline-flex;align-items:center;min-height:2.75rem}
.byl .byl-a{color:var(--gold);text-decoration:underline 1px var(--gold);text-underline-offset:.22em}

/* Секции */
.sec{padding:clamp(2.2rem,4.5vw,3.4rem) 0 0}
.shead{display:flex;align-items:center;justify-content:space-between;gap:1rem;border-top:2px solid var(--line);padding-top:.8rem;margin-bottom:1.2rem}
.shead h2{font-weight:700;font-size:clamp(1.4rem,2.6vw,2rem);letter-spacing:-.02em;display:flex;align-items:baseline;gap:.6rem}
.shead a{font-size:.84rem;font-weight:600;color:var(--gold);text-decoration:underline 1px color-mix(in srgb,var(--gold) 55%,transparent);text-underline-offset:.22em;text-decoration-skip-ink:auto;display:inline-flex;align-items:center;min-height:44px}
.shead .cap{font-size:.78rem;font-weight:500;color:var(--mid)}
.lead{font-size:1.05rem;color:var(--ink);max-width:70ch;line-height:1.5}.lead b{color:var(--gold);font-weight:700}

/* Таблица месяцев */
/* ── Сетка месяцев: карточка с кадром, тройкой пиков и ссылкой ─────────── */
.mgrid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:clamp(.7rem,1.4vw,1.15rem);list-style:none;padding:0;counter-reset:none}
.mc{position:relative;display:flex;flex-direction:column;border:1px solid var(--hair);background:var(--paper)}
.mc:hover{border-color:var(--line)}
.mc:focus-within{outline:2px solid var(--gold);outline-offset:2px}
/* ⛔ Растянутый слой делает нажимаемой всю карточку, но ссылкой остаётся
   только заголовок — иначе программа чтения зачитает карточку целиком. */
.mc-name a::before{content:'';position:absolute;inset:0;z-index:1}
.mc-name a:focus-visible{outline:none}
.mc-ph{position:relative;aspect-ratio:445/280;overflow:hidden;background:var(--hair)}
.mc-ph img{display:block;width:100%;height:100%;object-fit:cover}
.mc-tag{position:absolute;left:0;bottom:0;background:var(--paper);color:var(--ink);font-size:.62rem;
  font-weight:700;letter-spacing:.05em;text-transform:uppercase;padding:.3rem .55rem}
.mc-body{padding:.8rem .9rem .9rem;display:flex;flex-direction:column;gap:.55rem;flex:1}
.mc-ttl{display:flex;justify-content:space-between;align-items:baseline;gap:.6rem}
.mc-name{font-size:1.08rem;font-weight:700;letter-spacing:-.01em}
.mc-name a{color:var(--ink)}
.mc-name a:hover{color:var(--gold);text-decoration:underline 1px var(--gold);text-underline-offset:.22em}
.mc-num{font-size:.74rem;font-weight:700;color:var(--mid);white-space:nowrap}
.mc-peak{list-style:none;padding:0;display:flex;flex-direction:column;gap:.3rem;flex:1}
.mc-peak li{display:flex;gap:.5rem;font-size:.86rem;line-height:1.3;color:var(--ink)}
.mc-peak li b{color:var(--gold);font-weight:700;font-size:.74rem;min-width:1.1em;padding-top:.14em}
.mc-go{font-size:.8rem;font-weight:600;color:var(--gold);margin-top:auto}
.mc-go::after{content:' →'}
/* текущий месяц — вчетверо крупнее: он и есть ответ на «куда сейчас» */
.mc-now{grid-column:span 2;grid-row:span 2}
.mc-now .mc-ph{aspect-ratio:auto;flex:1 1 auto;min-height:20rem}
.mc-now .mc-body{flex:0 0 auto;padding:1rem 1.1rem 1.1rem;gap:.7rem}
.mc-now .mc-name{font-size:1.55rem}
.mc-now .mc-name a{color:var(--gold)}
.mc-now .mc-peak li{font-size:.97rem}

/* ── Разрезы: виза и деньги ───────────────────────────────────────────── */
.wgrid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:clamp(.7rem,1.4vw,1.15rem);list-style:none;padding:0;margin-top:1.1rem}
.wc{position:relative;display:grid;grid-template-columns:7rem minmax(0,1fr);border:1px solid var(--hair);min-height:7rem}
.wc:hover{border-color:var(--line)}
.wc:focus-within{outline:2px solid var(--gold);outline-offset:2px}
.wc-ph{overflow:hidden;background:var(--hair)}
.wc-ph img{display:block;width:100%;height:100%;object-fit:cover}
.wc-body{padding:.75rem .9rem;display:flex;flex-direction:column;gap:.28rem;min-width:0}
.wc-name{font-size:.98rem;font-weight:700}
.wc-name a{color:var(--ink)}
.wc-name a::before{content:'';position:absolute;inset:0;z-index:1}
.wc-name a:hover{color:var(--gold)}
.wc-num{font-size:.72rem;font-weight:700;color:var(--mid)}
.wc-ex{font-size:.82rem;color:var(--mid);line-height:1.4}

/* ── Части света ──────────────────────────────────────────────────────── */
.gcols{columns:4;column-gap:clamp(1.2rem,2.4vw,2rem);list-style:none;padding:0;margin-top:1.1rem}
.gcols li{break-inside:avoid}
.gcols a{display:flex;justify-content:space-between;align-items:center;gap:.8rem;min-height:2.75rem;
  padding:.5rem 0;border-bottom:1px solid var(--hair);font-size:.92rem;color:var(--ink)}
.gcols a:hover{color:var(--gold)}
.gcols a span{font-size:.76rem;font-weight:700;color:var(--mid)}

/* FAQ — hairline, не подушки */
.faq{border-top:1px solid var(--line)}
.fi{border-bottom:1px solid var(--hair)}
.fi summary{font-weight:600;font-size:1rem;color:var(--ink);padding:1rem 2rem 1rem 0;cursor:pointer;list-style:none;position:relative;line-height:1.4}
.fi summary::-webkit-details-marker{display:none}
.fi summary::after{content:'+';position:absolute;right:.2rem;top:.9rem;color:var(--gold);font-size:1.3rem;line-height:1}
.fi[open] summary::after{content:'−'}
.fi p{padding:0 0 1.1rem;color:var(--mid);line-height:1.7;font-size:.95rem;max-width:74ch}

/* Value-list «что ещё» */
.vl{list-style:none;border-top:1px solid var(--line)}
.vl li{display:flex;flex-wrap:wrap;align-items:center;gap:.2rem .7rem;padding:.15rem 0;border-bottom:1px solid var(--hair)}
.vl li:last-child{border-bottom:none}
.vl a{font-weight:600;font-size:1.02rem;color:var(--ink);text-decoration:underline 1px var(--gold);
  text-underline-offset:.22em;display:inline-flex;align-items:center;min-height:2.75rem}
.vl a:hover{color:var(--gold)}
.vl span{color:var(--mid);font-size:.86rem}

@media(max-width:1100px){
  .mgrid{grid-template-columns:repeat(3,minmax(0,1fr))}
  /* ⛔ Счётчик «58 напр.» рядом с названием перестаёт помещаться уже здесь,
     а не только на телефоне — проверено на 1024. */
  .mc-ttl{flex-direction:column;align-items:flex-start;gap:.05rem}
  .mc-num{font-size:.72rem}
  .wgrid{grid-template-columns:repeat(2,minmax(0,1fr))}
  .gcols{columns:2}
}
@media(max-width:760px){
  .h1,.sub,.meta,.byl{grid-column:1/-1;grid-row:auto}
  .meta{text-align:left;margin-top:.6rem}
  .h1{margin-top:1.1rem}
  .mgrid{grid-template-columns:repeat(2,minmax(0,1fr))}
  .mc-now{grid-column:span 2;grid-row:auto}
  .mc-now .mc-ph{aspect-ratio:445/280;min-height:0}
  .mc-now .mc-name{font-size:1.2rem}
  .wgrid{grid-template-columns:1fr}
  .gcols{columns:2}
}
@media(max-width:520px){
  .mgrid{gap:.6rem}
  .mc-name{font-size:.95rem}
  .mc-peak li{font-size:.8rem}
  .mc-body{padding:.65rem .7rem .7rem}
  .mc-now .mc-name{font-size:1.02rem}
  .gcols{columns:1}
}
</style>
